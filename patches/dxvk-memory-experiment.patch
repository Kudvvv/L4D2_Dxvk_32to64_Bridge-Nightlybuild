+        totals.cacheableBytes += allocation->m_size;
+      }
+      if (allocation->m_bridgeTexturePool < totals.textureBytes.size()) {
+        totals.textureBytes[allocation->m_bridgeTexturePool] += allocation->m_size;
+      } else {
+        totals.otherBytes += allocation->m_size;
+      }
+      if (allocation->m_size <= 65536u) {
+        totals.smallBytes += allocation->m_size;
+      }
+      if (allocation->m_size > totals.largestBytes) {
+        totals.largestBytes = allocation->m_size;
+        totals.largestCookie = allocation->m_resourceCookie;
+      }
