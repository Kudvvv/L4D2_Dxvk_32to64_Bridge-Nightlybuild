+          << " zero_ref_bytes=" << totals.zeroRefBytes
+          << " cacheable_bytes=" << totals.cacheableBytes
+          << " texture_default_bytes=" << totals.textureBytes[0]
+          << " texture_managed_bytes=" << totals.textureBytes[1]
+          << " texture_system_bytes=" << totals.textureBytes[2]
+          << " texture_scratch_bytes=" << totals.textureBytes[3]
+          << " other_bytes=" << totals.otherBytes
+          << " small_bytes=" << totals.smallBytes
+          << " largest_bytes=" << totals.largestBytes
+          << " largest_resource_cookie=" << totals.largestCookie;
