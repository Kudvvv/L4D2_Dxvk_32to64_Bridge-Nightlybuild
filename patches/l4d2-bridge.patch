+      record.lastSeen = (std::max)(record.lastSeen, previous->second.lastSeen);
+      record.misses = (std::max)(record.misses, previous->second.misses);
+      if (previous->second.reason == "recovery-failure") { record.reason = "recovery-failure"; }
+    }
+    m_content[record.content] = record.strong;
+    const auto strong = record.strong;
+    m_strong[strong] = std::move(record);
+  }
+  bool readLocked() {
