+    if (!m_valid) { return Match::None; }
+    if (m_strong.count(strong)) { return Match::Strong; }
+    return m_content.count(content) ? Match::Content : Match::None;
+  }
+  bool keep(const std::string& strong, const std::string& content, const char* reason, bool miss, bool& added) {
+    added = false;
+    if (!m_valid || !keyValid(strong) || !keyValid(content)) { return false; }
+    if (!lock()) { m_valid = false; return false; }
+    bool ok = readLocked();
+    DbRecord record;
+    const auto existing = m_strong.find(strong);
+    if (existing != m_strong.end()) { record = existing->second; }
+    else {
+      const auto fallback = m_content.find(content);
+      if (fallback != m_content.end()) { record = m_strong.at(fallback->second); }
+      else { record.firstMiss = timestamp(); }
+    }
+    record.strong = strong; record.content = content;
+    if (record.reason.empty() || std::string(reason) == "recovery-failure") { record.reason = reason; }
+    record.lastSeen = timestamp(); record.misses += miss ? 1u : 0u;
+    std::ostringstream line;
+    line << record.strong << '\t' << record.content << "\tKEEP\t" << record.reason << '\t'
+      << record.firstMiss << '\t' << record.lastSeen << '\t' << record.misses;
