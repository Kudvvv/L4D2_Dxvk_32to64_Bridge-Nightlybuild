+      m_mips[mip].id, m_id, mip, static_cast<unsigned long long>(bytes)); }
+    if (m_context.log) { m_context.write("PB_POLICY event=drop parent_id=%u resource_id=%u backing_bytes=%llu policy=DROP", m_id, m_mips[mip].id, static_cast<unsigned long long>(bytes)); }
+  }
+  void reclaimFailure(const char* reason) {
+    std::lock_guard<std::recursive_mutex> guard(m_context.mutex);
+    keep(reason); m_context.disable(reason);
+  }
+  bool beforeLock(uint32_t mip, uint32_t flags, const RECT& region) {
+    std::lock_guard<std::recursive_mutex> guard(m_context.mutex);
+    if (mip >= m_mips.size() || !m_mips[mip].backing || !m_mips[mip].backing->recoveryMissing()) { return true; }
+    const auto& sub = m_mips[mip];
+    const bool full = region.left == 0 && region.top == 0 && region.right == static_cast<LONG>(sub.desc.Width) && region.bottom == static_cast<LONG>(sub.desc.Height);
+    if (!requiresPreserve(flags, full)) {
+      if (m_context.log) { m_context.write("PB_POLICY event=overwrite resource_id=%u parent_id=%u mip=%u readback=0 promotion=0", sub.id, m_id, mip); }
+      return true;
+    }
+    if (m_context.log) { ++m_context.misses; }
+    if (m_context.log) { m_context.write("PB_POLICY event=retention-miss resource_id=%u parent_id=%u mip=%u strong_key=%s content_key=%s lock_flags=0x%x requested_region=%ld,%ld,%ld,%ld cpu_backing_present=0",
+      sub.id, m_id, mip, m_strong.c_str(), m_content.c_str(), flags, region.left, region.top, region.right, region.bottom); }
+    for (uint32_t level = 0; level < m_mips.size(); ++level) {
+      if (m_mips[level].backing && m_mips[level].backing->recoveryMissing() && !recover(level)) { return false; }
+    }
+    if (!m_keep) {
+      keep("promotion"); if (m_context.log) { ++m_context.promotions; } persist("post-upload-preserve-miss", true);
+      if (m_context.log) { m_context.write("PB_POLICY event=promoted parent_id=%u strong_key=%s content_key=%s reason=post-upload-preserve-miss policy=KEEP all_mips_restored=1",
+        m_id, m_strong.c_str(), m_content.c_str()); }
+    }
+    return true;
+  }
+  l4d2_residency::LearnedDecision decision(uint32_t mip) const {
+    std::lock_guard<std::recursive_mutex> guard(m_context.mutex);
+    using l4d2_residency::LearnedDecision;
+    if (m_keep || m_context.fallback) { return LearnedDecision::Keep; }
+    return m_eligible && m_identified && mip < m_mips.size() && m_mips[mip].uploaded
+      ? LearnedDecision::Evictable : LearnedDecision::Unclassified;
+  }
+  bool allowsEviction(uint32_t mip) const { return decision(mip) == l4d2_residency::LearnedDecision::Evictable; }
+  uint64_t retainedBytes() const {
+    if (!m_keep) { return 0; }
+    uint64_t bytes = 0;
+    for (const auto& sub : m_mips) { if (sub.backing) { bytes += sub.backing->backingBytes(); } }
+    return bytes;
+  }
+};
+
+inline void summary(Context& c) {
+  if (!c.log) { return; }
+  std::lock_guard<std::recursive_mutex> guard(c.mutex);
+  uint64_t retained = 0; for (const auto* parent : c.parents) { retained += parent->retainedBytes(); }
+  c.write("PB_POLICY_SUMMARY eligible_resources=%llu unknown_resources=%llu db_strong_hits=%llu db_content_hits=%llu db_misses=%llu drop_resources=%llu drop_bytes=%llu keep_resources=%llu retained_bytes=%llu retention_misses=%llu recovery_attempts=%llu recovery_success=%llu recovery_failures=%llu real_miss_hash_matches=%llu real_miss_hash_mismatches=%llu promotions=%llu db_records_added=%llu session_fallback_triggered=%u current_backing_bytes=%llu peak_backing_bytes=%llu total_evicted_bytes=%llu db_records=%llu memory_monitoring=%u",
+    static_cast<unsigned long long>(c.eligible), static_cast<unsigned long long>(c.unknown), static_cast<unsigned long long>(c.strongHits),
+    static_cast<unsigned long long>(c.contentHits), static_cast<unsigned long long>(c.dbMisses), static_cast<unsigned long long>(c.drops),
+    static_cast<unsigned long long>(c.dropBytes), static_cast<unsigned long long>(c.keeps), static_cast<unsigned long long>(retained),
+    static_cast<unsigned long long>(c.misses), static_cast<unsigned long long>(c.attempts), static_cast<unsigned long long>(c.recovered),
+    static_cast<unsigned long long>(c.failures), static_cast<unsigned long long>(c.hashMatches), static_cast<unsigned long long>(c.hashMismatches),
+    static_cast<unsigned long long>(c.promotions), static_cast<unsigned long long>(c.added), c.fallback ? 1u : 0u,
+    static_cast<unsigned long long>(l4d2_memory::surfaceBackingBytes.load()), static_cast<unsigned long long>(PagefileShadow::peakBackingBytes()),
+    static_cast<unsigned long long>(c.evicted), static_cast<unsigned long long>(c.db.records()), l4d2_observation::memoryMonitoring ? 1u : 0u);
+}
+}
