+    ++aliveResources; aliveBytes += size;
+    if (aliveBytes > peakAliveBytes) { peakAliveBytes = aliveBytes; }
+    advanceWindow(now);
+    auto& bucket = m_window[static_cast<size_t>(now % m_window.size())];
+    if (bucket.time != now) { bucket = { now, 0, 0 }; }
+    bucket.bytes += size; ++bucket.count;
+    windowBytes += size; ++windowCount;
+    recordEvent(r, now, 0, true);
+    const bool burst = windowBytes >= 100 * kMiB && !m_burstActive;
+    if (burst) { m_burstActive = true; ++burstCount; }
+    return burst;
+  }
+
+  void lock(Record& r, uint64_t now, uint32_t flags, bool full) {
+    if (!r.registered) { return; }
+    const bool safeDiscard = oldContentsUnnecessary(r.meta, flags, full);
+    if (!r.locks) { r.firstLock = now; } else {
+      const auto interval = now - r.lastLock;
+      r.sumLockInterval += interval;
+      if (interval > r.maxLockInterval) { r.maxLockInterval = interval; }
+    }
+    if (r.locks == 1 && r.unlocks) { r.secondDelayValid = true; r.secondLockDelay = now - r.firstUnlock; }
+    if (r.unlocks && !r.relockedAfterUnlock) {
+      r.relockedAfterUnlock = true;
+      r.firstRelockDelay = now - r.firstUnlock;
+    }
+    if (r.hasUpload) { ++r.afterUploadLocks; if (!safeDiscard) { ++r.afterUploadPreserve; } }
+    ++r.locks;
+    r.lastLock = now;
+    ++r.activeLocks;
+    if (flags & kReadonly) { ++r.readonlyLocks; }
+    if (flags & kDiscard) { ++r.discardLocks; }
+    if (flags & kNoOverwrite) { ++r.nooverwriteLocks; }
+    if (!(flags & (kReadonly | kDiscard | kNoOverwrite))) { ++r.normalLocks; }
+    if (full) { ++r.fullLocks; } else { ++r.partialLocks; }
+    recordEvent(r, now, flags, false);
+    for (size_t i = 0; i < simulations.size(); ++i) {
+      auto& sim = simulations[i];
+      auto& link = r.sim[i];
+      unlinkSim(r, i);
+      if (link.resident) { ++sim.hits; sim.hitBytes += r.size; } else {
+        ++sim.misses; sim.missBytes += r.size;
+        if (r.locks == 1) { ++sim.coldMisses; sim.coldMissBytes += r.size; }
+        if (safeDiscard) { ++sim.discardMisses; sim.discardMissBytes += r.size; }
+        else { ++sim.preserveMisses; sim.preserveMissBytes += r.size; }
+        if (r.hasUpload) {
+          ++sim.postUploadMisses;
+          if (safeDiscard) { ++sim.postUploadDiscardMisses; sim.postUploadDiscardMissBytes += r.size; }
+          else { ++sim.postUploadPreserveMisses; sim.postUploadPreserveMissBytes += r.size; }
+        }
+        link.resident = true;
+        sim.residentBytes += r.size;
+        if (sim.residentBytes > sim.peakBytes) { sim.peakBytes = sim.residentBytes; }
+      }
+      trimSim(i);
+    }
+  }
+
+  void unlock(Record& r, uint64_t now, uint32_t flags) {
+    if (!r.registered || !r.activeLocks) { return; }
+    if (!r.unlocks) { r.firstUnlock = now; }
+    ++r.unlocks;
+    --r.activeLocks;
+    if (!(flags & kReadonly)) { r.writeCompleted = true; }
+    if (!r.hasUpload && !r.activeLocks && r.writeCompleted) { r.hasUpload = true; r.firstUpload = now; }
+    if (!r.activeLocks) {
+      for (size_t i = 0; i < simulations.size(); ++i) {
+        auto& sim = simulations[i];
+        auto& link = r.sim[i];
+        if (!link.resident) { continue; }
+        link.next = sim.head;
+        if (sim.head) { sim.head->sim[i].prev = &r; } else { sim.tail = &r; }
+        sim.head = &r;
+        link.listed = true;
+        trimSim(i);
+      }
+    }
+  }
+
+  void destroy(Record& r, uint64_t now) {
+    if (!r.registered) { return; }
+    r.destructionTime = now;
+    destroyed.add(r);
+    for (size_t i = 0; i < simulations.size(); ++i) {
+      unlinkSim(r, i);
+      if (r.sim[i].resident) { simulations[i].residentBytes -= r.size; r.sim[i].resident = false; }
+    }
+    if (r.prev) { r.prev->next = r.next; } else { head = r.next; }
+    if (r.next) { r.next->prev = r.prev; }
+    r.prev = r.next = nullptr;
+    r.registered = false;
+    --aliveResources; aliveBytes -= r.size;
+  }
+
+  Totals live() const {
+    Totals result;
+    for (auto* r = head; r; r = r->next) { result.add(*r); }
+    return result;
+  }
+};
+}
