+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 yeyunyyds.
+// All newly added implementation code in this fork was generated by OpenAI Codex from prompts and specifications provided by yeyunyyds.
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <d3d9.h>
+
+namespace l4d2_volume {
+struct Layout {
+  uint32_t width = 0, height = 0, depth = 0;
+  uint32_t blockBytes = 0, columns = 0, rows = 0;
+  uint32_t rowBytes = 0, sliceBytes = 0, bytes = 0;
+
+  template<typename Wire>
+  void send(Wire& wire) const {
+    // The existing protocol carries block counts, not D3DLOCKED_BOX byte pitches.
+    wire.send_many(blockBytes, columns, rows, depth);
+  }
+};
+
+inline bool layout(const D3DBOX& box, const D3DVOLUME_DESC& desc,
+                   uint32_t blockSize, uint32_t blockBytes, Layout& result) {
+  result = {};
+  if (!blockSize || !blockBytes || box.Left >= box.Right || box.Top >= box.Bottom
+    || box.Front >= box.Back || box.Right > desc.Width || box.Bottom > desc.Height
+    || box.Back > desc.Depth) {
+    return false;
+  }
+  const uint32_t width = box.Right - box.Left, height = box.Bottom - box.Top;
+  const uint32_t depth = box.Back - box.Front;
+  const uint32_t columns = (width - 1) / blockSize + 1, rows = (height - 1) / blockSize + 1;
+  const uint64_t rowBytes = static_cast<uint64_t>(columns) * blockBytes;
+  if (rowBytes > static_cast<uint32_t>((std::numeric_limits<int32_t>::max)())) { return false; }
+  const uint64_t sliceBytes = rowBytes * rows;
+  if (sliceBytes > static_cast<uint32_t>((std::numeric_limits<int32_t>::max)())) { return false; }
+  const uint64_t bytes = sliceBytes * depth;
+  // Leave space for DWORD alignment and the data-queue header on an x86 Client.
+  if (bytes > (std::numeric_limits<uint32_t>::max)() - 4u) { return false; }
+  result = { width, height, depth, blockBytes, columns, rows,
+    static_cast<uint32_t>(rowBytes), static_cast<uint32_t>(sliceBytes), static_cast<uint32_t>(bytes) };
+  return true;
+}
+
+inline D3DLOCKED_BOX lockedBox(void* data, const Layout& storage) {
+  return { static_cast<INT>(storage.rowBytes), static_cast<INT>(storage.sliceBytes), data };
+}
+
+template<typename Sink>
+bool visitRows(const void* source, int32_t rowPitch, int32_t slicePitch, const Layout& storage, Sink&& sink) {
+  if (!source || rowPitch <= 0 || slicePitch <= 0 || !storage.rowBytes || !storage.rows || !storage.depth
+    || static_cast<uint32_t>(rowPitch) < storage.rowBytes
+    || static_cast<uint64_t>(rowPitch) * storage.rows > static_cast<uint32_t>(slicePitch)) {
+    return false;
+  }
+  const uint64_t end = static_cast<uint64_t>(storage.depth - 1) * static_cast<uint32_t>(slicePitch)
+    + static_cast<uint64_t>(storage.rows - 1) * static_cast<uint32_t>(rowPitch) + storage.rowBytes;
+  if (end > (std::numeric_limits<size_t>::max)()) { return false; }
+  for (uint32_t z = 0; z < storage.depth; ++z) {
+    for (uint32_t y = 0; y < storage.rows; ++y) {
+      const auto* row = static_cast<const uint8_t*>(source)
+        + static_cast<size_t>(z) * static_cast<uint32_t>(slicePitch)
+        + static_cast<size_t>(y) * static_cast<uint32_t>(rowPitch);
+      sink(row, storage.rowBytes);
+    }
+  }
+  return true;
+}
+}
