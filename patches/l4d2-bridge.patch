+      GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+      reinterpret_cast<LPCWSTR>(&openLog), &module)) {
+    return INVALID_HANDLE_VALUE;
+  }
+  wchar_t path[MAX_PATH] {};
+  const auto length = GetModuleFileNameW(module, path, MAX_PATH);
+  if (!length || length >= MAX_PATH) {
+    return INVALID_HANDLE_VALUE;
+  }
+  auto separator = std::wcsrchr(path, L'\\');
+  if (!separator || (separator - path) + 1 + 22 >= MAX_PATH) {
+    return INVALID_HANDLE_VALUE;
+  }
+  constexpr wchar_t filename[] = L"l4d2-memory.log";
+  std::wmemcpy(separator + 1, filename, sizeof(filename) / sizeof(wchar_t));
+  return CreateFileW(path, GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE,
+    nullptr, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+}
+
+// Sampling follows Present and allocations, including map loading without frames.
+// The failure path uses stack storage and Win32 I/O to avoid heap allocation.
+inline void sample(bool force = false, const char* event = "sample",
+    Kind kind = Kind::Surface, size_t requested = 0,
+    unsigned width = 0, unsigned height = 0, unsigned format = 0, DWORD error = 0) {
+  const auto now = GetTickCount64();
+  auto deadline = nextSample.load();
+  if (!force && (now < deadline || !nextSample.compare_exchange_strong(deadline, now + 5000))) {
+    return;
+  }
+  std::lock_guard<std::mutex> guard(logMutex);
+  static HANDLE log = openLog();
+  uint64_t committed = 0, reserved = 0, free = 0, largestFree = 0;
+  bool scanComplete = false;
+  SYSTEM_INFO system {};
+  GetSystemInfo(&system);
+  const uint64_t limit = reinterpret_cast<uintptr_t>(system.lpMaximumApplicationAddress) + uint64_t(1);
+  uint64_t address = 0;
+  while (address < limit) {
+    MEMORY_BASIC_INFORMATION region {};
+    if (!VirtualQuery(reinterpret_cast<void*>(static_cast<uintptr_t>(address)), &region, sizeof(region))) {
+      break;
+    }
+    const uint64_t base = reinterpret_cast<uintptr_t>(region.BaseAddress);
+    const uint64_t size = region.RegionSize;
+    if (!size || base + size <= address) {
+      break;
+    }
+    if (region.State == MEM_FREE) {
+      free += size;
+      if (size > largestFree) { largestFree = size; }
+    } else if (region.State == MEM_COMMIT) {
+      committed += size;
+    } else if (region.State == MEM_RESERVE) {
+      reserved += size;
+    }
+    address = base + size;
+  }
+  scanComplete = address >= limit;
+  PROCESS_MEMORY_COUNTERS_EX counters {};
+  counters.cb = sizeof(counters);
+  using QueryMemory = BOOL(WINAPI*)(HANDLE, PPROCESS_MEMORY_COUNTERS, DWORD);
+  static auto query = reinterpret_cast<QueryMemory>(GetProcAddress(
+    GetModuleHandleW(L"kernel32.dll"), "K32GetProcessMemoryInfo"));
+  const bool countersValid = query && query(GetCurrentProcess(),
+    reinterpret_cast<PPROCESS_MEMORY_COUNTERS>(&counters), sizeof(counters));
+  FILETIME created{}, exited{}, kernel{}, user{};
+  const bool cpuValid = GetProcessTimes(GetCurrentProcess(), &created, &exited, &kernel, &user) != FALSE;
+  const uint64_t kernelTime = (static_cast<uint64_t>(kernel.dwHighDateTime) << 32) | kernel.dwLowDateTime;
+  const uint64_t userTime = (static_cast<uint64_t>(user.dwHighDateTime) << 32) | user.dwLowDateTime;
+  SYSTEMTIME time {};
+  GetLocalTime(&time);
+  char line[2400] {};
+  const auto k = static_cast<unsigned>(kind);
+  const char* names[] = { "surface", "vertex-buffer", "index-buffer" };
+  const int length = std::snprintf(line, sizeof(line),
+    "%02u:%02u:%02u.%03u pid=%lu event=%s kind=%s requested=%llu width=%u height=%u format=0x%x "
+    "surface_bytes=%llu surface_count=%llu vertex_bytes=%llu vertex_count=%llu index_bytes=%llu index_count=%llu "
+    "va_committed=%llu va_reserved=%llu va_free=%llu largest_free=%llu va_limit=%llu scan_complete=%u "
+    "private_bytes=%llu working_set=%llu counters_valid=%u surface_backing_bytes=%llu surface_backing_count=%llu "
+    "surface_view_budget_bytes=%llu win32_error=%lu schema=2 tick_ms=%llu "
+    "cpu_kernel_100ns=%llu cpu_user_100ns=%llu cpu_times_valid=%u",
+    time.wHour, time.wMinute, time.wSecond, time.wMilliseconds, GetCurrentProcessId(), event,
+    names[k], static_cast<unsigned long long>(requested), width, height, format,
+    bytes[0].load(), objects[0].load(), bytes[1].load(), objects[1].load(), bytes[2].load(), objects[2].load(),
+    committed, reserved, free, largestFree, limit, static_cast<unsigned>(scanComplete),
+    static_cast<uint64_t>(counters.PrivateUsage), static_cast<uint64_t>(counters.WorkingSetSize),
+    static_cast<unsigned>(countersValid), surfaceBackingBytes.load(), surfaceBackingCount.load(),
+    surfaceViewBudgetBytes.load(), error, static_cast<unsigned long long>(now),
+    static_cast<unsigned long long>(kernelTime), static_cast<unsigned long long>(userTime),
+    static_cast<unsigned>(cpuValid));
+  if (length > 0 && static_cast<size_t>(length) < sizeof(line)) {
+    const int extra = l4d2_queue::format(line + length, sizeof(line) - length);
+    if (extra <= 0 || static_cast<size_t>(extra) >= sizeof(line) - length) { return; }
+    if (log != INVALID_HANDLE_VALUE) {
+      DWORD written = 0;
+      WriteFile(log, line, static_cast<DWORD>(length + extra), &written, nullptr);
+      if (force) { FlushFileBuffers(log); }
+    } else {
+      OutputDebugStringA(line);
+    }
+  }
+}
+
+inline uint8_t* allocate(size_t size, Kind kind, unsigned width = 0,
+    unsigned height = 0, unsigned format = 0, bool zero = false) {
+  sample(false, "before-allocation", kind, size, width, height, format);
+  uint8_t* result = nullptr;
+  try {
+    result = zero ? new uint8_t[size]() : new uint8_t[size];
+  } catch (const std::bad_alloc&) {
+    sample(true, "allocation-failed", kind, size, width, height, format);
+    throw;
+  }
+  const auto k = static_cast<unsigned>(kind);
+  bytes[k].fetch_add(size);
+  objects[k].fetch_add(1);
+  return result;
+}
+
+inline void released(size_t size, Kind kind) {
+  const auto k = static_cast<unsigned>(kind);
+  bytes[k].fetch_sub(size);
+  objects[k].fetch_sub(1);
+}
+}
