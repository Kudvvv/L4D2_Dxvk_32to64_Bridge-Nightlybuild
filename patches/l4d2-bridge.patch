+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 yeyunyyds.
+// All newly added implementation code in this fork was generated by OpenAI Codex from prompts and specifications provided by yeyunyyds.
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+
+namespace l4d2_shadow {
+constexpr uint64_t kMiB = 1024u * 1024u;
+constexpr uint32_t kUnknown = 0xffffffffu;
+constexpr uint32_t kReadonly = 0x10u;
+constexpr uint32_t kDiscard = 0x2000u;
+constexpr uint32_t kNoOverwrite = 0x1000u;
+constexpr uint32_t kDynamic = 0x200u;
+enum class Type : uint32_t { Surface, Texture2DLevel, CubeFaceLevel, BackBuffer };
+
+struct Metadata {
+  uint64_t resourceId = 0, parentId = 0, creationTime = 0;
+  Type type = Type::Surface;
+  uint32_t width = 0, height = 0, format = 0, pool = 0, usage = 0;
+  uint32_t mip = kUnknown, face = kUnknown;
+};
+
+struct Record;
+struct SimLink {
+  Record* prev = nullptr;
+  Record* next = nullptr;
+  bool resident = false, listed = false;
+};
+
+struct Record {
+  Metadata meta;
+  uint64_t size = 0, backingTime = 0, destructionTime = 0;
+  uint64_t locks = 0, unlocks = 0, firstLock = 0, lastLock = 0, firstUnlock = 0;
+  uint64_t firstUpload = 0, afterUploadLocks = 0, afterUploadPreserve = 0;
+  uint64_t readonlyLocks = 0, discardLocks = 0, nooverwriteLocks = 0, normalLocks = 0;
+  uint64_t fullLocks = 0, partialLocks = 0;
+  uint64_t firstRelockDelay = 0, maxLockInterval = 0, sumLockInterval = 0;
+  uint64_t secondLockDelay = 0;
+  uint32_t activeLocks = 0;
+  bool registered = false, hasUpload = false, writeCompleted = false;
+  bool relockedAfterUnlock = false, secondDelayValid = false;
+  Record* prev = nullptr;
+  Record* next = nullptr;
+  std::array<SimLink, 4> sim {};
+};
+
+// DISCARD is only classified safe for a known full dynamic DEFAULT 2D base level.
+// Normal full locks, cube surfaces and unrecognized flag combinations stay conservative.
+inline bool oldContentsUnnecessary(const Metadata& meta, uint32_t flags, bool full) {
+  constexpr uint32_t allowed = kDiscard | 0x800u | 0x4000u | 0x8000u;
+  return meta.type == Type::Texture2DLevel && meta.mip == 0 && meta.pool == 0
+    && (meta.usage & kDynamic) && full && (flags & kDiscard) && !(flags & ~allowed);
+}
+
+struct Weighted {
+  uint64_t resources = 0, bytes = 0;
+  void add(uint64_t size) { ++resources; bytes += size; }
+};
+
+struct Totals {
+  Weighted all, initialOnly, relocked, discardOnly, potentiallyRequired, readonly;
+  Weighted frequent, dynamic, incomplete, persistent, nonpersistent;
+  std::array<Weighted, 4> delays {};
+  void add(const Record& r) {
+    all.add(r.size);
+    const bool initial = r.hasUpload && !r.afterUploadLocks && !r.readonlyLocks && !r.activeLocks;
+    const bool discard = r.hasUpload && r.afterUploadLocks && !r.afterUploadPreserve && !r.readonlyLocks && !r.activeLocks;
+    if (initial) { initialOnly.add(r.size); }
+    if (discard) { discardOnly.add(r.size); }
+    if (r.relockedAfterUnlock) {
+      relocked.add(r.size);
+      const auto delay = r.firstRelockDelay;
+      delays[delay < 1000 ? 0 : delay < 10000 ? 1 : delay <= 60000 ? 2 : 3].add(r.size);
+    }
+    if (r.afterUploadPreserve) { potentiallyRequired.add(r.size); }
+    if (r.readonlyLocks) { readonly.add(r.size); }
+    if (r.locks >= 8) { frequent.add(r.size); }
+    if (r.meta.usage & kDynamic) { dynamic.add(r.size); }
+    if (!r.hasUpload || r.activeLocks) { incomplete.add(r.size); }
+    if (initial || discard) { nonpersistent.add(r.size); } else { persistent.add(r.size); }
+  }
+};
+
+struct Simulation {
+  uint64_t budget = 0, residentBytes = 0, peakBytes = 0;
+  uint64_t hits = 0, misses = 0, hitBytes = 0, missBytes = 0;
+  uint64_t coldMisses = 0, preserveMisses = 0, discardMisses = 0;
+  uint64_t coldMissBytes = 0, postUploadMisses = 0, postUploadPreserveMisses = 0, postUploadDiscardMisses = 0;
+  uint64_t postUploadPreserveMissBytes = 0, postUploadDiscardMissBytes = 0;
+  uint64_t preserveMissBytes = 0, discardMissBytes = 0;
+  Record* head = nullptr;
+  Record* tail = nullptr;
+};
+
+struct Event {
+  Metadata meta;
+  uint64_t time = 0, size = 0;
+  uint32_t flags = 0;
+  bool creation = false;
+};
+
+// Storage is fixed; no allocations or resource ownership are introduced by the engine.
+class Engine {
+  struct Millisecond { uint64_t time = 0, bytes = 0, count = 0; };
+  std::array<Millisecond, 1024> m_window {};
+  uint64_t m_lastTime = 0;
+  bool m_burstActive = false;
+
+  void unlinkSim(Record& r, size_t index) {
+    auto& link = r.sim[index];
+    auto& sim = simulations[index];
+    if (!link.listed) { return; }
+    if (link.prev) { link.prev->sim[index].next = link.next; } else { sim.head = link.next; }
+    if (link.next) { link.next->sim[index].prev = link.prev; } else { sim.tail = link.prev; }
+    link.prev = link.next = nullptr;
+    link.listed = false;
+  }
+
+  void trimSim(size_t index) {
+    auto& sim = simulations[index];
+    while (sim.residentBytes > sim.budget && sim.tail) {
+      auto& victim = *sim.tail;
+      unlinkSim(victim, index);
+      victim.sim[index].resident = false;
+      sim.residentBytes -= victim.size;
+    }
+  }
+
+  void recordEvent(const Record& r, uint64_t now, uint32_t flags, bool creation) {
+    events[static_cast<size_t>(eventCount % events.size())] = { r.meta, now, r.size, flags, creation };
+    ++eventCount;
+  }
+
+  void advanceWindow(uint64_t now) {
+    if (now - m_lastTime >= 1000) {
+      m_window = {};
+      windowBytes = windowCount = 0;
+    } else {
+      for (uint64_t t = m_lastTime + 1; t <= now; ++t) {
+        if (t >= 1000) {
+          auto& old = m_window[static_cast<size_t>((t - 1000) % m_window.size())];
+          if (old.time == t - 1000) {
+            windowBytes -= old.bytes;
+            windowCount -= old.count;
+            old = {};
+          }
+        }
+      }
+    }
+    m_lastTime = now;
+    if (windowBytes < 100 * kMiB) { m_burstActive = false; }
+  }
+
+public:
+  Record* head = nullptr;
+  Totals destroyed;
+  uint64_t createdResources = 0, createdBytes = 0, aliveBytes = 0, aliveResources = 0, peakAliveBytes = 0;
+  uint64_t windowBytes = 0, windowCount = 0, eventCount = 0, burstCount = 0;
+  std::array<Event, 256> events {};
+  std::array<Simulation, 4> simulations {};
+
+  Engine() {
+    for (size_t i = 0; i < simulations.size(); ++i) { simulations[i].budget = (256 * kMiB) << i; }
+  }
+
+  bool create(Record& r, uint64_t size, uint64_t now) {
+    if (r.registered) { return false; }
+    r.size = size;
+    r.backingTime = now;
+    r.registered = true;
+    r.next = head;
+    if (head) { head->prev = &r; }
+    head = &r;
+    ++createdResources; createdBytes += size;
+    ++aliveResources; aliveBytes += size;
+    if (aliveBytes > peakAliveBytes) { peakAliveBytes = aliveBytes; }
+    advanceWindow(now);
+    auto& bucket = m_window[static_cast<size_t>(now % m_window.size())];
+    if (bucket.time != now) { bucket = { now, 0, 0 }; }
+    bucket.bytes += size; ++bucket.count;
+    windowBytes += size; ++windowCount;
+    recordEvent(r, now, 0, true);
+    const bool burst = windowBytes >= 100 * kMiB && !m_burstActive;
+    if (burst) { m_burstActive = true; ++burstCount; }
+    return burst;
+  }
+
+  void lock(Record& r, uint64_t now, uint32_t flags, bool full) {
+    if (!r.registered) { return; }
+    const bool safeDiscard = oldContentsUnnecessary(r.meta, flags, full);
+    if (!r.locks) { r.firstLock = now; } else {
+      const auto interval = now - r.lastLock;
+      r.sumLockInterval += interval;
+      if (interval > r.maxLockInterval) { r.maxLockInterval = interval; }
+    }
+    if (r.locks == 1 && r.unlocks) { r.secondDelayValid = true; r.secondLockDelay = now - r.firstUnlock; }
+    if (r.unlocks && !r.relockedAfterUnlock) {
+      r.relockedAfterUnlock = true;
+      r.firstRelockDelay = now - r.firstUnlock;
+    }
+    if (r.hasUpload) { ++r.afterUploadLocks; if (!safeDiscard) { ++r.afterUploadPreserve; } }
+    ++r.locks;
+    r.lastLock = now;
+    ++r.activeLocks;
+    if (flags & kReadonly) { ++r.readonlyLocks; }
+    if (flags & kDiscard) { ++r.discardLocks; }
+    if (flags & kNoOverwrite) { ++r.nooverwriteLocks; }
+    if (!(flags & (kReadonly | kDiscard | kNoOverwrite))) { ++r.normalLocks; }
+    if (full) { ++r.fullLocks; } else { ++r.partialLocks; }
+    recordEvent(r, now, flags, false);
+    for (size_t i = 0; i < simulations.size(); ++i) {
+      auto& sim = simulations[i];
+      auto& link = r.sim[i];
+      unlinkSim(r, i);
+      if (link.resident) { ++sim.hits; sim.hitBytes += r.size; } else {
+        ++sim.misses; sim.missBytes += r.size;
+        if (r.locks == 1) { ++sim.coldMisses; sim.coldMissBytes += r.size; }
+        if (safeDiscard) { ++sim.discardMisses; sim.discardMissBytes += r.size; }
+        else { ++sim.preserveMisses; sim.preserveMissBytes += r.size; }
+        if (r.hasUpload) {
+          ++sim.postUploadMisses;
+          if (safeDiscard) { ++sim.postUploadDiscardMisses; sim.postUploadDiscardMissBytes += r.size; }
+          else { ++sim.postUploadPreserveMisses; sim.postUploadPreserveMissBytes += r.size; }
+        }
+        link.resident = true;
+        sim.residentBytes += r.size;
+        if (sim.residentBytes > sim.peakBytes) { sim.peakBytes = sim.residentBytes; }
+      }
+      trimSim(i);
+    }
+  }
+
+  void unlock(Record& r, uint64_t now, uint32_t flags) {
+    if (!r.registered || !r.activeLocks) { return; }
+    if (!r.unlocks) { r.firstUnlock = now; }
+    ++r.unlocks;
+    --r.activeLocks;
+    if (!(flags & kReadonly)) { r.writeCompleted = true; }
+    if (!r.hasUpload && !r.activeLocks && r.writeCompleted) { r.hasUpload = true; r.firstUpload = now; }
+    if (!r.activeLocks) {
+      for (size_t i = 0; i < simulations.size(); ++i) {
+        auto& sim = simulations[i];
+        auto& link = r.sim[i];
+        if (!link.resident) { continue; }
+        link.next = sim.head;
+        if (sim.head) { sim.head->sim[i].prev = &r; } else { sim.tail = &r; }
+        sim.head = &r;
+        link.listed = true;
+        trimSim(i);
+      }
+    }
+  }
+
+  void destroy(Record& r, uint64_t now) {
+    if (!r.registered) { return; }
+    r.destructionTime = now;
+    destroyed.add(r);
+    for (size_t i = 0; i < simulations.size(); ++i) {
+      unlinkSim(r, i);
+      if (r.sim[i].resident) { simulations[i].residentBytes -= r.size; r.sim[i].resident = false; }
+    }
+    if (r.prev) { r.prev->next = r.next; } else { head = r.next; }
+    if (r.next) { r.next->prev = r.prev; }
+    r.prev = r.next = nullptr;
+    r.registered = false;
+    --aliveResources; aliveBytes -= r.size;
+  }
+
+  Totals live() const {
+    Totals result;
+    for (auto* r = head; r; r = r->next) { result.add(*r); }
+    return result;
+  }
+};
+}
