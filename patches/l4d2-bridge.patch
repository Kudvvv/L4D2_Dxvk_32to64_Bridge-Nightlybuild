+#include <psapi.h>
+#include <cstdint>
+#include <cstdio>
+#include <cwchar>
+#include "../util/queue_wait_diagnostics.h"
+#include "host_memory_details.h"
+
+namespace l4d2_host_memory {
+struct Objects {
+  size_t devices = 0;
+  size_t resources = 0;
+  size_t volumes = 0;
+  size_t declarations = 0;
+  size_t stateBlocks = 0;
+  size_t vertexShaders = 0;
+  size_t pixelShaders = 0;
+  size_t swapchains = 0;
+  size_t queries = 0;
+  uint64_t commands = 0;
+  ResourceTotals resourceTotals;
+};
+
+// Called only on the device command thread; never calls resource COM methods.
+class Recorder {
+  HANDLE m_log = INVALID_HANDLE_VALUE;
+  ULONGLONG m_nextSample = 0;
+  ULONGLONG m_previousTick = 0;
+  uint64_t m_previousCpu = 0;
+  uint64_t m_previousCommands = 0;
+  bool m_previousCpuValid = false;
+  GpuRecorder m_gpu;
+
+  static uint64_t fileTimeValue(const FILETIME& time) {
+    return (static_cast<uint64_t>(time.dwHighDateTime) << 32) | time.dwLowDateTime;
+  }
+
+  static HANDLE openLog() {
+    wchar_t path[MAX_PATH] {};
+    const auto length = GetModuleFileNameW(nullptr, path, MAX_PATH);
+    if (!length || length >= MAX_PATH) { return INVALID_HANDLE_VALUE; }
+    auto separator = std::wcsrchr(path, L'\\');
+    constexpr wchar_t filename[] = L"l4d2-host-memory.log";
+    if (!separator || (separator - path) + 1 + sizeof(filename) / sizeof(wchar_t) > MAX_PATH) {
+      return INVALID_HANDLE_VALUE;
+    }
+    std::wmemcpy(separator + 1, filename, sizeof(filename) / sizeof(wchar_t));
+    return CreateFileW(path, GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE,
+      nullptr, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+  }
+
+public:
+  Recorder() : m_log(openLog()) {}
+  Recorder(const Recorder&) = delete;
+  Recorder& operator=(const Recorder&) = delete;
+  ~Recorder() {
+    if (m_log != INVALID_HANDLE_VALUE) { CloseHandle(m_log); }
+  }
+
+  bool isOpen() const { return m_log != INVALID_HANDLE_VALUE; }
+
+  bool due() const { return GetTickCount64() >= m_nextSample; }
+
+  void setGpuAdapter(UINT vendor, UINT device) { m_gpu.setAdapter(vendor, device); }
+
+  bool sample(const Objects& objects, const char* event = "sample", HANDLE client = nullptr) {
+    const auto tick = GetTickCount64();
+    m_nextSample = tick + 5000;
+    if (!isOpen()) { return false; }
+    PROCESS_MEMORY_COUNTERS_EX memory {};
+    memory.cb = sizeof(memory);
+    PERFORMANCE_INFORMATION performance {};
+    performance.cb = sizeof(performance);
+    MEMORYSTATUSEX physical {};
+    physical.dwLength = sizeof(physical);
+    using QueryMemory = BOOL(WINAPI*)(HANDLE, PPROCESS_MEMORY_COUNTERS, DWORD);
+    using QueryPerformance = BOOL(WINAPI*)(PPERFORMANCE_INFORMATION, DWORD);
+    static auto queryMemory = reinterpret_cast<QueryMemory>(GetProcAddress(
+      GetModuleHandleW(L"kernel32.dll"), "K32GetProcessMemoryInfo"));
+    static auto queryPerformance = reinterpret_cast<QueryPerformance>(GetProcAddress(
+      GetModuleHandleW(L"kernel32.dll"), "K32GetPerformanceInfo"));
+    const bool countersValid = queryMemory && queryMemory(GetCurrentProcess(),
+      reinterpret_cast<PPROCESS_MEMORY_COUNTERS>(&memory), sizeof(memory));
+    const bool commitValid = queryPerformance && queryPerformance(&performance, sizeof(performance));
+    const bool physicalValid = GlobalMemoryStatusEx(&physical) != FALSE;
+    DWORD handles = 0;
+    const bool handlesValid = GetProcessHandleCount(GetCurrentProcess(), &handles) != FALSE;
+    DWORD clientExitCode = 0;
+    const bool exitCodeValid = client && GetExitCodeProcess(client, &clientExitCode);
+    const auto addresses = queryAddressMemory();
+    const auto gpu = m_gpu.sample();
+    FILETIME created {}, exited {}, kernel {}, user {};
+    const bool cpuTimesValid = GetProcessTimes(GetCurrentProcess(), &created, &exited, &kernel, &user) != FALSE;
+    const uint64_t kernelTime = fileTimeValue(kernel);
+    const uint64_t userTime = fileTimeValue(user);
+    using CountProcessors = DWORD(WINAPI*)(WORD);
+    static auto countProcessors = reinterpret_cast<CountProcessors>(GetProcAddress(
+      GetModuleHandleW(L"kernel32.dll"), "GetActiveProcessorCount"));
+    SYSTEM_INFO system {};
+    GetSystemInfo(&system);
+    const DWORD processors = countProcessors ? countProcessors(0xffff) : system.dwNumberOfProcessors;
+    const uint64_t elapsedMs = tick - m_previousTick;
+    const uint64_t cpuTime = kernelTime + userTime;
+    const bool cpuValid = cpuTimesValid && m_previousCpuValid && elapsedMs && processors && cpuTime >= m_previousCpu;
+    const double cpuCores = cpuValid ? static_cast<double>(cpuTime - m_previousCpu) /
+      (static_cast<double>(elapsedMs) * 10000.0) : 0.0;
+    const double cpuPercent = cpuValid ? cpuCores * 100.0 / processors : 0.0;
+    const bool commandsValid = m_previousTick && elapsedMs && objects.commands >= m_previousCommands;
+    const double commandsPerSecond = commandsValid ?
+      static_cast<double>(objects.commands - m_previousCommands) * 1000.0 / elapsedMs : 0.0;
+    m_previousTick = tick;
+    m_previousCpu = cpuTime;
+    m_previousCommands = objects.commands;
+    m_previousCpuValid = cpuTimesValid;
+    SYSTEMTIME time {};
+    GetLocalTime(&time);
+    char line[8192] {};
+    const int length = std::snprintf(line, sizeof(line),
+      "%02u:%02u:%02u.%03u schema=3 pid=%lu event=%s "
+      "private_bytes=%llu working_set=%llu peak_working_set=%llu counters_valid=%u "
+      "system_commit_bytes=%llu system_commit_limit=%llu commit_valid=%u "
+      "physical_available=%llu physical_total=%llu physical_valid=%u "
+      "handles=%lu handles_valid=%u client_exit_code=0x%08lx client_exit_code_valid=%u "
+      "tick_ms=%llu cpu_kernel_100ns=%llu cpu_user_100ns=%llu processors=%lu "
+      "cpu_percent=%.3f cpu_cores=%.3f cpu_valid=%u "
+      "commands_total=%llu commands_per_second=%.3f commands_valid=%u "
+      "devices=%llu resource_handles=%llu volume_handles=%llu declarations=%llu "
+      "state_blocks=%llu vertex_shaders=%llu pixel_shaders=%llu swapchains=%llu queries=%llu",
+      time.wHour, time.wMinute, time.wSecond, time.wMilliseconds, GetCurrentProcessId(), event,
+      static_cast<unsigned long long>(memory.PrivateUsage),
+      static_cast<unsigned long long>(memory.WorkingSetSize),
+      static_cast<unsigned long long>(memory.PeakWorkingSetSize), static_cast<unsigned>(countersValid),
+      static_cast<unsigned long long>(performance.CommitTotal) * performance.PageSize,
+      static_cast<unsigned long long>(performance.CommitLimit) * performance.PageSize,
+      static_cast<unsigned>(commitValid),
+      physical.ullAvailPhys, physical.ullTotalPhys, static_cast<unsigned>(physicalValid),
+      handles, static_cast<unsigned>(handlesValid), clientExitCode, static_cast<unsigned>(exitCodeValid),
+      static_cast<unsigned long long>(tick),
+      static_cast<unsigned long long>(kernelTime), static_cast<unsigned long long>(userTime), processors,
+      cpuPercent, cpuCores, static_cast<unsigned>(cpuValid),
+      static_cast<unsigned long long>(objects.commands), commandsPerSecond, static_cast<unsigned>(commandsValid),
+      static_cast<unsigned long long>(objects.devices),
+      static_cast<unsigned long long>(objects.resources),
+      static_cast<unsigned long long>(objects.volumes),
+      static_cast<unsigned long long>(objects.declarations),
+      static_cast<unsigned long long>(objects.stateBlocks),
+      static_cast<unsigned long long>(objects.vertexShaders),
+      static_cast<unsigned long long>(objects.pixelShaders),
+      static_cast<unsigned long long>(objects.swapchains),
+      static_cast<unsigned long long>(objects.queries));
+    if (length <= 0 || static_cast<size_t>(length) >= sizeof(line)) { return false; }
+    const auto& resources = objects.resourceTotals;
+    const int details = std::snprintf(line + length, sizeof(line) - length,
+      " texture_handles=%llu cube_texture_handles=%llu volume_texture_handles=%llu "
+      "vertex_buffer_handles=%llu index_buffer_handles=%llu surface_handles=%llu "
+      "resource_inventory_valid=%u resource_register_total=%llu resource_rebind_total=%llu "
+      "resource_replace_total=%llu resource_destroy_total=%llu resource_unlink_total=%llu resource_missing_erase_total=%llu "
+      "address_private_commit=%llu address_mapped_commit=%llu address_image_commit=%llu "
+      "address_free_bytes=%llu address_largest_free_block=%llu "
+      "address_regions=%llu address_query_ms=%llu address_memory_valid=%u "
+      "gpu_vendor=0x%04x gpu_device=0x%04x gpu_node=0 gpu_adapter_result=0x%08lx "
+      "gpu_local_usage=%llu gpu_local_budget=%llu gpu_local_valid=%u gpu_local_result=0x%08lx "
+      "gpu_nonlocal_usage=%llu gpu_nonlocal_budget=%llu gpu_nonlocal_valid=%u gpu_nonlocal_result=0x%08lx",
+      static_cast<unsigned long long>(resources.live[0]), static_cast<unsigned long long>(resources.live[1]),
+      static_cast<unsigned long long>(resources.live[2]), static_cast<unsigned long long>(resources.live[3]),
+      static_cast<unsigned long long>(resources.live[4]), static_cast<unsigned long long>(resources.live[5]),
+      static_cast<unsigned>(resources.handles == objects.resources),
+      static_cast<unsigned long long>(resources.registrations), static_cast<unsigned long long>(resources.rebinds),
+      static_cast<unsigned long long>(resources.replacements), static_cast<unsigned long long>(resources.destroys),
+      static_cast<unsigned long long>(resources.unlinks), static_cast<unsigned long long>(resources.missingErases),
+      static_cast<unsigned long long>(addresses.privateCommit), static_cast<unsigned long long>(addresses.mappedCommit),
+      static_cast<unsigned long long>(addresses.imageCommit), static_cast<unsigned long long>(addresses.freeBytes),
+      static_cast<unsigned long long>(addresses.largestFreeBlock), static_cast<unsigned long long>(addresses.regions),
+      static_cast<unsigned long long>(addresses.elapsedMs), static_cast<unsigned>(addresses.valid),
+      m_gpu.vendor(), m_gpu.device(), static_cast<unsigned long>(m_gpu.result()),
+      static_cast<unsigned long long>(gpu.localUsage), static_cast<unsigned long long>(gpu.localBudget),
+      static_cast<unsigned>(SUCCEEDED(gpu.localResult)), static_cast<unsigned long>(gpu.localResult),
+      static_cast<unsigned long long>(gpu.nonlocalUsage), static_cast<unsigned long long>(gpu.nonlocalBudget),
+      static_cast<unsigned>(SUCCEEDED(gpu.nonlocalResult)), static_cast<unsigned long>(gpu.nonlocalResult));
+    if (details <= 0 || static_cast<size_t>(details) >= sizeof(line) - length) { return false; }
+    const size_t offset = static_cast<size_t>(length) + details;
+    const int extra = l4d2_queue::format(line + offset, sizeof(line) - offset);
+    if (extra <= 0 || static_cast<size_t>(extra) >= sizeof(line) - offset) { return false; }
+    const DWORD total = static_cast<DWORD>(offset + extra);
+    DWORD written = 0;
+    return WriteFile(m_log, line, total, &written, nullptr) &&
+      written == total && FlushFileBuffers(m_log);
+  }
+};
+}
