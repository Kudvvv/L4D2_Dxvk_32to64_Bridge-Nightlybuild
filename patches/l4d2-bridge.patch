+      std::snprintf(line, sizeof(line), "L4D2_STEAM_INPUT event=modules role=%s pid=%lu bits=%zu renderer32=%d renderer64=%d vulkan32=%d vulkan64=%d api32=%d api64=%d",
+        m_role, GetCurrentProcessId(), sizeof(void*) * 8, !!(modules & 1u), !!(modules & 2u), !!(modules & 4u), !!(modules & 8u), !!(modules & 16u), !!(modules & 32u));
+      m_log(line);
+    }
+    const HWND foreground = GetForegroundWindow();
+    const DWORD foregroundThread = GetWindowThreadProcessId(foreground, nullptr);
+    GUITHREADINFO gui {}; gui.cbSize = sizeof(gui);
+    const bool guiOk = foregroundThread && GetGUIThreadInfo(foregroundThread, &gui);
+    GUITHREADINFO localGui {}; localGui.cbSize = sizeof(localGui);
+    const DWORD localThread = GetWindowThreadProcessId(presenter ? presenter : game, nullptr);
+    const bool localGuiOk = localThread && GetGUIThreadInfo(localThread, &localGui);
+    RECT clip {}; const bool clipOk = GetClipCursor(&clip) != FALSE;
+    POINT cursor {}; const bool cursorOk = GetCursorPos(&cursor) != FALSE;
+    const HWND hit = cursorOk ? WindowFromPoint(cursor) : nullptr;
