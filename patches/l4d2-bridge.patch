+
+namespace l4d2_readback {
+using Digest = std::array<uint8_t, 32>;
+
+class Hasher {
+  BCRYPT_ALG_HANDLE m_algorithm = nullptr;
+  BCRYPT_HASH_HANDLE m_hash = nullptr;
+  HRESULT m_result = E_FAIL;
+public:
+  Hasher() {
+    NTSTATUS status = BCryptOpenAlgorithmProvider(&m_algorithm, BCRYPT_SHA256_ALGORITHM, nullptr, 0);
+    if (status >= 0) { status = BCryptCreateHash(m_algorithm, &m_hash, nullptr, 0, nullptr, 0, 0); }
+    m_result = status >= 0 ? S_OK : HRESULT_FROM_NT(status);
+  }
+  Hasher(const Hasher&) = delete;
+  Hasher& operator=(const Hasher&) = delete;
+  ~Hasher() {
+    if (m_hash) { BCryptDestroyHash(m_hash); }
+    if (m_algorithm) { BCryptCloseAlgorithmProvider(m_algorithm, 0); }
+  }
+  HRESULT add(const void* data, size_t bytes) {
+    if (FAILED(m_result)) { return m_result; }
+    if (!data || bytes > UINT32_MAX) { return m_result = E_INVALIDARG; }
+    const NTSTATUS status = BCryptHashData(m_hash, const_cast<PUCHAR>(static_cast<const uint8_t*>(data)), static_cast<ULONG>(bytes), 0);
+    return m_result = status >= 0 ? S_OK : HRESULT_FROM_NT(status);
+  }
+  HRESULT finish(Digest& digest) {
+    digest = {};
+    if (FAILED(m_result)) { return m_result; }
+    const NTSTATUS status = BCryptFinishHash(m_hash, digest.data(), static_cast<ULONG>(digest.size()), 0);
+    return m_result = status >= 0 ? S_OK : HRESULT_FROM_NT(status);
+  }
+};
+
+// Windows CNG owns the SHA-256 implementation; only this small digest survives deletion.
+inline HRESULT hashBytes(const uint8_t* data, size_t bytes, Digest& digest) {
+  digest = {};
+  if (!data || !bytes || bytes > UINT32_MAX) { return E_INVALIDARG; }
+  BCRYPT_ALG_HANDLE algorithm = nullptr;
+  BCRYPT_HASH_HANDLE hash = nullptr;
+  NTSTATUS status = BCryptOpenAlgorithmProvider(&algorithm, BCRYPT_SHA256_ALGORITHM, nullptr, 0);
+  if (status >= 0) { status = BCryptCreateHash(algorithm, &hash, nullptr, 0, nullptr, 0, 0); }
+  if (status >= 0) {
+    status = BCryptHashData(hash, const_cast<PUCHAR>(data), static_cast<ULONG>(bytes), 0);
+  }
+  if (status >= 0) { status = BCryptFinishHash(hash, digest.data(), static_cast<ULONG>(digest.size()), 0); }
+  if (hash) { BCryptDestroyHash(hash); }
+  if (algorithm) { BCryptCloseAlgorithmProvider(algorithm, 0); }
+  return status >= 0 ? S_OK : HRESULT_FROM_NT(status);
+}
+
+inline std::array<char, 65> digestText(const Digest& digest) {
+  constexpr char alphabet[] = "0123456789abcdef";
+  std::array<char, 65> text {};
+  for (size_t i = 0; i < digest.size(); ++i) {
+    text[i * 2] = alphabet[digest[i] >> 4];
+    text[i * 2 + 1] = alphabet[digest[i] & 15];
+  }
+  return text;
+}
+}
