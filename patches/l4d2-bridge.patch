new file mode 100644
index 0000000..ba680c7
--- /dev/null
+++ b/bridge/src/client/bridge_settings.h
@@ -0,0 +1,110 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 yeyunyyds.
+// All newly added implementation code in this fork was generated by OpenAI Codex from prompts and specifications provided by yeyunyyds.
+#pragma once
+#include <array>
+#include <functional>
+#include <mutex>
+#include <string>
+#include <utility>
+#include <vector>
+#include "bridge_control.h"
+
+namespace l4d2_settings {
+using namespace l4d2_bridge_control;
+using Updates = std::vector<std::pair<std::string, std::string>>;
+constexpr const char* kPresenterKeys[] = {
+  "server.presenterWindow", "server.presenterInput", "server.presenterOverlayKey", "server.presenterHotkeyFallback",
+  "client.forceWindowed", "client.hookMessagePump", "client.overrideCustomWinHooks",
+  "client.DirectInput.forward.mousePolicy", "client.DirectInput.forward.keyboardPolicy"
+};
+struct Target {
+  Host host = Host::X64;
+  l4d2_control::Policy policy = l4d2_control::Policy::Keep;
+  std::array<uint32_t, 9> presenter { 0, 1, 36, 0, 0, 0, 0, 2, 2 };
+};
+inline const char* policyName(l4d2_control::Policy policy) {
+  const char* names[] = { "keep", "learned-aggressive", "drop" };
+  return names[static_cast<uint32_t>(policy)];
+}
+class Controls {
+  std::mutex m_mutex;
+  bool m_initialized = false;
+  Target m_startup;
+  Host m_runtimeHost = Host::Unknown;
+public:
+  std::function<HRESULT(Target&)> read;
+  std::function<HRESULT(const Updates&)> write;
+  std::function<HRESULT(const l4d2_control::Request&, l4d2_control::Response&)> runtime;
+  void initialize(const Target& startup) {
+    std::lock_guard<std::mutex> guard(m_mutex);
+    if (!m_initialized) { m_startup = startup; m_initialized = true; }
+  }
+  void recordHost(Host host) {
+    std::lock_guard<std::mutex> guard(m_mutex);
+    if (m_runtimeHost == Host::Unknown) { m_runtimeHost = host; }
+  }
+  HRESULT invoke(const Request* request, Response* response) {
+    if (!request || !response || !compatible(*request, *response)) { return E_INVALIDARG; }
+    const auto operation = request->operation;
+    if (operation > Operation::GetReShadePresenter
+      || (operation == Operation::SetMemoryPolicy && request->value > 2)
+      || (operation == Operation::SetHostMode && request->value != static_cast<uint32_t>(Host::X86) && request->value != static_cast<uint32_t>(Host::X64))
+      || (operation == Operation::SetReShadePresenter && request->value > 1)) { return E_INVALIDARG; }
+    std::lock_guard<std::mutex> guard(m_mutex);
+    if (!m_initialized) { return E_PENDING; }
+    Response result;
+    Updates updates;
+    if (operation == Operation::SetMemoryPolicy) {
+      updates.emplace_back("client.pageBlockRetentionPolicy", policyName(static_cast<l4d2_control::Policy>(request->value)));
+      result.flags |= RuntimeAttempted;
+      l4d2_control::Request runtimeRequest;
+      runtimeRequest.operation = l4d2_control::Operation::SetPolicy; runtimeRequest.value = request->value;
+      l4d2_control::Response runtimeResponse;
+      try {
+        result.runtimeResult = runtime(runtimeRequest, runtimeResponse);
+        if (SUCCEEDED(result.runtimeResult)) { result.runtimePolicy = runtimeResponse.policy; }
+      }
+      catch (...) { result.runtimeResult = E_FAIL; }
+    } else if (operation == Operation::SetHostMode) {
+      updates = { { "forceX64Server", "True" }, { "client.testX86Server", request->value == static_cast<uint32_t>(Host::X86) ? "True" : "False" } };
+    } else if (operation == Operation::SetReShadePresenter) {
+      if (request->value) {
+        const char* values[] = { "True", "True", "36", "False", "True", "True", "True", "0", "0" };
+        for (size_t i = 0; i < 9; ++i) { updates.emplace_back(kPresenterKeys[i], values[i]); }
+      } else {
+        updates = { { kPresenterKeys[0], "False" }, { kPresenterKeys[5], "False" }, { kPresenterKeys[6], "False" } };
+      }
+    }
+    if (!updates.empty()) {
+      result.flags |= ConfigWriteAttempted;
+      try { result.configResult = write(updates); }
+      catch (...) { result.configResult = E_FAIL; }
+      result.configWriteSucceeded = SUCCEEDED(result.configResult) ? 1u : 0u;
+    }
+    result.runtimeHost = m_runtimeHost;
+    result.presenterAtStartup = m_startup.presenter[0];
+    l4d2_control::Request stats;
+    l4d2_control::Response runtimeResponse;
+    HRESULT statsResult = E_FAIL;
+    try { statsResult = runtime(stats, runtimeResponse); }
+    catch (...) {}
+    if (SUCCEEDED(statsResult)) { result.runtimePolicy = runtimeResponse.policy; }
+    else if (!(result.flags & RuntimeAttempted)) { result.runtimeResult = statsResult; }
+    Target configured;
+    try { result.queryResult = read(configured); }
+    catch (...) { result.queryResult = E_FAIL; }
+    if (SUCCEEDED(result.queryResult)) {
+      result.configuredHost = configured.host;
+      result.configuredPolicy = configured.policy;
+      result.presenterConfigured = configured.presenter[0];
+      result.restartRequired = (m_runtimeHost != Host::Unknown && configured.host != m_runtimeHost)
+        || configured.presenter != m_startup.presenter;
+    }
+    *response = result;
+    return FAILED(result.runtimeResult) || FAILED(result.configResult) || FAILED(result.queryResult) || FAILED(statsResult) ? S_FALSE : S_OK;
+  }
+};
+void initialize();
+void recordHost(Host host);
+}
