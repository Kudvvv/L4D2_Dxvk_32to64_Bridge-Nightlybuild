+    for (uint32_t mip = 0; mip < m_mips.size(); ++mip) {
+      m_mips[mip].desc = { static_cast<D3DFORMAT>(format), D3DRTYPE_SURFACE, usage, static_cast<D3DPOOL>(pool),
