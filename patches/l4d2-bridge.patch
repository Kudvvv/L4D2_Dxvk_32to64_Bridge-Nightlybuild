+namespace l4d2_overlay {
+// One instance per input thread; bounded observations of immediate callers only.
+class SuppressionDiagnostics {
+  struct Site { const char* api; const void* caller; };
+  Site m_sites[128] {};
+  size_t m_count = 0;
+  bool m_overflow = false;
+public:
+  template<typename Log>
+  void observe(const char* api, const void* caller, const char* action, Log log) {
+    struct ErrorGuard {
+      DWORD value = GetLastError();
+      ~ErrorGuard() { SetLastError(value); }
+    } guard;
+    for (size_t i = 0; i < m_count; ++i) {
+      if (std::strcmp(m_sites[i].api, api) == 0 && m_sites[i].caller == caller) { return; }
+    }
+    if (m_count == 128) {
+      if (!m_overflow) {
+        m_overflow = true;
+        try { log("L4D2_STEAM_INPUT event=input-suppression-limit sites=128 scope=thread"); } catch (...) { }
+      }
+      return;
+    }
+    m_sites[m_count++] = { api, caller };
+    HMODULE module = nullptr;
