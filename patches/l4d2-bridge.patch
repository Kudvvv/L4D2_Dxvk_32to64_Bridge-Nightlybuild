+    }
+    std::snprintf(line, sizeof(line), "L4D2_STEAM_INPUT event=state role=%s pid=%lu tick=%llu game=%p game_pid=%lu presenter=%p presenter_pid=%lu enabled=%d capture=%d foreground=%p foreground_pid=%lu game_foreground=%d gui_ok=%d active=%p focus=%p focus_pid=%lu mouse_capture=%p hit=%p hit_pid=%lu clip_ok=%d clip_w=%ld clip_h=%ld wndproc=%p wndproc_module=%s downstream=%p downstream_module=%s local_gui_ok=%d local_active=%p local_focus=%p local_capture=%p",
+      m_role, GetCurrentProcessId(), now, game, owner(game), presenter, owner(presenter), local ? !!IsWindowEnabled(local) : -1,
+      capture, foreground, owner(foreground), foreground && game && GetAncestor(foreground, GA_ROOT) == GetAncestor(game, GA_ROOT), guiOk,
+      gui.hwndActive, gui.hwndFocus, owner(gui.hwndFocus), gui.hwndCapture, hit, owner(hit), clipOk,
+      clip.right - clip.left, clip.bottom - clip.top, reinterpret_cast<void*>(procedure), procedureName, reinterpret_cast<void*>(downstream), downstreamName, localGuiOk, localGui.hwndActive, localGui.hwndFocus, localGui.hwndCapture);
+    m_log(line);
+    std::snprintf(line, sizeof(line), "L4D2_STEAM_INPUT event=messages role=%s pid=%lu tick=%llu mouse=%u keyboard=%u raw=%u forward=%u shift_tab=%u",
+      m_role, GetCurrentProcessId(), now, m_mouse.exchange(0), m_key.exchange(0), m_raw.exchange(0), m_forward.exchange(0), m_hotkey.exchange(0));
+    m_log(line);
+  }
