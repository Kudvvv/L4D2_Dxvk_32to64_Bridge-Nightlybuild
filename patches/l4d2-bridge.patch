+// Append-only, checksummed KEEP journal. No downgrade, compaction or deletion path exists.
+class Database {
+  HANDLE m_file = INVALID_HANDLE_VALUE;
+  bool m_valid = false;
+  std::unordered_map<std::string, DbRecord> m_strong;
+  std::unordered_map<std::string, std::string> m_content;
+  static constexpr const char* kHeader = "L4D2_RETENTION_SHA256_V1\n";
+
+  bool lock() {
+    OVERLAPPED overlap {};
