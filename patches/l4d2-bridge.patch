+namespace l4d2_color {
+template<typename Object, typename Getter, typename Inspector>
+HRESULT inspectTemporary(Getter getter, Inspector inspect) {
+  Object* object = nullptr;
+  const HRESULT result = getter(&object);
+  struct Release { Object* object; ~Release() { if (object) { object->Release(); } } } release { object };
+  if (SUCCEEDED(result) && object) { inspect(object); }
+  return result;
+}
+template<typename Resources, typename PixelShaders, typename VertexShaders>
+void backendSnapshot(IDirect3DDevice9* device, uint32_t deviceId, const Resources& resources,
+                     const PixelShaders& pixelShaders, const VertexShaders& vertexShaders, const char* boundary) {
+  if (!due(deviceId)) { return; }
+  summarize(deviceId);
+  D3DCAPS9 caps {}; const HRESULT capsResult = device->GetDeviceCaps(&caps);
+  DWORD states[9] {}; uint32_t valid = 0;
+  const D3DRENDERSTATETYPE kinds[] = { D3DRS_SRGBWRITEENABLE, D3DRS_FOGENABLE, D3DRS_FOGCOLOR,
+    D3DRS_FOGSTART, D3DRS_FOGEND, D3DRS_COLORWRITEENABLE, D3DRS_FOGDENSITY, D3DRS_FOGTABLEMODE, D3DRS_FOGVERTEXMODE };
+  for (unsigned i = 0; i < 9; ++i) {
+    if (SUCCEEDED(device->GetRenderState(kinds[i], &states[i]))) { valid |= 1u << i; }
+  }
+  uint32_t pixelId = 0, vertexId = 0;
+  const HRESULT pixelResult = inspectTemporary<IDirect3DPixelShader9>(
+    [&](IDirect3DPixelShader9** object) { return device->GetPixelShader(object); },
+    [&](IDirect3DPixelShader9* object) {
+      for (const auto& entry : pixelShaders) { if (entry.second == object) { pixelId = entry.first; break; } }
+    });
+  const HRESULT vertexResult = inspectTemporary<IDirect3DVertexShader9>(
+    [&](IDirect3DVertexShader9** object) { return device->GetVertexShader(object); },
+    [&](IDirect3DVertexShader9* object) {
