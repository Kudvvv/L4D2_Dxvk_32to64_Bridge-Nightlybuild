+      || response.blockWidth != l.blockWidth || response.blockHeight != l.blockHeight || response.blockBytes != l.blockBytes) {
+      failure(id, repeat, "response-layout", E_INVALIDARG, "returned-layout-does-not-match"); continue;
+    }
+    ++c.recovered;
+    // This is the first access to original bytes in the experiment.
+    Comparison difference;
+    LARGE_INTEGER compareBegin {}, compareEnd {}; QueryPerformanceCounter(&compareBegin);
+    hr = original.compareRecovered(recovered.data(), response.bytes, difference);
+    QueryPerformanceCounter(&compareEnd);
+    if (FAILED(hr)) { failure(id, repeat, "reference-comparison", hr, "reference-could-not-be-mapped"); continue; }
+    if (!difference.mismatchBytes) { ++c.matches; } else { ++c.mismatches; }
+    recovered.discard();
