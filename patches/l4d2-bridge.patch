+// All newly added implementation code in this fork was generated by OpenAI Codex from prompts and specifications provided by yeyunyyds.
+#pragma once
+
+#include <cstddef>
+#include <cstring>
+#include <d3d9.h>
+
+namespace l4d2_adapter {
+
+constexpr size_t kIdentifierBytes = offsetof(D3DADAPTER_IDENTIFIER9, WHQLLevel) + sizeof(DWORD);
+constexpr size_t kIdentifierAlignedBytes = (kIdentifierBytes + 7) & ~size_t(7);
+static_assert(sizeof(D3DADAPTER_IDENTIFIER9) == kIdentifierBytes ||
+  sizeof(D3DADAPTER_IDENTIFIER9) == kIdentifierAlignedBytes, "Unsupported adapter identifier layout");
+
+inline bool decodeIdentifier(const void* data, size_t bytes, D3DADAPTER_IDENTIFIER9& output) {
+  if (!data || (bytes != kIdentifierBytes && bytes != kIdentifierAlignedBytes)) { return false; }
+  D3DADAPTER_IDENTIFIER9 decoded {};
+  // Native x86 and x64 structures differ only in trailing alignment padding.
+  std::memcpy(&decoded, data, kIdentifierBytes);
+  output = decoded;
+  return true;
+}
+
+inline bool decodeCaps(const void* data, size_t bytes, D3DCAPS9& output) {
+  if (!data || bytes != sizeof(D3DCAPS9)) { return false; }
+  std::memcpy(&output, data, sizeof(D3DCAPS9));
+  return true;
+}
+
+}
