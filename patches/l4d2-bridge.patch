+namespace l4d2_reset {
+// Query RPCs inspect resources already owned by their creation/link mappings.
+class SurfaceQueries {
+public:
+  HRESULT finish(HRESULT result, IUnknown* object, IUnknown* expected) {
+    ++m_count;
+    bool matches = object && object == expected;
+    if (SUCCEEDED(result) && object && expected && !matches) {
+      IUnknown* actualIdentity = nullptr;
+      IUnknown* expectedIdentity = nullptr;
+      object->QueryInterface(__uuidof(IUnknown), reinterpret_cast<void**>(&actualIdentity));
+      expected->QueryInterface(__uuidof(IUnknown), reinterpret_cast<void**>(&expectedIdentity));
+      matches = actualIdentity && actualIdentity == expectedIdentity;
+      if (actualIdentity) { actualIdentity->Release(); }
+      if (expectedIdentity) { expectedIdentity->Release(); }
+    }
+    const bool mismatch = SUCCEEDED(result) && !matches;
+    if (mismatch) { ++m_mismatches; }
+    if (object) { object->Release(); }
+    return mismatch ? D3DERR_INVALIDCALL : result;
+  }
+  uint64_t count() const { return m_count; }
+  uint64_t mismatches() const { return m_mismatches; }
+private:
+  uint64_t m_count = 0, m_mismatches = 0;
+};
+
+// Each entry owns one reference returned by a backend Get method.
+class SwapchainReferences {
+public:
+  void adopt(uint32_t handle, IUnknown* object, uint32_t owner = 0) {
+    release(handle);
+    if (object) { m_entries.emplace(handle, Entry { object, owner }); }
+  }
+
+  bool release(uint32_t handle) {
+    const auto entry = m_entries.find(handle);
+    if (entry == m_entries.end()) { return false; }
+    IUnknown* object = entry->second.object;
+    m_entries.erase(entry);
+    object->Release();
+    return true;
+  }
+
+  template<typename Erase>
+  uint32_t releaseChildren(uint32_t owner, Erase erase) {
+    uint32_t count = 0;
+    for (auto entry = m_entries.begin(); entry != m_entries.end();) {
+      if (entry->second.owner != owner || !owner) { ++entry; continue; }
+      const auto handle = entry->first;
+      IUnknown* object = entry->second.object;
+      entry = m_entries.erase(entry);
+      object->Release();
+      erase(handle);
+      ++count;
+    }
+    return count;
+  }
+
+private:
+  struct Entry { IUnknown* object; uint32_t owner; };
+  std::unordered_map<uint32_t, Entry> m_entries;
+};
+}
