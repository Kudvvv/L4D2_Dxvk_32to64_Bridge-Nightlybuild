+    auto moduleName = [](LONG_PTR address, char* path) -> const char* {
+      HMODULE module = nullptr;
+      if (!address || !GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+        reinterpret_cast<LPCSTR>(address), &module) || !GetModuleFileNameA(module, path, MAX_PATH)) { return "unresolved"; }
