+      id, repeat, stageName(response.stage), static_cast<unsigned long>(response.hresult), static_cast<unsigned long long>(elapsed),
+      static_cast<unsigned long long>(response.syncUs), response.flushRequested, response.eventWait, response.queryPolls, response.deviceIdle);
