+
+namespace l4d2_observation {
+// Configured once before Bridge worker threads start; not a live control setting.
+inline bool memoryMonitoring = false;
+inline bool recoveryTiming = false;
+
+class Observer {
+  std::function<void(const char*)> m_callback;
+  std::atomic<bool> m_failed { false };
+public:
+  Observer() = default;
+  explicit Observer(std::function<void(const char*)> callback) noexcept : m_callback(std::move(callback)) { }
+  Observer(const Observer& other) : m_callback(other.m_callback), m_failed(other.m_failed.load(std::memory_order_relaxed)) { }
+  Observer& operator=(const Observer& other) {
+    if (this != &other) {
+      m_callback = other.m_callback;
+      m_failed.store(other.m_failed.load(std::memory_order_relaxed), std::memory_order_relaxed);
+    }
+    return *this;
+  }
+  Observer& operator=(std::function<void(const char*)> callback) {
+    m_callback = std::move(callback); m_failed.store(false, std::memory_order_relaxed);
+    return *this;
+  }
+  explicit operator bool() const {
+    return m_callback && !m_failed.load(std::memory_order_relaxed);
+  }
+  void notify(const char* message) noexcept {
+    if (!*this) { return; }
+    try { m_callback(message); }
+    // Keep published callback storage intact for concurrent users.
+    catch (...) { m_failed.store(true, std::memory_order_relaxed); }
+  }
+  void operator()(const char* message) noexcept { notify(message); }
+};
+inline void notify(Observer& observer, const char* message) noexcept { observer.notify(message); }
+
+struct InputDemand {
+  bool remix = false;
+  bool presenterWindow = false, presenterInput = true;
+  bool messagePump = false, customHooks = false, exclusiveInput = false;
+  bool mouseForward = false, keyboardForward = false, steamInput = false;
+  bool requested() const {
+    return remix || (presenterWindow && presenterInput) || messagePump || customHooks
+      || exclusiveInput || mouseForward || keyboardForward || steamInput;
+  }
+};
+// An explicit new switch overrides the old detailed-mode request.
+inline bool crashHistory(bool defined, bool requested, bool detailed) {
+  return defined ? requested : detailed;
+}
+}
