+
+namespace l4d2_queue {
+struct Snapshot {
+  uint64_t waits, timeouts, failures, legacyWaits, signals, signalFailures;
+  uint64_t fullWaits, fullWaitMs, maxFullWaitMs;
+};
+
+class Counters {
+  std::atomic<uint64_t> m_waits{0}, m_timeouts{0}, m_failures{0}, m_legacyWaits{0};
+  std::atomic<uint64_t> m_signals{0}, m_signalFailures{0};
+  std::atomic<uint64_t> m_fullWaits{0}, m_fullWaitMs{0}, m_maxFullWaitMs{0};
+public:
+  void waited(bool timeout, bool failed) {
+    if (!l4d2_observation::memoryMonitoring) { return; }
+    m_waits.fetch_add(1, std::memory_order_relaxed);
+    if (timeout) { m_timeouts.fetch_add(1, std::memory_order_relaxed); }
+    if (failed) { m_failures.fetch_add(1, std::memory_order_relaxed); }
+  }
+  void legacyWait() {
+    if (l4d2_observation::memoryMonitoring) { m_legacyWaits.fetch_add(1, std::memory_order_relaxed); }
+  }
+  void signaled(bool success) {
+    if (!l4d2_observation::memoryMonitoring) { return; }
+    (success ? m_signals : m_signalFailures).fetch_add(1, std::memory_order_relaxed);
+  }
+  void blocked(uint64_t elapsedMs) {
+    if (!l4d2_observation::memoryMonitoring) { return; }
+    m_fullWaits.fetch_add(1, std::memory_order_relaxed);
+    m_fullWaitMs.fetch_add(elapsedMs, std::memory_order_relaxed);
+    auto previous = m_maxFullWaitMs.load(std::memory_order_relaxed);
+    while (previous < elapsedMs && !m_maxFullWaitMs.compare_exchange_weak(
+        previous, elapsedMs, std::memory_order_relaxed)) {}
+  }
+  Snapshot snapshot() const {
+    return {m_waits.load(std::memory_order_relaxed), m_timeouts.load(std::memory_order_relaxed),
+      m_failures.load(std::memory_order_relaxed), m_legacyWaits.load(std::memory_order_relaxed),
+      m_signals.load(std::memory_order_relaxed), m_signalFailures.load(std::memory_order_relaxed),
+      m_fullWaits.load(std::memory_order_relaxed), m_fullWaitMs.load(std::memory_order_relaxed),
+      m_maxFullWaitMs.load(std::memory_order_relaxed)};
+  }
+};
+
+// Local to each binary/process; records waiting and notifications, not every command.
+inline Counters counters;
+
+inline int format(char* destination, size_t capacity) {
+  const auto s = counters.snapshot();
+  return std::snprintf(destination, capacity,
+    " q_wait_events=%llu q_wait_timeouts=%llu q_wait_failures=%llu q_legacy_waits=%llu "
+    "q_wake_signals=%llu q_wake_failures=%llu q_full_waits=%llu "
+    "q_full_wait_ms=%llu q_full_wait_max_ms=%llu\r\n",
+    static_cast<unsigned long long>(s.waits), static_cast<unsigned long long>(s.timeouts),
