+    if (ok) { ok = SUCCEEDED(hashBytes(reinterpret_cast<const uint8_t*>(prefix.data()), prefix.size(), checksum)); }
+    if (ok) { ok = appendLocked(prefix + '\t' + digestText(checksum).data() + '\n'); }
