+    for (auto& subresource : m_mips) {
+      if (subresource.reclaimWhenIdle) { subresource.reclaimWhenIdle(); }
+    }
+  }
+  void noteEvicted(uint32_t mip, uint64_t bytes) {
+    std::lock_guard<std::recursive_mutex> guard(m_context.mutex);
+    if (mip >= m_mips.size()) { return; }
+    if (!m_dropped) { m_dropped = true; if (m_context.log) { ++m_context.drops; } }
