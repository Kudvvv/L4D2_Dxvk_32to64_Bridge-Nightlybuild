+  if (!source || !recovered || pitch <= 0 || static_cast<uint32_t>(pitch) < l.rowBytes || !l.rows || !l.bytes) { return false; }
+  for (uint32_t row = 0; row < l.rows; ++row) {
+    std::memcpy(recovered + static_cast<size_t>(row) * l.rowBytes,
+      source + static_cast<size_t>(row) * static_cast<uint32_t>(pitch), l.rowBytes);
+  }
+  return true;
+}
+
+inline bool packResidencyRows(const uint8_t* source, int32_t pitch, uint32_t width,
+                             uint32_t height, uint32_t format, uint8_t* recovered, const Layout& l) {
+  if (l4d2_ati::isFormat(format)) {
+    l4d2_ati::Layout ati;
+    if (!l4d2_ati::layout(width, height, format, ati) || ati.storagePitch != l.rowBytes
+      || ati.rows != l.rows || ati.bytes != l.bytes) { return false; }
