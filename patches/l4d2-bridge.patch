+  append("architecture=unsupported registers=unavailable stack=unavailable\n");
+#endif
+}
+void reportHistory(const char* label, const History& history) {
+  append("history=%s scope=faulting_thread count=%u newest_first=1\n", label, history.count);
+  const unsigned limit = s_detailed ? kHistorySize : 16;
+  for (unsigned i = 0; i < history.count && i < limit; ++i) {
+    const auto& command = history.entries[(history.next + kHistorySize - 1 - i) % kHistorySize];
+    append("%s[%u] command=%s opcode=%u queue=%s object_id=0x%lx uid_known=%u uid=%lu\n",
+           label, i, Commands::toName(static_cast<Commands::D3D9Command>(command.opcode)), command.opcode,
+           queueName(command.queue), static_cast<unsigned long>(command.objectId), command.uidKnown,
+           static_cast<unsigned long>(command.uid));
+  }
+}
+__declspec(noinline) void buildReport(EXCEPTION_POINTERS* pointers, DWORD code) {
+  SYSTEMTIME now {};
+  GetSystemTime(&now);
+  append("timestamp_utc=%04u-%02u-%02uT%02u:%02u:%02u.%03uZ side=%s pid=%lu tid=%lu session=%s\n",
+         now.wYear, now.wMonth, now.wDay, now.wHour, now.wMinute, now.wSecond, now.wMilliseconds,
+         side(), GetCurrentProcessId(), GetCurrentThreadId(), sessionName());
+  append("process_path=%s\n", s_processPath);
+  const auto* record = pointers ? pointers->ExceptionRecord : nullptr;
+  if (record) {
+    append("exception_code=0x%08lx exception_name=%s exception_flags=0x%lx\n",
+           code, exceptionName(code), record->ExceptionFlags);
+    append("exception_address=0x%llx\n", static_cast<unsigned long long>(reinterpret_cast<uintptr_t>(record->ExceptionAddress)));
+    describeAddress("exception", reinterpret_cast<uintptr_t>(record->ExceptionAddress));
+    if (record->ExceptionCode == EXCEPTION_ACCESS_VIOLATION || record->ExceptionCode == EXCEPTION_IN_PAGE_ERROR) {
+      if (record->NumberParameters >= 2 && record->NumberParameters <= EXCEPTION_MAXIMUM_PARAMETERS) {
+        const auto access = record->ExceptionInformation[0];
+        append("access_type=%s access_raw=%llu target_address=0x%llx\n",
+               access == 0 ? "read" : access == 1 ? "write" : access == 8 ? "execute" : "unknown",
+               static_cast<unsigned long long>(access), static_cast<unsigned long long>(record->ExceptionInformation[1]));
+        if (record->ExceptionCode == EXCEPTION_IN_PAGE_ERROR && record->NumberParameters >= 3) {
+          append("in_page_status=0x%llx\n", static_cast<unsigned long long>(record->ExceptionInformation[2]));
+        }
+      } else { append("access_type=unavailable target_address=unavailable reason=invalid_exception_parameters\n"); }
+    }
+  } else { append("exception_record=unavailable\n"); }
+  const auto* history = s_thread;
+  if (history && history->current.active) {
+    const auto& current = history->current;
+    append("current_command=%s opcode=%u queue=%s object_id=0x%lx resource_id=unavailable uid_known=%u uid=%lu handler=%s\n",
+           Commands::toName(static_cast<Commands::D3D9Command>(current.opcode)), current.opcode,
+           queueName(current.queue), static_cast<unsigned long>(current.objectId), current.uidKnown,
+           static_cast<unsigned long>(current.uid), current.handler ? current.handler : "unavailable");
+  } else { append("current_command=unavailable reason=no_active_bridge_command_on_faulting_thread\n"); }
+  append("client_call=%s client_call_this=0x%llx\n", history && history->call ? history->call : "unavailable",
+         static_cast<unsigned long long>(history ? history->callObject : 0));
+  if (history) {
+    reportHistory("sent", history->sent); reportHistory("received", history->received);
+  } else {
+    append("history=sent scope=faulting_thread count=0 newest_first=1\n");
+    append("history=received scope=faulting_thread count=0 newest_first=1\n");
+  }
+  reportContext(pointers ? pointers->ContextRecord : nullptr);
+  if (s_detailed) {
+    void* frames[16] {};
+    const auto count = CaptureStackBackTrace(0, 16, frames, nullptr);
+    append("handler_stack_kind=reporter_call_stack_not_fault_stack\n");
+    for (USHORT i = 0; i < count; ++i) {
+      char label[32] {};
+      sprintf_s(label, "handler_frame%u", i);
+      describeAddress(label, reinterpret_cast<uintptr_t>(frames[i]));
+    }
+  }
+}
+// SEH guards are isolated from C++ unwinding objects (MSVC C2712).
+__declspec(noinline) bool guardedBuild(EXCEPTION_POINTERS* pointers, DWORD code) {
+  __try {
+    buildReport(pointers, code);
+    return true;
+  }
+  __except (EXCEPTION_EXECUTE_HANDLER) { return false; }
+}
+__declspec(noinline) bool guardedCode(EXCEPTION_POINTERS* pointers, DWORD* code) {
+  __try {
+    if (!pointers || !pointers->ExceptionRecord) { return false; }
+    *code = pointers->ExceptionRecord->ExceptionCode;
+    return true;
+  }
+  __except (EXCEPTION_EXECUTE_HANDLER) { return false; }
+}
+LONG WINAPI handleException(EXCEPTION_POINTERS* pointers) {
+  DWORD code = 0;
+  const bool codeAvailable = guardedCode(pointers, &code);
+  const LONG tid = static_cast<LONG>(GetCurrentThreadId());
+  const LONG owner = InterlockedCompareExchange(&s_reportingThread, tid, 0);
+  if (owner) {
+    if (owner != tid && s_reportDone) { WaitForSingleObject(s_reportDone, 2000); }
+    const char marker[] = "L4D2_BRIDGE_EXCEPTION secondary_or_concurrent_fault=1 terminating=1\n";
+    writeBytes(s_logFile, marker, sizeof(marker) - 1);
+    flushOutput(s_logFile);
+    TerminateProcess(GetCurrentProcess(), kUnhandledExceptionExitCode);
+    return EXCEPTION_EXECUTE_HANDLER;
+  }
+  s_used = 0;
+  append("===== L4D2_BRIDGE_EXCEPTION_BEGIN =====\n");
+  if (codeAvailable) { append("exception_code_snapshot=0x%08lx\n", code); }
+  else { append("exception_code_snapshot=unavailable\n"); }
+  if (!guardedBuild(pointers, code)) { append("report_incomplete=1 reason=secondary_fault_during_report\n"); }
+  const auto error = GetStdHandle(STD_ERROR_HANDLE);
+  const auto errorType = error && error != INVALID_HANDLE_VALUE ? GetFileType(error) : FILE_TYPE_UNKNOWN;
+  append("stderr_report=%s\n", errorType == FILE_TYPE_DISK || errorType == FILE_TYPE_CHAR ? "raw_write" : "skipped_unavailable_or_pipe");
+  // Reserve enough tail space so partial/unwind failures still get an end marker.
+  const char tail[] = "termination=TerminateProcess termination_exit_code=0xe04c3441\n===== L4D2_BRIDGE_EXCEPTION_END =====\n";
+  if (s_used > kReportSize - sizeof(tail)) { s_used = kReportSize - sizeof(tail); }
+  memcpy(s_report + s_used, tail, sizeof(tail) - 1);
+  s_used += static_cast<unsigned>(sizeof(tail) - 1);
+  writeBytes(s_logFile, s_report, s_used);
+  flushOutput(s_logFile);
+  SYSTEMTIME now {};
+  GetSystemTime(&now);
+  wchar_t filename[1280] {};
+  HANDLE reportFile = INVALID_HANDLE_VALUE;
+  if (s_reportDirectory[0]) {
+    _snwprintf_s(filename, _countof(filename), _TRUNCATE,
+      L"%ls\\bridge-exception-%04u%02u%02u-%02u%02u%02u-%03u-%lu.txt", s_reportDirectory,
+      now.wYear, now.wMonth, now.wDay, now.wHour, now.wMinute, now.wSecond, now.wMilliseconds, GetCurrentProcessId());
+    reportFile = CreateFileW(filename, GENERIC_WRITE, FILE_SHARE_READ, nullptr, CREATE_NEW,
+                             FILE_ATTRIBUTE_NORMAL | FILE_FLAG_WRITE_THROUGH, nullptr);
+    writeBytes(reportFile, s_report, s_used);
+    flushOutput(reportFile);
+    if (reportFile != INVALID_HANDLE_VALUE) { CloseHandle(reportFile); }
+  }
+  // Raw stderr avoids CRT buffering and a possibly held FILE lock.
+  if (errorType == FILE_TYPE_DISK || errorType == FILE_TYPE_CHAR) {
+    writeBytes(error, s_report, s_used);
+    flushOutput(error);
+  }
+  if (s_reportDone) { SetEvent(s_reportDone); }
+  TerminateProcess(GetCurrentProcess(), kUnhandledExceptionExitCode);
+  return EXCEPTION_EXECUTE_HANDLER;
+}
+BOOL CALLBACK initializeOnce(PINIT_ONCE, PVOID parameter, PVOID*) {
+  const auto* settings = static_cast<const Settings*>(parameter);
+  const auto reportDirectory = settings->reportDirectory;
+  s_detailed = settings->detailed;
+  s_history = settings->history;
+  if (reportDirectory && wcslen(reportDirectory) < _countof(s_reportDirectory)) {
+    wcscpy_s(s_reportDirectory, reportDirectory);
+    if (!CreateDirectoryW(reportDirectory, nullptr) && GetLastError() != ERROR_ALREADY_EXISTS) {
+      s_reportDirectory[0] = 0;
+    }
+  }
+  wchar_t process[1024] {};
+  const auto length = GetModuleFileNameW(nullptr, process, _countof(process));
+  if (length && length < _countof(process) - 1) {
+    WideCharToMultiByte(CP_UTF8, 0, process, -1, s_processPath, sizeof(s_processPath), nullptr, nullptr);
+  }
+  s_reportDone = CreateEventW(nullptr, TRUE, FALSE, nullptr);
+  ULONG stackBytes = 32 * 1024;
+  SetThreadStackGuarantee(&stackBytes);
+  return TRUE;
+}
+}
+
+void initialize(const wchar_t* reportDirectory, bool detailed, bool history) {
+  Settings settings { reportDirectory, detailed, history };
