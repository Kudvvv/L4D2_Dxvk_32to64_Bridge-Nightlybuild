+#endif
+void logPeerExit(const char* peerRole, DWORD peerPid, DWORD exitCode) {
+  SYSTEMTIME now {};
+  GetSystemTime(&now);
+  char line[512] {};
+  const int length = sprintf_s(line,
+    "L4D2_BRIDGE_PEER_EXIT timestamp_utc=%04u-%02u-%02uT%02u:%02u:%02u.%03uZ side=%s pid=%lu tid=%lu session=%s peer_role=%s peer_pid=%lu peer_exit_code=0x%08lx attribution=peer_exit_only consult_peer_exception_report=1\n",
+    now.wYear, now.wMonth, now.wDay, now.wHour, now.wMinute, now.wSecond, now.wMilliseconds,
+    side(), GetCurrentProcessId(), GetCurrentThreadId(), sessionName(), peerRole, peerPid, exitCode);
+  if (length > 0) { writeBytes(s_logFile, line, static_cast<unsigned>(length)); }
+  flushOutput(s_logFile);
+}
+void terminateAfterPeerException() { TerminateProcess(GetCurrentProcess(), kPeerExceptionExitCode); }
+void logDiagnostic(const char* message) {
+  SYSTEMTIME now {};
