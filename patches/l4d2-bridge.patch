+#pragma pack(pop)
+static_assert(sizeof(Request) == 240, "x86/x64 request layout");
+static_assert(sizeof(Response) == 88, "x86/x64 response layout");
+static_assert(offsetof(Response, syncUs) == 72, "x86/x64 response alignment");
+
+inline uint64_t microseconds(LARGE_INTEGER begin, LARGE_INTEGER end) {
+  LARGE_INTEGER frequency {}; QueryPerformanceFrequency(&frequency);
+  return frequency.QuadPart ? static_cast<uint64_t>((end.QuadPart - begin.QuadPart) * 1000000 / frequency.QuadPart) : 0;
+}
+
+inline bool acknowledgement(const Request& request) { return request.operation == 1 || request.operation == 3; }
+inline bool requestValid(const Request& request, Layout& l) {
+  const bool residency = request.operation == 2 || request.operation == 3;
+  const bool identity = request.version == kVersion && request.resourceId && request.parentId && request.mip < 15
+    && request.levels <= 15 && request.name[95] == 0 && std::wcsncmp(request.name, L"Local\\L4D2Recovery-", 19) == 0;
+  if (!identity || request.operation > 3) { return false; }
+  if (residency) {
+    if (request.pool > 3 || !request.width || !request.height || request.width > 16384 || request.height > 16384
+      || !request.bytes || request.bytes > kMaxBytes) { return false; }
+    if (acknowledgement(request)) { l = {}; return true; }
+  } else if (request.pool != 1 || request.usage != 0) { return false; }
+  return (residency ? residencyLayout(request.width, request.height, request.format, l)
+    : layout(request.width, request.height, request.format, l)) && request.bytes == l.bytes;
+}
