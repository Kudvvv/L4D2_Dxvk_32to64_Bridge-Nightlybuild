+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 yeyunyyds.
+// All newly added implementation code in this fork was generated by OpenAI Codex from prompts and specifications provided by yeyunyyds.
+#pragma once
+#include <cstdint>
+#include <new>
+#include "memory_diagnostics.h"
+
+namespace l4d2_buffer {
+// Core owns the allocation and its throwing/zero-initialization contract.
+inline uint8_t* allocate(size_t size, l4d2_memory::Kind kind, bool zero = false) {
+  l4d2_memory::sample(false, "before-allocation", kind, size);
+  uint8_t* result = nullptr;
+  try { result = zero ? new uint8_t[size]() : new uint8_t[size]; }
+  catch (const std::bad_alloc&) {
+    l4d2_memory::sample(true, "allocation-failed", kind, size);
+    throw;
+  }
+  l4d2_memory::allocated(size, kind);
+  return result;
+}
+}
