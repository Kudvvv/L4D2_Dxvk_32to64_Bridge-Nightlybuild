+#include "readback_layout.h"
+
+namespace l4d2_readback {
+enum class Stage : uint32_t {
+  Pending, Complete, Protocol, Disabled, Resource, Descriptor, Mapping,
+  GetDevice, QueryCreate, QueryIssue, QueryWait, Lock, Pitch, Unlock
+};
+inline const char* stageName(Stage stage) {
+  switch (stage) {
+  case Stage::Pending: return "pending";
+  case Stage::Complete: return "complete";
+  case Stage::Protocol: return "protocol";
+  case Stage::Disabled: return "disabled";
+  case Stage::Resource: return "resource";
+  case Stage::Descriptor: return "descriptor";
+  case Stage::Mapping: return "mapping";
+  case Stage::GetDevice: return "get-device";
+  case Stage::QueryCreate: return "query-create";
+  case Stage::QueryIssue: return "query-issue";
+  case Stage::QueryWait: return "query-wait";
+  case Stage::Lock: return "readonly-lock";
+  case Stage::Pitch: return "pitch";
+  case Stage::Unlock: return "readonly-unlock";
+  }
+  return "unknown";
+}
+
+#pragma pack(push, 8)
+struct Request {
+  uint32_t version = kVersion, resourceId = 0, parentId = 0;
+  uint32_t width = 0, height = 0, format = 0, mip = 0;
+  uint32_t pool = 1, usage = 0, bytes = 0;
+  uint32_t operation = 0;
+  uint32_t levels = 0;
+  wchar_t name[96] {};
+};
+struct Response {
+  uint32_t version = kVersion;
+  int32_t hresult = static_cast<int32_t>(0x80004005u);
+  Stage stage = Stage::Pending;
+  uint32_t bytes = 0, width = 0, height = 0, format = 0, mip = 0;
+  uint32_t rowBytes = 0, rows = 0, backendPitch = 0;
+  uint32_t blockWidth = 0, blockHeight = 0, blockBytes = 0;
+  uint32_t flushRequested = 0, eventWait = 0, queryPolls = 0, deviceIdle = 0;
+  uint64_t syncUs = 0, backendReadUs = 0;
