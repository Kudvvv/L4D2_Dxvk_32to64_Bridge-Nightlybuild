+struct Comparison {
+  uint64_t mismatchBytes = 0;
+  int64_t firstOffset = -1;
+  uint32_t expected = 0, actual = 0;
+};
+
+inline Comparison compare(const uint8_t* reference, const uint8_t* recovered, size_t bytes) {
+  Comparison result;
+  if (std::memcmp(reference, recovered, bytes) == 0) { return result; }
+  for (size_t i = 0; i < bytes; ++i) {
+    if (reference[i] != recovered[i]) {
+      if (result.firstOffset < 0) {
+        result.firstOffset = static_cast<int64_t>(i);
+        result.expected = reference[i]; result.actual = recovered[i];
+      }
+      ++result.mismatchBytes;
+    }
+  }
+  return result;
+}
