+// Independent section: no PagefileShadow, retained data or upload cache is used.
+class Temporary {
+  HANDLE m_section = nullptr, m_event = nullptr;
+  uint8_t* m_view = nullptr;
+public:
+  Temporary() = default;
+  Temporary(const Temporary&) = delete;
+  Temporary& operator=(const Temporary&) = delete;
+  ~Temporary() {
+    discard();
+  }
+  void discard() {
+    if (m_view) { UnmapViewOfFile(m_view); }
+    if (m_event) { CloseHandle(m_event); }
+    if (m_section) { CloseHandle(m_section); }
+    m_view = nullptr; m_event = m_section = nullptr;
+  }
+  HRESULT create(const Request& request) {
+    m_section = CreateFileMappingW(INVALID_HANDLE_VALUE, nullptr, PAGE_READWRITE,
+      0, (acknowledgement(request) ? 0 : request.bytes) + static_cast<DWORD>(sizeof(Response)), request.name);
+    const auto sectionError = GetLastError();
+    if (!m_section || sectionError == ERROR_ALREADY_EXISTS) {
+      return HRESULT_FROM_WIN32(sectionError ? sectionError : ERROR_INVALID_HANDLE);
+    }
+    wchar_t eventName[112] {};
+    swprintf_s(eventName, L"%ls-done", request.name);
+    m_event = CreateEventW(nullptr, TRUE, FALSE, eventName);
+    const auto eventError = GetLastError();
+    if (!m_event || eventError == ERROR_ALREADY_EXISTS) {
+      return HRESULT_FROM_WIN32(eventError ? eventError : ERROR_INVALID_HANDLE);
+    }
+    m_view = static_cast<uint8_t*>(MapViewOfFile(m_section, FILE_MAP_ALL_ACCESS, 0, 0,
+      (acknowledgement(request) ? 0 : request.bytes) + sizeof(Response)));
+    if (!m_view) { return HRESULT_FROM_WIN32(GetLastError()); }
+    const Response pending;
+    std::memcpy(m_view, &pending, sizeof(pending));
+    return S_OK;
+  }
+  DWORD wait(DWORD milliseconds) const {
+    l4d2_api_wait::Span apiRecoveryWaitTiming(l4d2_api_wait::Metric::ResourceWait);
+    return WaitForSingleObject(m_event, milliseconds);
+  }
+  Response response() const {
+    Response r; std::memcpy(&r, m_view, sizeof(r)); return r;
+  }
+  const uint8_t* data() const { return m_view + sizeof(Response); }
+};
+}
