+CommandScope::CommandScope(Queue queue, uint16_t opcode, uint32_t objectId, const char* handler, bool uidKnown, uint32_t uid)
+{
+  auto* state = threadState();
+  if (!state) { return; }
+  m_active = true;
+  m_previous = state->current;
+  state->current = { opcode, queue, true, uidKnown, uid, objectId, handler };
+}
+CommandScope::~CommandScope() { if (m_active && s_thread) { s_thread->current = m_previous; } }
+void CommandScope::setUid(uint32_t uid) {
+  if (!m_active || !s_thread) { return; }
+  s_thread->current.uid = uid; s_thread->current.uidKnown = true;
+}
+CallScope::CallScope(const char* name, uintptr_t object)
+{
+  auto* state = threadState();
+  if (!state) { return; }
+  m_active = true;
+  m_previousName = state->call; m_previousObject = state->callObject;
+  state->call = name;
+  state->callObject = object;
+}
+CallScope::~CallScope() {
+  if (m_active && s_thread) { s_thread->call = m_previousName; s_thread->callObject = m_previousObject; }
+}
+void recordCommand(bool sent, Queue queue, uint16_t opcode, uint32_t objectId, bool uidKnown, uint32_t uid) {
+  auto* state = threadState();
+  if (!state) { return; }
+  auto& history = sent ? state->sent : state->received;
+  history.entries[history.next] = { opcode, queue, false, uidKnown, uid, objectId, nullptr };
+  history.next = (history.next + 1) % kHistorySize;
+  if (history.count < kHistorySize) { ++history.count; }
+}
+}
