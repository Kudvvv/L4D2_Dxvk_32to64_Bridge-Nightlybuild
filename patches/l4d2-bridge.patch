+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 yeyunyyds.
+// All newly added implementation code in this fork was generated by OpenAI Codex from prompts and specifications provided by yeyunyyds.
+
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <unordered_map>
+#include <windows.h>
+#include <dxgi1_4.h>
+
+namespace l4d2_host_memory {
+enum class ResourceKind : size_t { Texture, CubeTexture, VolumeTexture, VertexBuffer, IndexBuffer, Surface, Count };
+
+struct ResourceTotals {
+  std::array<uint64_t, static_cast<size_t>(ResourceKind::Count)> live {};
+  uint64_t registrations = 0;
+  uint64_t rebinds = 0;
+  uint64_t replacements = 0;
+  uint64_t destroys = 0;
+  uint64_t unlinks = 0;
+  uint64_t missingErases = 0;
+  uint64_t handles = 0;
+};
+
+// Device-thread metadata only; stores identities, never owns or dereferences COM objects.
+class ResourceInventory {
+  struct Entry { uintptr_t identity; ResourceKind kind; };
+  std::unordered_map<uint32_t, Entry> m_entries;
+  ResourceTotals m_totals;
+
+public:
+  void track(uint32_t handle, uintptr_t identity, ResourceKind kind) {
+    ++m_totals.registrations;
+    const auto found = m_entries.find(handle);
+    if (found != m_entries.end()) {
+      if (found->second.identity == identity && found->second.kind == kind) {
+        ++m_totals.rebinds;
+        return;
+      }
+      ++m_totals.replacements;
+      --m_totals.live[static_cast<size_t>(found->second.kind)];
+      found->second = { identity, kind };
+    } else {
+      m_entries.emplace(handle, Entry { identity, kind });
+    }
+    ++m_totals.live[static_cast<size_t>(kind)];
+  }
+
+  void erase(uint32_t handle, bool unlink = false) {
+    if (unlink) { ++m_totals.unlinks; } else { ++m_totals.destroys; }
+    const auto found = m_entries.find(handle);
+    if (found == m_entries.end()) { ++m_totals.missingErases; return; }
+    --m_totals.live[static_cast<size_t>(found->second.kind)];
+    m_entries.erase(found);
+  }
+
+  ResourceTotals snapshot() const {
+    auto result = m_totals;
+    result.handles = m_entries.size();
+    return result;
+  }
+};
+
+struct AddressMemory {
+  uint64_t privateCommit = 0;
+  uint64_t mappedCommit = 0;
+  uint64_t imageCommit = 0;
+  uint64_t freeBytes = 0;
+  uint64_t largestFreeBlock = 0;
+  uint64_t regions = 0;
+  uint64_t elapsedMs = 0;
+  bool valid = false;
+};
+
+// Address categories do not identify the allocator or physical/GPU residency.
+inline AddressMemory queryAddressMemory() {
+  AddressMemory result;
+  const auto start = GetTickCount64();
+  SYSTEM_INFO system {};
+  // Query the address range exposed to this process, including the x86 comparison host.
+  GetSystemInfo(&system);
+  const auto maximum = reinterpret_cast<uintptr_t>(system.lpMaximumApplicationAddress);
+  uintptr_t address = 0;
+  while (address <= maximum) {
+    MEMORY_BASIC_INFORMATION info {};
+    if (!VirtualQuery(reinterpret_cast<void*>(address), &info, sizeof(info))) {
+      result.elapsedMs = GetTickCount64() - start;
+      return result;
+    }
+    ++result.regions;
+    if (info.State == MEM_FREE) {
+      result.freeBytes += info.RegionSize;
+      if (info.RegionSize > result.largestFreeBlock) { result.largestFreeBlock = info.RegionSize; }
+    }
+    if (info.State == MEM_COMMIT) {
+      if (info.Type == MEM_PRIVATE) { result.privateCommit += info.RegionSize; }
+      if (info.Type == MEM_MAPPED) { result.mappedCommit += info.RegionSize; }
+      if (info.Type == MEM_IMAGE) { result.imageCommit += info.RegionSize; }
+    }
+    const auto base = reinterpret_cast<uintptr_t>(info.BaseAddress);
+    if (!info.RegionSize || info.RegionSize > UINTPTR_MAX - base || base + info.RegionSize <= address) {
+      result.elapsedMs = GetTickCount64() - start;
+      return result;
+    }
+    address = base + info.RegionSize;
+  }
+  result.elapsedMs = GetTickCount64() - start;
+  result.valid = true;
+  return result;
+}
+
+struct GpuMemory {
+  uint64_t localUsage = 0;
+  uint64_t localBudget = 0;
+  uint64_t nonlocalUsage = 0;
+  uint64_t nonlocalBudget = 0;
+  HRESULT localResult = E_NOINTERFACE;
+  HRESULT nonlocalResult = E_NOINTERFACE;
+};
+
+// WDDM usage of this process, node 0. No other processes are enumerated or sampled.
+class GpuRecorder {
+  HMODULE m_module = nullptr;
+  IDXGIAdapter3* m_adapter = nullptr;
+  HRESULT m_result = E_PENDING;
+  UINT m_vendor = 0;
+  UINT m_device = 0;
+  bool m_configured = false;
+
+public:
+  GpuRecorder() = default;
+  GpuRecorder(const GpuRecorder&) = delete;
+  GpuRecorder& operator=(const GpuRecorder&) = delete;
+  ~GpuRecorder() {
+    if (m_adapter) { m_adapter->Release(); }
+    if (m_module) { FreeLibrary(m_module); }
+  }
+
+  void setAdapter(UINT vendor, UINT device) {
+    if (m_configured && m_vendor == vendor && m_device == device) { return; }
+    m_configured = true;
+    m_vendor = vendor;
+    m_device = device;
+    if (m_adapter) { m_adapter->Release(); m_adapter = nullptr; }
+    m_result = E_NOINTERFACE;
+    if (!m_module) {
+      wchar_t path[MAX_PATH] {};
+      const auto length = GetSystemDirectoryW(path, MAX_PATH);
+      constexpr wchar_t name[] = L"\\dxgi.dll";
+      if (!length || length + sizeof(name) / sizeof(wchar_t) > MAX_PATH) { return; }
+      for (size_t i = 0; i < sizeof(name) / sizeof(wchar_t); ++i) { path[length + i] = name[i]; }
+      m_module = LoadLibraryExW(path, nullptr, LOAD_LIBRARY_SEARCH_SYSTEM32);
+    }
+    if (!m_module) { return; }
+    using CreateFactory = HRESULT(WINAPI*)(REFIID, void**);
+    const auto createFactory = reinterpret_cast<CreateFactory>(GetProcAddress(m_module, "CreateDXGIFactory1"));
+    if (!createFactory) { return; }
+    IDXGIFactory1* factory = nullptr;
+    m_result = createFactory(__uuidof(IDXGIFactory1), reinterpret_cast<void**>(&factory));
+    if (FAILED(m_result)) { return; }
+    UINT matches = 0;
+    for (UINT index = 0;; ++index) {
+      IDXGIAdapter1* adapter = nullptr;
+      const auto enumResult = factory->EnumAdapters1(index, &adapter);
+      if (enumResult == DXGI_ERROR_NOT_FOUND) { break; }
+      if (FAILED(enumResult)) { m_result = enumResult; break; }
+      DXGI_ADAPTER_DESC1 desc {};
+      if (SUCCEEDED(adapter->GetDesc1(&desc)) && !(desc.Flags & DXGI_ADAPTER_FLAG_SOFTWARE) &&
+          desc.VendorId == vendor && desc.DeviceId == device) {
+        ++matches;
+        if (matches == 1) {
+          m_result = adapter->QueryInterface(__uuidof(IDXGIAdapter3), reinterpret_cast<void**>(&m_adapter));
+        }
+      }
+      adapter->Release();
+    }
+    factory->Release();
+    // Identical GPUs cannot be distinguished by vendor/device; do not guess.
+    if (matches != 1 || FAILED(m_result)) {
+      if (m_adapter) { m_adapter->Release(); m_adapter = nullptr; }
+      if (SUCCEEDED(m_result)) { m_result = DXGI_ERROR_NOT_FOUND; }
+    }
+  }
+
+  UINT vendor() const { return m_vendor; }
+  UINT device() const { return m_device; }
+  HRESULT result() const { return m_result; }
+
+  GpuMemory sample() const {
+    GpuMemory result;
+    if (!m_adapter) { return result; }
+    DXGI_QUERY_VIDEO_MEMORY_INFO local {}, nonlocal {};
+    result.localResult = m_adapter->QueryVideoMemoryInfo(0, DXGI_MEMORY_SEGMENT_GROUP_LOCAL, &local);
+    result.nonlocalResult = m_adapter->QueryVideoMemoryInfo(0, DXGI_MEMORY_SEGMENT_GROUP_NON_LOCAL, &nonlocal);
+    if (SUCCEEDED(result.localResult)) { result.localUsage = local.CurrentUsage; result.localBudget = local.Budget; }
+    if (SUCCEEDED(result.nonlocalResult)) { result.nonlocalUsage = nonlocal.CurrentUsage; result.nonlocalBudget = nonlocal.Budget; }
+    return result;
+  }
+};
+}
