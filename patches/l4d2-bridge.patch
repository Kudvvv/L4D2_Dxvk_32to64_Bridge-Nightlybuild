+#include "pch.h"
+#include "pageblock_runtime.h"
+#include "pageblock_control.h"
+
+// This ABI is independent of Source/L4N; UI plugins only submit controls and display results.
+extern "C" HRESULT WINAPI L4D2BridgePageBlockControl(const l4d2_control::Request* request, l4d2_control::Response* response) {
+  if (!request || !response || request->bytes != sizeof(*request)) { return E_INVALIDARG; }
+  const bool detailed = request->version == l4d2_control::kDetailedVersion;
+  if (!l4d2_control::compatible(*request, *response)) { return E_INVALIDARG; }
+  try {
+    auto& c = l4d2_residency::context();
+    std::lock_guard<std::recursive_mutex> guard(c.mutex);
+    l4d2_control::DetailedResponse extended;
+    auto& result = extended.base;
+    if (request->operation == l4d2_control::Operation::SetPolicy) {
+      if (request->value > 2) { return E_INVALIDARG; }
+      if (!l4d2_residency::setPolicy(static_cast<l4d2_residency::Policy>(request->value))) { return E_ACCESSDENIED; }
+    } else if (request->operation == l4d2_control::Operation::Gc) {
+      if (request->value > 2) { return E_INVALIDARG; }
+      l4d2_memory::sample(true, "pageblock-gc-before");
+      const auto gc = l4d2_residency::RunPageBlockGc(c, static_cast<l4d2_residency::PageBlockGcMode>(request->value));
+      l4d2_memory::sample(true, "pageblock-gc-after");
+      extended.skippedUnsupportedCapability = gc.pageBlocksSkippedUnsupportedCapability;
+      extended.skippedRecoveryUnavailable = gc.pageBlocksSkippedRecoveryUnavailable;
+      extended.skippedUnclassified = gc.pageBlocksSkippedUnclassified;
+      extended.skippedReferenceTest = gc.pageBlocksSkippedReferenceTest;
+      extended.skippedNoBacking = gc.pageBlocksSkippedNoBacking;
+      extended.hostAckWaitCount = gc.hostAckWaitCount; extended.hostAckWaitTimeMs = gc.hostAckWaitTimeMs;
+      result.pageBlocksScanned = gc.pageBlocksScanned; result.pageBlocksEvicted = gc.pageBlocksEvicted;
+      result.pageBlocksSkippedLocked = gc.pageBlocksSkippedLocked; result.pageBlocksSkippedTransferring = gc.pageBlocksSkippedTransferring;
+      result.pageBlocksSkippedPolicy = gc.pageBlocksSkippedPolicy; result.pageBlocksSkippedUnsynchronized = gc.pageBlocksSkippedUnsynchronized;
+      result.failures = gc.failures; result.bytesUnmapped = gc.bytesUnmapped; result.backingBytesReleased = gc.backingBytesReleased;
+      result.mappedBytesBefore = gc.mappedBytesBefore; result.mappedBytesAfter = gc.mappedBytesAfter;
+      result.transfersDrained = gc.transfersDrained; result.drainWaitCount = gc.drainWaitCount; result.drainWaitTimeMs = gc.drainWaitTimeMs;
+    } else if (request->operation != l4d2_control::Operation::Stats) { return E_INVALIDARG; }
+    result.policy = static_cast<l4d2_control::Policy>(c.policy);
+    result.flags = (c.referenceTest ? 1u : 0u) | (c.supported ? 2u : 0u);
+    for (const auto* entry : c.entries) {
+      const auto state = entry->state(); ++result.pageBlocks;
+      result.backingBytes += state.backingBytes; result.mappedBytes += state.mappedBytes;
+      result.locked += state.exposed ? 1u : 0u; result.transferring += state.transferring ? 1u : 0u;
+    }
+    result.dropEvictionCount = c.dropEvictionCount; result.dropEvictedBytes = c.dropEvictedBytes;
+    result.remapCountAfterDrop = c.remapCountAfterDrop; result.remapBytesAfterDrop = c.remapBytesAfterDrop;
+    result.reconstructionFailures = c.reconstructionFailures;
+    extended.coverage = l4d2_residency::queryCoverage(c);
+    if (request->operation == l4d2_control::Operation::Stats) { l4d2_residency::logCoverage(c, "stats"); }
+    l4d2_control::writeResponse(response, extended, detailed);
+    return S_OK;
+  } catch (...) { return E_FAIL; }
+}
