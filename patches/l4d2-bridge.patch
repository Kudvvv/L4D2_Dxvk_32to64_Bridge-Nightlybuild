+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 yeyunyyds.
+// All newly added implementation code in this fork was generated by OpenAI Codex from prompts and specifications provided by yeyunyyds.
+#pragma once
+
+#include <atomic>
+#include <d3d9.h>
+
+namespace bridge_reset {
+inline DWORD waitSlice(ULONGLONG start, DWORD budget, ULONGLONG now, DWORD requested) {
+  const auto elapsed = now - start;
+  if (elapsed >= budget) { return 0; }
+  const DWORD remaining = budget - static_cast<DWORD>(elapsed);
+  return requested && requested < remaining ? requested : remaining;
+}
+// A failed/unfinished reset has no valid Client implicit swapchain.
+class ClientState {
+public:
+  void begin() { m_ready.store(false); }
+  bool ready() const { return m_ready.load(); }
+  bool transportFailed() const { return m_transportFailed.load(); }
+  void failTransport() { m_transportFailed.store(true); m_ready.store(false); }
+  HRESULT cooperative(HRESULT backend) const {
+    if (transportFailed()) { return D3DERR_DEVICELOST; }
+    return FAILED(backend) ? backend : (ready() ? D3D_OK : D3DERR_DEVICENOTRESET);
+  }
+  template<typename Commit>
+  HRESULT complete(HRESULT result, Commit commit) {
+    if (transportFailed()) { return D3DERR_DEVICELOST; }
+    if (FAILED(result)) { return result; }
+    commit();
+    m_ready.store(true);
+    return result;
+  }
+private:
+  std::atomic<bool> m_ready { true };
+  std::atomic<bool> m_transportFailed { false };
+};
+
+// No queue read/pop is allowed unless the matching response was observed.
+template<typename Wait, typename Read, typename Consume, typename Failure>
+HRESULT receive(Wait wait, Read read, Consume consume, Failure failure) {
+  if (!wait()) { failure(); return D3DERR_DEVICELOST; }
+  const HRESULT result = read();
+  consume();
+  return result;
+}
+}
