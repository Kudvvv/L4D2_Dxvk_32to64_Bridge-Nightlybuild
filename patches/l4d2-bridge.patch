diff --git a/bridge/src/client/memory_diagnostics.h b/bridge/src/client/memory_diagnostics.h
new file mode 100644
index 0000000..f8de63c
--- /dev/null
+++ b/bridge/src/client/memory_diagnostics.h
@@ -0,0 +1,176 @@
+// SPDX-License-Identifier: MIT
+// Project-specific additions and modifications: Copyright (c) 2026 yeyunyyds.
+// All newly added implementation code in this fork was generated by OpenAI Codex from prompts and specifications provided by yeyunyyds.
+// Original upstream code and copyright notices remain attributed to their original authors.
+
+#pragma once
+
+#include <windows.h>
+#include <psapi.h>
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <cwchar>
+#include <mutex>
+#include <new>
+#include "../util/queue_wait_diagnostics.h"
+#include "../util/runtime_observation.h"
+
+namespace l4d2_memory {
+enum class Kind : unsigned { Surface, Vertex, Index };
+inline std::atomic<uint64_t> bytes[3] {};
+inline std::atomic<uint64_t> objects[3] {};
+inline std::atomic<uint64_t> surfaceBackingBytes { 0 };
+inline std::atomic<uint64_t> surfaceBackingCount { 0 };
+inline std::atomic<uint64_t> surfaceViewBudgetBytes { 0 };
+// VB/IB payload accounting is independent of surface PageBlock residency.
+inline std::atomic<uint64_t> allocatedBytes[3] {}, freedBytes[3] {}, allocationCount[3] {}, freeCount[3] {}, peakBytes[3] {};
+inline std::atomic<ULONGLONG> nextSample { 0 };
+inline std::mutex logMutex;
+
+inline HANDLE openLog() {
+  HMODULE module = nullptr;
+  if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+      GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+      reinterpret_cast<LPCWSTR>(&openLog), &module)) {
+    return INVALID_HANDLE_VALUE;
+  }
+  wchar_t path[MAX_PATH] {};
+  const auto length = GetModuleFileNameW(module, path, MAX_PATH);
+  if (!length || length >= MAX_PATH) {
+    return INVALID_HANDLE_VALUE;
+  }
+  auto separator = std::wcsrchr(path, L'\\');
+  if (!separator || (separator - path) + 1 + 22 >= MAX_PATH) {
+    return INVALID_HANDLE_VALUE;
+  }
+  constexpr wchar_t filename[] = L"l4d2-memory.log";
+  std::wmemcpy(separator + 1, filename, sizeof(filename) / sizeof(wchar_t));
+  return CreateFileW(path, GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE,
+    nullptr, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+}
+
+struct AddressSpace {
+  uint64_t committed = 0, reserved = 0, free = 0, largestFree = 0, limit = 0;
+  uint64_t privateCommitted = 0, mappedCommitted = 0, imageCommitted = 0, otherCommitted = 0;
+  uint64_t privateReserved = 0, mappedReserved = 0, imageReserved = 0, otherReserved = 0;
+  bool complete = false;
+};
+inline AddressSpace scanAddressSpace() {
+  if (!l4d2_observation::memoryMonitoring) { return {}; }
+  AddressSpace scan;
+  SYSTEM_INFO system {}; GetSystemInfo(&system);
+  scan.limit = reinterpret_cast<uintptr_t>(system.lpMaximumApplicationAddress) + uint64_t(1);
+  uint64_t address = 0;
+  while (address < scan.limit) {
+    MEMORY_BASIC_INFORMATION region {};
+    if (!VirtualQuery(reinterpret_cast<void*>(static_cast<uintptr_t>(address)), &region, sizeof(region))) { break; }
+    const uint64_t base = reinterpret_cast<uintptr_t>(region.BaseAddress), size = region.RegionSize;
+    if (!size || base + size <= address) { break; }
+    if (region.State == MEM_FREE) {
+      scan.free += size; if (size > scan.largestFree) { scan.largestFree = size; }
+    } else if (region.State == MEM_COMMIT || region.State == MEM_RESERVE) {
+      const bool committed = region.State == MEM_COMMIT;
+      (committed ? scan.committed : scan.reserved) += size;
+      switch (region.Type) {
+      case MEM_PRIVATE: (committed ? scan.privateCommitted : scan.privateReserved) += size; break;
+      case MEM_MAPPED: (committed ? scan.mappedCommitted : scan.mappedReserved) += size; break;
+      case MEM_IMAGE: (committed ? scan.imageCommitted : scan.imageReserved) += size; break;
+      default: (committed ? scan.otherCommitted : scan.otherReserved) += size; break;
+      }
+    }
+    address = base + size;
+  }
+  scan.complete = address >= scan.limit;
+  return scan;
+}
+
+// Sampling follows Present and allocations, including map loading without frames.
+// The failure path uses stack storage and Win32 I/O to avoid heap allocation.
+inline void sample(bool force = false, const char* event = "sample",
+    Kind kind = Kind::Surface, size_t requested = 0,
+    unsigned width = 0, unsigned height = 0, unsigned format = 0, DWORD error = 0) noexcept {
+  if (!l4d2_observation::memoryMonitoring) { return; }
+  try {
+  const auto now = GetTickCount64();
+  auto deadline = nextSample.load();
+  if (!force && (now < deadline || !nextSample.compare_exchange_strong(deadline, now + 5000))) {
+    return;
+  }
+  std::lock_guard<std::mutex> guard(logMutex);
+  static HANDLE log = openLog();
+  const auto scan = scanAddressSpace();
+  PROCESS_MEMORY_COUNTERS_EX counters {};
+  counters.cb = sizeof(counters);
+  using QueryMemory = BOOL(WINAPI*)(HANDLE, PPROCESS_MEMORY_COUNTERS, DWORD);
+  static auto query = reinterpret_cast<QueryMemory>(GetProcAddress(
+    GetModuleHandleW(L"kernel32.dll"), "K32GetProcessMemoryInfo"));
+  const bool countersValid = query && query(GetCurrentProcess(),
+    reinterpret_cast<PPROCESS_MEMORY_COUNTERS>(&counters), sizeof(counters));
+  FILETIME created{}, exited{}, kernel{}, user{};
+  const bool cpuValid = GetProcessTimes(GetCurrentProcess(), &created, &exited, &kernel, &user) != FALSE;
+  const uint64_t kernelTime = (static_cast<uint64_t>(kernel.dwHighDateTime) << 32) | kernel.dwLowDateTime;
+  const uint64_t userTime = (static_cast<uint64_t>(user.dwHighDateTime) << 32) | user.dwLowDateTime;
+  SYSTEMTIME time {};
+  GetLocalTime(&time);
+  char line[4096] {};
+  const auto k = static_cast<unsigned>(kind);
+  const char* names[] = { "surface", "vertex-buffer", "index-buffer" };
+  const int length = std::snprintf(line, sizeof(line),
+    "%02u:%02u:%02u.%03u pid=%lu event=%s kind=%s requested=%llu width=%u height=%u format=0x%x "
+    "surface_bytes=%llu surface_count=%llu vertex_bytes=%llu vertex_count=%llu index_bytes=%llu index_count=%llu "
+    "va_committed=%llu va_reserved=%llu va_free=%llu largest_free=%llu va_limit=%llu scan_complete=%u "
+    "private_bytes=%llu working_set=%llu counters_valid=%u surface_backing_bytes=%llu surface_backing_count=%llu "
+    "surface_view_budget_bytes=%llu win32_error=%lu schema=3 tick_ms=%llu "
+    "va_private_committed=%llu va_mapped_committed=%llu va_image_committed=%llu va_other_committed=%llu "
+    "va_private_reserved=%llu va_mapped_reserved=%llu va_image_reserved=%llu va_other_reserved=%llu "
+    "vertex_allocated_bytes=%llu vertex_freed_bytes=%llu vertex_allocations=%llu vertex_frees=%llu vertex_peak_bytes=%llu "
+    "index_allocated_bytes=%llu index_freed_bytes=%llu index_allocations=%llu index_frees=%llu index_peak_bytes=%llu "
+    "cpu_kernel_100ns=%llu cpu_user_100ns=%llu cpu_times_valid=%u",
+    time.wHour, time.wMinute, time.wSecond, time.wMilliseconds, GetCurrentProcessId(), event,
+    names[k], static_cast<unsigned long long>(requested), width, height, format,
+    bytes[0].load(), objects[0].load(), bytes[1].load(), objects[1].load(), bytes[2].load(), objects[2].load(),
+    scan.committed, scan.reserved, scan.free, scan.largestFree, scan.limit, static_cast<unsigned>(scan.complete),
+    static_cast<uint64_t>(counters.PrivateUsage), static_cast<uint64_t>(counters.WorkingSetSize),
+    static_cast<unsigned>(countersValid), surfaceBackingBytes.load(), surfaceBackingCount.load(),
+    surfaceViewBudgetBytes.load(), error, static_cast<unsigned long long>(now),
+    scan.privateCommitted, scan.mappedCommitted, scan.imageCommitted, scan.otherCommitted,
+    scan.privateReserved, scan.mappedReserved, scan.imageReserved, scan.otherReserved,
+    allocatedBytes[1].load(), freedBytes[1].load(), allocationCount[1].load(), freeCount[1].load(), peakBytes[1].load(),
+    allocatedBytes[2].load(), freedBytes[2].load(), allocationCount[2].load(), freeCount[2].load(), peakBytes[2].load(),
+    static_cast<unsigned long long>(kernelTime), static_cast<unsigned long long>(userTime),
+    static_cast<unsigned>(cpuValid));
+  if (length > 0 && static_cast<size_t>(length) < sizeof(line)) {
+    const int extra = l4d2_queue::format(line + length, sizeof(line) - length);
+    if (extra <= 0 || static_cast<size_t>(extra) >= sizeof(line) - length) { return; }
+    if (log != INVALID_HANDLE_VALUE) {
+      DWORD written = 0;
+      WriteFile(log, line, static_cast<DWORD>(length + extra), &written, nullptr);
+      if (force) { FlushFileBuffers(log); }
+    } else {
+      OutputDebugStringA(line);
+    }
+  }
+  } catch (...) { /* Observation failure cannot replace an allocation result. */ }
+}
+
+inline void allocated(size_t size, Kind kind) {
+  if (!l4d2_observation::memoryMonitoring) { return; }
+  const auto k = static_cast<unsigned>(kind);
+  bytes[k].fetch_add(size);
+  objects[k].fetch_add(1);
+  if (kind != Kind::Surface) {
+    allocatedBytes[k].fetch_add(size); allocationCount[k].fetch_add(1);
+    const auto current = bytes[k].load(); auto peak = peakBytes[k].load();
+    while (current > peak && !peakBytes[k].compare_exchange_weak(peak, current)) {}
+  }
+}
+
+inline void released(size_t size, Kind kind) {
+  if (!l4d2_observation::memoryMonitoring) { return; }
+  const auto k = static_cast<unsigned>(kind);
+  bytes[k].fetch_sub(size);
+  objects[k].fetch_sub(1);
+  if (kind != Kind::Surface) { freedBytes[k].fetch_add(size); freeCount[k].fetch_add(1); }
+}
+}
