+using l4d2_readback::Digest;
+using l4d2_readback::Hasher;
+using l4d2_readback::digestText;
+using l4d2_readback::hashBytes;
+
+inline uint64_t timestamp() {
+  FILETIME now {}; GetSystemTimeAsFileTime(&now);
+  return (static_cast<uint64_t>(now.dwHighDateTime) << 32) | now.dwLowDateTime;
+}
+struct DbRecord {
+  std::string strong, content, reason;
+  uint64_t firstMiss = 0, lastSeen = 0, misses = 0;
+};
+enum class Match { None, Strong, Content };
+
+// Append-only, checksummed KEEP journal. No downgrade, compaction or deletion path exists.
+class Database {
+  HANDLE m_file = INVALID_HANDLE_VALUE;
+  bool m_valid = false;
+  std::unordered_map<std::string, DbRecord> m_strong;
+  std::unordered_map<std::string, std::string> m_content;
+  static constexpr const char* kHeader = "L4D2_RETENTION_SHA256_V1\n";
+
+  bool lock() {
+    OVERLAPPED overlap {};
+    for (uint32_t attempt = 0; attempt < 200; ++attempt) {
+      if (LockFileEx(m_file, LOCKFILE_EXCLUSIVE_LOCK | LOCKFILE_FAIL_IMMEDIATELY, 0, MAXDWORD, MAXDWORD, &overlap)) { return true; }
+      if (GetLastError() != ERROR_LOCK_VIOLATION) { return false; }
+      Sleep(10);
+    }
+    return false;
+  }
+  void unlock() { OVERLAPPED overlap {}; UnlockFileEx(m_file, 0, MAXDWORD, MAXDWORD, &overlap); }
+  static bool keyValid(const std::string& key) {
+    return key.size() == 64 && key.find_first_not_of("0123456789abcdef") == std::string::npos;
+  }
+  static bool number(const std::string& text, uint64_t& value) {
+    if (text.empty() || text.find_first_not_of("0123456789") != std::string::npos) { return false; }
+    try { size_t count = 0; value = std::stoull(text, &count); return count == text.size(); }
+    catch (...) { return false; }
+  }
+  void merge(DbRecord record) {
