+    return WriteFile(m_file, line.data(), static_cast<DWORD>(line.size()), &written, nullptr)
+      && written == line.size() && FlushFileBuffers(m_file);
+  }
+public:
+  Database() = default;
+  Database(const Database&) = delete;
+  Database& operator=(const Database&) = delete;
+  ~Database() { if (m_file != INVALID_HANDLE_VALUE) { CloseHandle(m_file); } }
+  bool open(const std::wstring& path) {
+    if (m_file != INVALID_HANDLE_VALUE) { return false; }
+    m_file = CreateFileW(path.c_str(), GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE,
+      nullptr, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
