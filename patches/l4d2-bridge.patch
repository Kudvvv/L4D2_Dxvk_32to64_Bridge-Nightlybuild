+  }
+public:
+  Parent(Context& context, uint32_t id, uint32_t width, uint32_t height, uint32_t levels, uint32_t format, uint32_t usage, uint32_t pool, std::string site, bool identitySupported)
+    : m_context(context), m_id(id), m_site(std::move(site)) {
