@@ -0,0 +1,68 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 yeyunyyds.
+// All newly added implementation code in this fork was generated by OpenAI Codex from prompts and specifications provided by yeyunyyds.
+#pragma once
+
+#include <algorithm>
+#include <d3d9.h>
+#include "shadow_lifetime.h"
+#include "../util/pageblock_control.h"
+#include "../util/readback_layout.h"
+
+namespace l4d2_residency {
+enum class LearnedDecision { Unclassified, Keep, Evictable };
+enum class ReclaimPolicy { Learned, Aggressive };
+enum class Execution { Normal, ForceDrain };
+enum class Reason {
+  Reclaimable, NoBacking, UnsupportedCapability, RecoveryUnavailable,
+  Locked, Transferring, Unsynchronized, ReferenceTest, LearnedKeep, Unclassified, Failure
+};
+inline const char* reasonName(Reason reason) {
+  switch (reason) {
+  case Reason::Reclaimable: return "reclaimable";
+  case Reason::NoBacking: return "no-backing";
+  case Reason::UnsupportedCapability: return "unsupported-capability";
+  case Reason::RecoveryUnavailable: return "recovery-unavailable";
+  case Reason::Locked: return "unsafe-locked";
+  case Reason::Transferring: return "unsafe-transferring";
+  case Reason::Unsynchronized: return "unsafe-unsynchronized";
+  case Reason::ReferenceTest: return "reference-test-active";
+  case Reason::LearnedKeep: return "learned-keep";
+  case Reason::Unclassified: return "learned-unclassified";
+  case Reason::Failure: return "failure";
+  }
+  return "unknown";
+}
+inline l4d2_control::Category category(l4d2_shadow::Type type, const D3DSURFACE_DESC& desc) {
+  using l4d2_control::Category;
+  if (desc.Format == static_cast<D3DFORMAT>(0x31495441u) || desc.Format == static_cast<D3DFORMAT>(0x32495441u)) { return Category::SpecialCompressed; }
+  if (type == l4d2_shadow::Type::BackBuffer) { return Category::BackBuffer; }
+  if (desc.Usage & D3DUSAGE_DEPTHSTENCIL) { return Category::DepthStencil; }
+  if (desc.Usage & D3DUSAGE_RENDERTARGET) { return Category::RenderTarget; }
+  if (type == l4d2_shadow::Type::Texture2DLevel) { return Category::Texture2D; }
+  if (type == l4d2_shadow::Type::CubeFaceLevel) { return Category::CubeFace; }
+  if (desc.Pool == D3DPOOL_SYSTEMMEM || desc.Pool == D3DPOOL_SCRATCH) { return Category::Offscreen; }
+  return Category::IndependentSurface;
+}
+inline D3DSURFACE_DESC offscreenDescriptor(uint32_t width, uint32_t height, D3DFORMAT format, D3DPOOL pool, DWORD usage = 0) {
+  return { format, D3DRTYPE_SURFACE, usage, pool, D3DMULTISAMPLE_NONE, 0, width, height };
+}
+inline Reason recoveryCapability(const D3DSURFACE_DESC& desc, l4d2_shadow::Type type, uint64_t backingSize, bool backendSupported) {
+  if (!backendSupported || type == l4d2_shadow::Type::BackBuffer || desc.Usage
+    || desc.MultiSampleType != D3DMULTISAMPLE_NONE || desc.Pool == D3DPOOL_DEFAULT
+    || static_cast<uint32_t>(desc.Pool) > D3DPOOL_SCRATCH) { return Reason::UnsupportedCapability; }
+  l4d2_readback::Layout layout;
+  uint32_t pitch = 0; uint64_t expected = 0;
+  if (!l4d2_readback::residencyBackingLayout(desc.Width, desc.Height,
+    static_cast<uint32_t>(desc.Format), layout, pitch, expected)
+    || (backingSize && backingSize != expected)) { return Reason::RecoveryUnavailable; }
+  return Reason::Reclaimable;
+}
+// Persistent identity remains deliberately narrower than current-content recovery.
+inline bool learnedIdentitySupported(uint32_t width, uint32_t height, uint32_t levels, uint32_t format, uint32_t usage, uint32_t pool) {
+  l4d2_readback::Layout layout;
+  return levels && levels <= 15 && pool == D3DPOOL_MANAGED && !usage
+    && (format == l4d2_readback::kDxt1 || format == l4d2_readback::kDxt5 || format == 21 || format == 22)
+    && l4d2_readback::layout(width, height, format, layout);
+}
+}
