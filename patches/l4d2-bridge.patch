+    if (match != Match::None) {
+      if (match == Match::Strong) { if (m_context.log) { ++m_context.strongHits; } } else { if (m_context.log) { ++m_context.contentHits; } }
+      if (m_context.log) { m_context.write("PB_POLICY event=db-hit parent_id=%u strong_key=%s content_key=%s match=%s policy=KEEP",
+        m_id, m_strong.c_str(), m_content.c_str(), match == Match::Strong ? "strong" : "content"); }
