+// All newly added implementation code in this fork was generated by OpenAI Codex from prompts and specifications provided by yeyunyyds.
+#pragma once
+
+#include <algorithm>
+#include <atomic>
+#include <cstdarg>
+#include <cstdio>
+#include <mutex>
+#include "config/config.h"
+#include "pagefile_shadow.h"
+#include "readback_transport.h"
+#include "util_devicecommand.h"
+
+namespace l4d2_readback {
+struct Context {
+  std::atomic<bool> enabled { false };
+  uint32_t maximum = 20, repeats = 3;
+  Selection selection;
+  std::mutex mutex;
+  HANDLE log = INVALID_HANDLE_VALUE;
+  uint64_t sequence = 0, attempts = 0, recovered = 0, matches = 0, failures = 0, mismatches = 0;
+  Context() {
+    try {
+      enabled = bridge_util::Config::getOption<bool>("client.testReadbackRecovery", false);
+      if (enabled) {
+        maximum = (std::min)(20u, bridge_util::Config::getOption<uint32_t>("client.testReadbackMaxResources", 20));
+        repeats = (std::max)(1u, (std::min)(8u, bridge_util::Config::getOption<uint32_t>("client.testReadbackRepeats", 3)));
+      }
+    } catch (...) { enabled = false; }
+  }
+  ~Context() { if (log != INVALID_HANDLE_VALUE) { CloseHandle(log); } }
+};
+inline Context& context() { static Context instance; return instance; }
+inline bool enabled() { return context().enabled; }
+
+inline void write(const char* format, ...) {
+  auto& c = context();
+  if (c.log == INVALID_HANDLE_VALUE) {
+    wchar_t path[MAX_PATH] {}; HMODULE module = nullptr;
+    if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+        reinterpret_cast<LPCWSTR>(&context), &module) || !GetModuleFileNameW(module, path, MAX_PATH)) { return; }
+    auto slash = std::wcsrchr(path, L'\\');
+    if (!slash) { return; }
+    *(slash + 1) = 0;
+    if (wcscat_s(path, L"l4d2-readback.log") != 0) { return; }
+    c.log = CreateFileW(path, GENERIC_WRITE, FILE_SHARE_READ, nullptr, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (c.log == INVALID_HANDLE_VALUE) { return; }
+  }
+  char line[2048] {}; SYSTEMTIME now {}; GetLocalTime(&now);
+  const int prefix = sprintf_s(line, "%02u:%02u:%02u.%03u pid=%lu ", now.wHour, now.wMinute, now.wSecond,
+    now.wMilliseconds, GetCurrentProcessId());
+  if (prefix < 0) { return; }
+  va_list args; va_start(args, format);
+  const int count = vsnprintf_s(line + prefix, sizeof(line) - static_cast<size_t>(prefix), _TRUNCATE, format, args);
+  va_end(args);
+  if (count < 0) { return; }
+  const size_t length = static_cast<size_t>(prefix + count);
+  line[length] = '\n'; DWORD written = 0;
+  WriteFile(c.log, line, static_cast<DWORD>(length + 1), &written, nullptr);
+}
+
+inline void failure(uint32_t id, uint32_t repeat, const char* stage, HRESULT hr, const char* reason) {
+  ++context().failures;
+  write("PB_READBACK_TEST event=result resource_id=%u repeat=%u success=0 stage=%s hresult=0x%08lx reason=%s original_retained=1",
+    id, repeat, stage, static_cast<unsigned long>(hr), reason);
+}
+
+inline void test(uint32_t id, uint32_t parent, const D3DSURFACE_DESC& desc, const PagefileShadow& original) {
+  auto& c = context();
+  if (!c.enabled || !parent || desc.Pool != D3DPOOL_MANAGED || desc.Usage || desc.MultiSampleType != D3DMULTISAMPLE_NONE) { return; }
+  Layout l;
+  if (!layout(desc.Width, desc.Height, static_cast<uint32_t>(desc.Format), l)) { return; }
+  std::lock_guard<std::mutex> guard(c.mutex);
+  if (!c.selection.take(static_cast<uint32_t>(desc.Format), desc.Width, desc.Height, c.maximum)) { return; }
+  if (!c.attempts) {
+    write("PB_READBACK_TEST event=config enabled=1 phase=retained-reference max_resources=%u repeats=%u "
+      "max_bytes=%u selection=first-per-format-size source=server-d3d9-readonly aggressive_eviction=0 real_miss=0", c.maximum, c.repeats, kMaxBytes);
+  }
+  for (uint32_t repeat = 1; repeat <= c.repeats; ++repeat) {
+    ++c.attempts;
+    Request request;
+    request.resourceId = id; request.parentId = parent;
+    request.width = desc.Width; request.height = desc.Height; request.format = static_cast<uint32_t>(desc.Format);
+    request.bytes = l.bytes;
+    LARGE_INTEGER nonce {}; QueryPerformanceCounter(&nonce);
+    swprintf_s(request.name, L"Local\\L4D2Recovery-%lu-%llu-%llu", GetCurrentProcessId(),
+      static_cast<unsigned long long>(++c.sequence), static_cast<unsigned long long>(nonce.QuadPart));
+    write("PB_READBACK_TEST event=start resource_id=%u parent_id=%u width=%u height=%u format=0x%x mip=0 pool=1 usage=0 "
+      "backing_bytes=%u logical_row_bytes=%u block_rows=%u block_width=%u block_height=%u block_bytes=%u repeat=%u source=server-d3d9-readonly original_retained=1",
+      id, parent, desc.Width, desc.Height, request.format, l.bytes, l.rowBytes, l.rows, l.blockWidth, l.blockHeight, l.blockBytes, repeat);
+    Temporary recovered;
+    HRESULT hr = recovered.create(request);
+    if (FAILED(hr)) { failure(id, repeat, "temporary-backing", hr, "section-or-event-creation-failed"); continue; }
+    LARGE_INTEGER begin {}, end {}; QueryPerformanceCounter(&begin);
+    {
+      ClientMessage command(Commands::Bridge_TestReadbackRecovery, id);
+      command.send_data(static_cast<uint32_t>(sizeof(request)), &request);
+    }
+    const DWORD wait = recovered.wait(20000);
+    QueryPerformanceCounter(&end);
+    const auto elapsed = microseconds(begin, end);
+    if (wait != WAIT_OBJECT_0) {
+      failure(id, repeat, "server-completion", HRESULT_FROM_WIN32(wait == WAIT_TIMEOUT ? ERROR_TIMEOUT : GetLastError()), "completion-not-signalled");
+      // A late completion uses only this temporary section, never the normal response queue.
+      c.enabled = false;
+      break;
+    }
+    const Response response = recovered.response();
+    write("PB_READBACK_TEST event=sync resource_id=%u repeat=%u stage=%s hresult=0x%08lx readback_us=%llu "
+      "sync_us=%llu queue_flush_requested=%u event_query_wait=%u query_polls=%u device_idle=%u backend_internal_wait=unobservable",
+      id, repeat, stageName(response.stage), static_cast<unsigned long>(response.hresult), static_cast<unsigned long long>(elapsed),
+      static_cast<unsigned long long>(response.syncUs), response.flushRequested, response.eventWait, response.queryPolls, response.deviceIdle);
+    if (response.version != kVersion || response.stage != Stage::Complete || FAILED(response.hresult)) {
+      failure(id, repeat, stageName(response.stage), response.hresult, "backend-recovery-failed"); continue;
+    }
+    if (response.bytes != l.bytes || response.width != desc.Width || response.height != desc.Height
+      || response.format != request.format || response.mip != 0 || response.rowBytes != l.rowBytes || response.rows != l.rows
+      || response.blockWidth != l.blockWidth || response.blockHeight != l.blockHeight || response.blockBytes != l.blockBytes) {
+      failure(id, repeat, "response-layout", E_INVALIDARG, "returned-layout-does-not-match"); continue;
+    }
+    ++c.recovered;
+    // This is the first access to original bytes in the experiment.
+    Comparison difference;
+    LARGE_INTEGER compareBegin {}, compareEnd {}; QueryPerformanceCounter(&compareBegin);
+    hr = original.compareRecovered(recovered.data(), response.bytes, difference);
+    QueryPerformanceCounter(&compareEnd);
+    if (FAILED(hr)) { failure(id, repeat, "reference-comparison", hr, "reference-could-not-be-mapped"); continue; }
+    if (!difference.mismatchBytes) { ++c.matches; } else { ++c.mismatches; }
+    recovered.discard();
+    write("PB_READBACK_TEST event=result resource_id=%u parent_id=%u repeat=%u success=1 bytes=%u exact_match=%u "
+      "mismatch_bytes=%llu first_mismatch_offset=%lld readback_us=%llu backend_read_us=%llu sync_us=%llu compare_us=%llu "
+      "backend_pitch=%u logical_row_bytes=%u block_rows=%u queue_flush_requested=%u event_query_wait=%u query_polls=%u "
+      "device_idle=%u backend_internal_wait=unobservable source=server-d3d9-readonly original_retained=1 recovered_discarded=1",
+      id, parent, repeat, response.bytes, difference.mismatchBytes ? 0u : 1u,
+      static_cast<unsigned long long>(difference.mismatchBytes), static_cast<long long>(difference.firstOffset),
+      static_cast<unsigned long long>(elapsed), static_cast<unsigned long long>(response.backendReadUs),
+      static_cast<unsigned long long>(response.syncUs), static_cast<unsigned long long>(microseconds(compareBegin, compareEnd)),
+      response.backendPitch, response.rowBytes, response.rows, response.flushRequested, response.eventWait, response.queryPolls, response.deviceIdle);
+    if (difference.mismatchBytes) {
+      write("PB_READBACK_TEST event=mismatch resource_id=%u repeat=%u mismatch_bytes=%llu first_mismatch_offset=%lld expected=0x%02x actual=0x%02x",
+        id, repeat, static_cast<unsigned long long>(difference.mismatchBytes), static_cast<long long>(difference.firstOffset), difference.expected, difference.actual);
+    }
+  }
+  if (c.log != INVALID_HANDLE_VALUE) { FlushFileBuffers(c.log); }
+}
+
+inline void summary() {
+  auto& c = context();
+  std::unique_lock<std::mutex> guard(c.mutex, std::try_to_lock);
+  if (!guard.owns_lock() || (!c.enabled && !c.attempts)) { return; }
+  write("PB_READBACK_TEST event=summary resources=%u attempts=%llu recovered=%llu exact_matches=%llu mismatches=%llu failures=%llu "
+    "phase=retained-reference original_retained=1 real_miss=0",
+    c.selection.count(), static_cast<unsigned long long>(c.attempts), static_cast<unsigned long long>(c.recovered),
+    static_cast<unsigned long long>(c.matches), static_cast<unsigned long long>(c.mismatches), static_cast<unsigned long long>(c.failures));
+  if (c.log != INVALID_HANDLE_VALUE) { FlushFileBuffers(c.log); }
+}
+}
