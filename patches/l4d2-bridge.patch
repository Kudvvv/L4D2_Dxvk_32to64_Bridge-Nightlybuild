+    trigger, c.tracked, c.capable, c.nonReclaimable, c.safeNow, c.learnedKeep, c.learnedEvictable, c.learnedUnclassified, c.unsupportedCapability, c.recoveryUnavailable);
+  for (uint32_t category = 0; category < l4d2_control::kCategoryCount; ++category) {
+    const auto& group = c.categories[category];
+    context.write("PB_COVERAGE_CATEGORY trigger=%s category=%s tracked=%llu reclaim_capable=%llu safe_now=%llu mapped_bytes=%llu backing_bytes=%llu",
+      trigger, l4d2_control::categoryName(static_cast<l4d2_control::Category>(category)), group.tracked, group.capable, group.safeNow, group.mappedBytes, group.backingBytes);
+  }
+}
+inline void recordSkip(PageBlockGcResult& result, Reason reason) {
+  switch (reason) {
+  case Reason::NoBacking: ++result.pageBlocksSkippedNoBacking; break;
+  case Reason::UnsupportedCapability: ++result.pageBlocksSkippedUnsupportedCapability; break;
+  case Reason::RecoveryUnavailable: ++result.pageBlocksSkippedRecoveryUnavailable; break;
+  case Reason::Locked: ++result.pageBlocksSkippedLocked; break;
+  case Reason::Transferring: ++result.pageBlocksSkippedTransferring; break;
+  case Reason::Unsynchronized: ++result.pageBlocksSkippedUnsynchronized; break;
+  case Reason::ReferenceTest: ++result.pageBlocksSkippedReferenceTest; break;
+  case Reason::LearnedKeep: ++result.pageBlocksSkippedPolicy; break;
+  case Reason::Unclassified: ++result.pageBlocksSkippedUnclassified; break;
+  case Reason::Failure: ++result.failures; break;
+  case Reason::Reclaimable: break;
+  }
+}
+inline PageBlockGcResult RunPageBlockGc(Context& context, PageBlockGcMode mode) {
+  PageBlockGcResult result;
+  std::lock_guard<std::recursive_mutex> guard(context.mutex);
+  const auto policy = mode == PageBlockGcMode::Learned ? ReclaimPolicy::Learned : ReclaimPolicy::Aggressive;
+  const auto execution = mode == PageBlockGcMode::Force ? Execution::ForceDrain : Execution::Normal;
+  for (const auto* entry : context.entries) { result.mappedBytesBefore += entry->state().mappedBytes; }
+  for (auto* entry : context.entries) {
+    ++result.pageBlocksScanned;
+    recordSkip(result, entry->reclaim(policy, execution, false, &result));
+  }
+  for (const auto* entry : context.entries) { result.mappedBytesAfter += entry->state().mappedBytes; }
+  context.report("PB_GC mode=%s policy=%s execution=%s pageBlocksScanned=%llu pageBlocksEvicted=%llu pageBlocksSkippedLocked=%llu pageBlocksSkippedTransferring=%llu pageBlocksSkippedPolicy=%llu pageBlocksSkippedUnsynchronized=%llu pageBlocksSkippedUnsupportedCapability=%llu pageBlocksSkippedRecoveryUnavailable=%llu pageBlocksSkippedUnclassified=%llu pageBlocksSkippedReferenceTest=%llu pageBlocksSkippedNoBacking=%llu failures=%llu bytesUnmapped=%llu backingBytesReleased=%llu mappedBytesBefore=%llu mappedBytesAfter=%llu transfersDrained=%llu drainWaitCount=%llu drainWaitTimeMs=%.3f hostAckWaitCount=%llu hostAckWaitTimeMs=%.3f",
+    modeName(mode), policy == ReclaimPolicy::Learned ? "learned" : "aggressive", execution == Execution::ForceDrain ? "force-drain" : "normal",
+    result.pageBlocksScanned, result.pageBlocksEvicted, result.pageBlocksSkippedLocked, result.pageBlocksSkippedTransferring,
+    result.pageBlocksSkippedPolicy, result.pageBlocksSkippedUnsynchronized, result.pageBlocksSkippedUnsupportedCapability,
+    result.pageBlocksSkippedRecoveryUnavailable, result.pageBlocksSkippedUnclassified, result.pageBlocksSkippedReferenceTest,
+    result.pageBlocksSkippedNoBacking, result.failures, result.bytesUnmapped, result.backingBytesReleased,
+    result.mappedBytesBefore, result.mappedBytesAfter, result.transfersDrained, result.drainWaitCount, result.drainWaitTimeMs,
+    result.hostAckWaitCount, result.hostAckWaitTimeMs);
+  if (context.diagnostics) { logCoverage(context, "gc-result"); }
+  return result;
+}
+inline void summary(Context& c) {
+  std::lock_guard<std::recursive_mutex> guard(c.mutex);
+  if (c.diagnostics) { logCoverage(c, "summary"); }
+  c.write("PB_DROP_SUMMARY dropEvictionCount=%llu dropEvictedBytes=%llu remapCountAfterDrop=%llu remapBytesAfterDrop=%llu reconstructionFailures=%llu",
+    static_cast<unsigned long long>(c.dropEvictionCount), static_cast<unsigned long long>(c.dropEvictedBytes),
+    static_cast<unsigned long long>(c.remapCountAfterDrop), static_cast<unsigned long long>(c.remapBytesAfterDrop),
+    static_cast<unsigned long long>(c.reconstructionFailures));
+}
+}
diff --git a/bridge/src/client/pageblock_runtime.h b/bridge/src/client/pageblock_runtime.h
new file mode 100644
index 0000000..c42e355
--- /dev/null
+++ b/bridge/src/client/pageblock_runtime.h
@@ -0,0 +1,85 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 yeyunyyds.
+// All newly added implementation code in this fork was generated by OpenAI Codex from prompts and specifications provided by yeyunyyds.
+#pragma once
+
+#include "pageblock_residency.h"
+#include "retention_runtime.h"
+
+namespace l4d2_residency {
+struct Runtime {
+  Context context;
+  HANDLE file = INVALID_HANDLE_VALUE;
+  void write(const char* message) {
+    if (file == INVALID_HANDLE_VALUE) {
+      const auto directory = l4d2_retention::clientDirectory();
+      if (!directory.empty()) {
+        file = CreateFileW((directory / L"l4d2-pageblock-gc.log").c_str(), GENERIC_WRITE, FILE_SHARE_READ,
+          nullptr, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+      }
+    }
+    if (file == INVALID_HANDLE_VALUE) { throw ERROR_OPEN_FAILED; }
+    char line[2400] {}; SYSTEMTIME now {}; GetLocalTime(&now);
+    const int count = sprintf_s(line, "%02u:%02u:%02u.%03u pid=%lu %s\n", now.wHour, now.wMinute,
+      now.wSecond, now.wMilliseconds, GetCurrentProcessId(), message);
+    if (count > 0) {
+      DWORD written = 0;
+      if (!WriteFile(file, line, static_cast<DWORD>(count), &written, nullptr) || written != static_cast<DWORD>(count)) {
+        CloseHandle(file); file = INVALID_HANDLE_VALUE; throw ERROR_WRITE_FAULT;
+      }
+    }
+  }
+  Runtime() {
+    const auto name = bridge_util::Config::getOption<std::string>("client.pageBlockRetentionPolicy", "keep");
+    if (!parsePolicy(name, context.policy)) {
+      bridge_util::Logger::warn("PB_RESIDENCY unknown policy; using keep");
+    }
+    context.diagnostics = bridge_util::Config::getOption<bool>("client.pageBlockDiagnostics", false);
+    context.referenceTest = bridge_util::Config::getOption<bool>("client.testReadbackRecovery", false);
+    context.supported = !bridge_util::Config::getOption<bool>("useSharedHeap", false)
+      && bridge_util::Config::getOption<bool>("server.useVanillaDxvk", true);
+    if (context.diagnostics) {
+      try { context.log = [this](const char* message) { write(message); }; }
+      catch (...) { context.diagnostics = false; }
+    }
+    context.userLog = [](const char* message) { bridge_util::Logger::info(message); };
+    context.error = [](const char* message) { bridge_util::Logger::err(message); };
+    context.exchange = [](const l4d2_readback::Request& r, l4d2_readback::Temporary& temporary,
+        l4d2_readback::Response& response, uint64_t& elapsed) -> HRESULT {
+      HRESULT hr = temporary.create(r);
+      if (FAILED(hr)) { return hr; }
+      LARGE_INTEGER begin {}, end {};
+      if (l4d2_observation::recoveryTiming) { QueryPerformanceCounter(&begin); }
+      { ClientMessage command(Commands::Bridge_TestReadbackRecovery, r.resourceId); command.send_data(static_cast<uint32_t>(sizeof(r)), &r); }
+      const auto wait = temporary.wait(20000);
+      elapsed = 0;
+      if (l4d2_observation::recoveryTiming) { QueryPerformanceCounter(&end); elapsed = l4d2_readback::microseconds(begin, end); }
+      if (wait != WAIT_OBJECT_0) { return HRESULT_FROM_WIN32(wait == WAIT_TIMEOUT ? ERROR_TIMEOUT : GetLastError()); }
+      response = temporary.response(); return response.hresult;
+    };
+    if (context.policy == Policy::Drop) {
+      context.report("PB_RESIDENCY event=config policy=drop experimental=1 reference_test=%u supported=%u", context.referenceTest ? 1u : 0u, context.supported ? 1u : 0u);
+      bridge_util::Logger::info("PB_RESIDENCY policy=drop experimental=1 host_ack_before_eviction=1");
+    }
+  }
+};
+inline Runtime& runtime() { static auto* instance = new Runtime(); return *instance; }
+inline Context& context() { return runtime().context; }
+inline bool setPolicy(Policy policy) {
+  auto& c = context(); std::lock_guard<std::recursive_mutex> guard(c.mutex);
+  if (c.referenceTest || !c.supported) { return false; }
+  l4d2_retention::runtime().setEnabled(policy == Policy::LearnedAggressive);
+  c.policy = policy;
+  c.report("PB_RESIDENCY event=policy-changed policy=%s persistent_config_changed=0",
+    policy == Policy::Drop ? "drop" : policy == Policy::LearnedAggressive ? "learned-aggressive" : "keep");
+  return true;
+}
+inline PageBlockGcResult RunPageBlockGc(PageBlockGcMode mode) { return RunPageBlockGc(context(), mode); }
+inline void summary() {
+  auto& r = runtime();
+  if (!r.context.diagnostics) { return; }
+  std::lock_guard<std::recursive_mutex> guard(r.context.mutex);
+  summary(r.context);
+  if (r.file != INVALID_HANDLE_VALUE) { FlushFileBuffers(r.file); }
+}
+}
diff --git a/bridge/src/client/pagefile_shadow.h b/bridge/src/client/pagefile_shadow.h
new file mode 100644
index 0000000..36f5efd
--- /dev/null
+++ b/bridge/src/client/pagefile_shadow.h
@@ -0,0 +1,278 @@
+// SPDX-License-Identifier: MIT
+// Project-specific additions and modifications: Copyright (c) 2026 yeyunyyds.
+// All newly added implementation code in this fork was generated by OpenAI Codex from prompts and specifications provided by yeyunyyds.
+// Original upstream code and copyright notices remain attributed to their original authors.
+
+#pragma once
+
+#include "memory_diagnostics.h"
+#include "pageblock_diagnostics.h"
+#include "../util/readback_layout.h"
+#include "../util/readback_hash.h"
+#include <memory>
+
+// A section keeps CPU-written bytes while unlocked views leave the x86 VA.
+// The budget applies to mapped views; active locks are always pinned.
+class PagefileShadow {
+  HANDLE m_section = nullptr;
+  uint8_t* m_view = nullptr;
+  size_t m_size = 0;
+  size_t m_viewCost = 0, m_mappedVaBytes = 0;
+  unsigned m_locks = 0, m_transfers = 0;
+  bool m_listed = false;
+  // NV-DXVK start: Only the explicitly enabled real-miss experiment sets this state.
+  bool m_recoveryMissing = false;
+  // NV-DXVK end
+  PagefileShadow* m_prev = nullptr;
+  PagefileShadow* m_next = nullptr;
+  inline static PagefileShadow* s_head = nullptr;
+  inline static PagefileShadow* s_tail = nullptr;
+  inline static size_t s_mappedBytes = 0;
+  inline static std::atomic<uint64_t> s_peakBackingBytes { 0 };
+  inline static std::mutex s_mutex;
+  std::unique_ptr<l4d2_shadow::Record> m_diagnostics;
+
+  void unlink() {
+    if (!m_listed) { return; }
+    if (m_prev) { m_prev->m_next = m_next; } else { s_head = m_next; }
+    if (m_next) { m_next->m_prev = m_prev; } else { s_tail = m_prev; }
+    m_prev = m_next = nullptr;
+    m_listed = false;
+  }
+
+  void unmap() {
+    unlink();
+    if (m_view && UnmapViewOfFile(m_view)) {
+      s_mappedBytes -= m_viewCost;
+      if (l4d2_observation::memoryMonitoring) { l4d2_memory::surfaceViewBudgetBytes.fetch_sub(m_viewCost); }
+      l4d2_memory::released(m_size, l4d2_memory::Kind::Surface);
+      m_view = nullptr;
+    }
+  }
+
+  static void trim(size_t budget) {
+    while (s_mappedBytes > budget && s_tail) {
+      auto victim = s_tail;
+      if (victim->m_transfers) { break; }
+      victim->unmap();
+      if (victim->m_view) { break; }
+    }
+  }
+
+  static void noteBackingPeak() {
+    if (!l4d2_observation::memoryMonitoring) { return; }
+    const uint64_t bytes = l4d2_memory::surfaceBackingBytes.load();
+    auto peak = s_peakBackingBytes.load();
+    while (bytes > peak && !s_peakBackingBytes.compare_exchange_weak(peak, bytes)) {}
+  }
+
+public:
+  PagefileShadow() = default;
+  PagefileShadow(const PagefileShadow&) = delete;
+  PagefileShadow& operator=(const PagefileShadow&) = delete;
+
+  ~PagefileShadow() {
+    std::lock_guard<std::mutex> guard(s_mutex);
+    unmap();
+    if (m_section) {
+      CloseHandle(m_section);
+      if (l4d2_observation::memoryMonitoring) { l4d2_memory::surfaceBackingBytes.fetch_sub(m_size); }
+      if (l4d2_observation::memoryMonitoring) { l4d2_memory::surfaceBackingCount.fetch_sub(1); }
+    }
+    l4d2_pageblock::destroyed(m_diagnostics.get());
+    if (m_diagnostics) { --l4d2_pageblock::context.metadataRecords; }
+  }
+
+  void configureDiagnostics(const l4d2_shadow::Metadata& meta, bool enabled, bool detailed = false) {
+    if (!enabled || m_diagnostics || m_section) { return; }
+    l4d2_pageblock::start(detailed);
+    m_diagnostics.reset(new (std::nothrow) l4d2_shadow::Record());
+    if (!m_diagnostics) { ++l4d2_pageblock::context.dropped; return; }
+    ++l4d2_pageblock::context.metadataRecords;
+    m_diagnostics->meta = meta;
+  }
+
+  void describeParent(uint64_t parentId, l4d2_shadow::Type type, uint32_t mip, uint32_t face) {
+    if (m_diagnostics && !m_diagnostics->registered) {
+      m_diagnostics->meta.parentId = parentId;
+      m_diagnostics->meta.type = type;
+      m_diagnostics->meta.mip = mip;
+      m_diagnostics->meta.face = face;
+    }
+  }
+
+  void observeLock(uint32_t flags, bool full) { l4d2_pageblock::locked(m_diagnostics.get(), flags, full); }
+  void observeUnlock(uint32_t flags) { l4d2_pageblock::unlocked(m_diagnostics.get(), flags); }
+
+  uint8_t* get() const { return m_view; }
+  static uint64_t peakBackingBytes() { return s_peakBackingBytes.load(); }
+  size_t backingBytes() const {
+    std::lock_guard<std::mutex> guard(s_mutex);
+    return m_section ? m_size : 0;
+  }
+
+  // NV-DXVK start: One physical eviction guard covers game pointers and Bridge transfers.
+  struct State {
+    size_t backingBytes = 0, mappedBytes = 0;
+    unsigned exposed = 0, transferring = 0;
+    bool missing = false;
+  };
+  State state() const {
+    std::lock_guard<std::mutex> guard(s_mutex);
+    return { m_section ? m_size : 0, m_view ? m_mappedVaBytes : 0, m_locks, m_transfers, m_recoveryMissing };
+  }
+  void beginTransfer() { std::lock_guard<std::mutex> guard(s_mutex); ++m_transfers; }
+  void endTransfer() { std::lock_guard<std::mutex> guard(s_mutex); if (m_transfers) { --m_transfers; } }
+  class Transfer {
+    PagefileShadow& m_backing;
+  public:
+    explicit Transfer(PagefileShadow& backing) : m_backing(backing) { backing.beginTransfer(); }
+    ~Transfer() { m_backing.endTransfer(); }
+    Transfer(const Transfer&) = delete;
+    Transfer& operator=(const Transfer&) = delete;
+  };
+  // Rebuild from current Host bytes. Verification hashes belong to the experiment, not residency.
+  HRESULT restoreCurrent(const uint8_t* recovered, size_t bytes) {
+    std::lock_guard<std::mutex> guard(s_mutex);
+    if (!m_recoveryMissing || m_section || m_view || m_locks || m_transfers || bytes != m_size || !recovered) { return E_INVALIDARG; }
+    const auto section = CreateFileMappingW(INVALID_HANDLE_VALUE, nullptr, PAGE_READWRITE, 0, static_cast<DWORD>(bytes), nullptr);
+    if (!section) { return HRESULT_FROM_WIN32(GetLastError()); }
+    auto* view = static_cast<uint8_t*>(MapViewOfFile(section, FILE_MAP_ALL_ACCESS, 0, 0, bytes));
+    if (!view) { const auto error = GetLastError(); CloseHandle(section); return HRESULT_FROM_WIN32(error); }
+    std::memcpy(view, recovered, bytes);
+    if (!UnmapViewOfFile(view)) { const auto error = GetLastError(); CloseHandle(section); return HRESULT_FROM_WIN32(error); }
+    m_section = section; m_recoveryMissing = false;
+    if (l4d2_observation::memoryMonitoring) { l4d2_memory::surfaceBackingBytes.fetch_add(m_size); }
+    if (l4d2_observation::memoryMonitoring) { l4d2_memory::surfaceBackingCount.fetch_add(1); }
+    noteBackingPeak();
+    return S_OK;
+  }
+  // NV-DXVK end
+
+  // NV-DXVK start: Ground truth is accessed only after independent recovery completes.
+  HRESULT compareRecovered(const uint8_t* recovered, size_t bytes, l4d2_readback::Comparison& result) const {
+    std::lock_guard<std::mutex> guard(s_mutex);
+    if (!m_section || (m_locks || m_transfers) || bytes != m_size || !recovered) { return E_INVALIDARG; }
+    const auto* reference = static_cast<const uint8_t*>(MapViewOfFile(m_section, FILE_MAP_READ, 0, 0, m_size));
+    if (!reference) { return HRESULT_FROM_WIN32(GetLastError()); }
+    result = l4d2_readback::compare(reference, recovered, bytes);
+    return UnmapViewOfFile(reference) ? S_OK : HRESULT_FROM_WIN32(GetLastError());
+  }
+
+  bool recoveryMissing() const {
+    std::lock_guard<std::mutex> guard(s_mutex);
+    return m_recoveryMissing && !m_section && !m_view && !m_locks && !m_transfers;
+  }
+
+  HRESULT hashBacking(size_t bytes, l4d2_readback::Digest& digest) const {
+    std::lock_guard<std::mutex> guard(s_mutex);
+    if (!m_section || (m_locks || m_transfers) || bytes != m_size) { return E_INVALIDARG; }
+    const auto* reference = static_cast<const uint8_t*>(MapViewOfFile(m_section, FILE_MAP_READ, 0, 0, m_size));
+    if (!reference) { return HRESULT_FROM_WIN32(GetLastError()); }
+    const HRESULT hr = l4d2_readback::hashBytes(reference, bytes, digest);
+    if (!UnmapViewOfFile(reference)) { return HRESULT_FROM_WIN32(GetLastError()); }
+    return hr;
+  }
+
+  HRESULT evictBacking(size_t bytes) {
+    std::lock_guard<std::mutex> guard(s_mutex);
+    if (!m_section || m_recoveryMissing || (m_locks || m_transfers) || bytes != m_size) { return E_INVALIDARG; }
+    unmap();
+    if (m_view) { return HRESULT_FROM_WIN32(GetLastError()); }
+    if (!CloseHandle(m_section)) { return HRESULT_FROM_WIN32(GetLastError()); }
+    m_section = nullptr;
+    m_recoveryMissing = true;
+    if (l4d2_observation::memoryMonitoring) { l4d2_memory::surfaceBackingBytes.fetch_sub(m_size); }
+    if (l4d2_observation::memoryMonitoring) { l4d2_memory::surfaceBackingCount.fetch_sub(1); }
+    return S_OK;
+  }
+
+  HRESULT restoreRecovered(const uint8_t* recovered, size_t bytes, const l4d2_readback::Digest& expected,
+      l4d2_readback::Digest& rebuilt) {
+    std::lock_guard<std::mutex> guard(s_mutex);
+    if (!m_recoveryMissing || m_section || m_view || (m_locks || m_transfers) || bytes != m_size || !recovered) { return E_INVALIDARG; }
+    const auto section = CreateFileMappingW(INVALID_HANDLE_VALUE, nullptr, PAGE_READWRITE,
+      0, static_cast<DWORD>(bytes), nullptr);
+    if (!section) { return HRESULT_FROM_WIN32(GetLastError()); }
+    auto* view = static_cast<uint8_t*>(MapViewOfFile(section, FILE_MAP_ALL_ACCESS, 0, 0, bytes));
+    if (!view) { const auto error = GetLastError(); CloseHandle(section); return HRESULT_FROM_WIN32(error); }
+    std::memcpy(view, recovered, bytes);
+    HRESULT hr = l4d2_readback::hashBytes(view, bytes, rebuilt);
+    if (SUCCEEDED(hr) && rebuilt != expected) { hr = HRESULT_FROM_WIN32(ERROR_CRC); }
+    if (!UnmapViewOfFile(view)) { hr = HRESULT_FROM_WIN32(GetLastError()); }
+    if (FAILED(hr)) { CloseHandle(section); return hr; }
+    m_section = section;
+    m_recoveryMissing = false;
+    if (l4d2_observation::memoryMonitoring) { l4d2_memory::surfaceBackingBytes.fetch_add(m_size); }
+    if (l4d2_observation::memoryMonitoring) { l4d2_memory::surfaceBackingCount.fetch_add(1); }
+    noteBackingPeak();
+    return S_OK;
+  }
+  // NV-DXVK end
+
+  uint8_t* acquire(size_t size, size_t budget, bool replaceMissing = false) {
+    std::lock_guard<std::mutex> guard(s_mutex);
+    const bool overwrite = m_recoveryMissing && replaceMissing;
+    if (!size || (m_recoveryMissing && !overwrite) || (m_section && size != m_size)) { return nullptr; }
+    unlink();
+    if (!m_section) {
+      SYSTEM_INFO system {};
+      GetSystemInfo(&system);
+      const size_t granularity = system.dwAllocationGranularity;
+      // Charge alignment gaps too, otherwise thousands of small mip views
+      // could fragment considerably more VA than their byte sizes suggest.
+      if (size > SIZE_MAX - granularity) { return nullptr; }
+      m_viewCost = ((size + granularity - 1) / granularity) * granularity;
+      m_section = CreateFileMappingW(INVALID_HANDLE_VALUE, nullptr, PAGE_READWRITE,
+        0, static_cast<DWORD>(size), nullptr);
+      if (!m_section) {
+        const auto error = GetLastError();
+        l4d2_memory::sample(true, "section-create-failed", l4d2_memory::Kind::Surface, size, 0, 0, 0, error);
+        return nullptr;
+      }
+      m_size = size;
+      if (l4d2_observation::memoryMonitoring) { l4d2_memory::surfaceBackingBytes.fetch_add(size); }
+      if (l4d2_observation::memoryMonitoring) { l4d2_memory::surfaceBackingCount.fetch_add(1); }
+      noteBackingPeak();
+      if (!overwrite) { l4d2_pageblock::created(m_diagnostics.get(), size); }
+    }
+    if (!m_view) {
+      trim(m_viewCost >= budget ? 0 : budget - m_viewCost);
+      m_view = static_cast<uint8_t*>(MapViewOfFile(m_section, FILE_MAP_ALL_ACCESS, 0, 0, m_size));
+      if (!m_view) {
+        // Fragmentation can prevent a mapping even below the cache budget.
+        trim(0);
+        m_view = static_cast<uint8_t*>(MapViewOfFile(m_section, FILE_MAP_ALL_ACCESS, 0, 0, m_size));
+      }
+      if (!m_view) {
+        const auto error = GetLastError();
+        l4d2_memory::sample(true, "section-map-failed", l4d2_memory::Kind::Surface, size, 0, 0, 0, error);
+        if (overwrite) {
+          CloseHandle(m_section); m_section = nullptr;
+          if (l4d2_observation::memoryMonitoring) { l4d2_memory::surfaceBackingBytes.fetch_sub(m_size); }
+          if (l4d2_observation::memoryMonitoring) { l4d2_memory::surfaceBackingCount.fetch_sub(1); }
+        }
+        return nullptr;
+      }
+      MEMORY_BASIC_INFORMATION mapping {};
+      m_mappedVaBytes = VirtualQuery(m_view, &mapping, sizeof(mapping)) ? mapping.RegionSize : m_size;
+      s_mappedBytes += m_viewCost;
+      if (l4d2_observation::memoryMonitoring) { l4d2_memory::surfaceViewBudgetBytes.fetch_add(m_viewCost); }
+      if (l4d2_observation::memoryMonitoring) { l4d2_memory::bytes[0].fetch_add(m_size); }
+      if (l4d2_observation::memoryMonitoring) { l4d2_memory::objects[0].fetch_add(1); }
+    }
+    m_recoveryMissing = false;
+    ++m_locks;
+    return m_view;
+  }
+
+  void release(size_t budget) {
+    std::lock_guard<std::mutex> guard(s_mutex);
+    if (!m_locks || --m_locks) { return; }
+    m_next = s_head;
+    if (s_head) { s_head->m_prev = this; } else { s_tail = this; }
+    s_head = this;
+    m_listed = true;
+    trim(budget);
+  }
+};
diff --git a/bridge/src/client/readback_recovery.h b/bridge/src/client/readback_recovery.h
