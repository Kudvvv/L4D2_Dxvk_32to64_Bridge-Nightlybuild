+namespace l4d2_texture {
+
+struct CreationResult {
+  HRESULT hresult;
+  bool serverResponded;
+};
+
+template<typename Texture, typename Interface>
+HRESULT completeCreation(Texture* texture, Interface** output, CreationResult result) {
+  if (FAILED(result.hresult)) {
+    // A timeout leaves creation unresolved; an ordered Destroy must still be sent.
+    if (result.serverResponded) { texture->cancelServerCreation(); }
+    *output = nullptr;
+    texture->Release();
+  }
+  return result.hresult;
+}
+
+}
