+    write("PB_READBACK_TEST event=start resource_id=%u parent_id=%u width=%u height=%u format=0x%x mip=0 pool=1 usage=0 "
+      "backing_bytes=%u logical_row_bytes=%u block_rows=%u block_width=%u block_height=%u block_bytes=%u repeat=%u source=server-d3d9-readonly original_retained=1",
