+++ b/bridge/src/client/bridge_control.cpp
@@ -0,0 +1,45 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 yeyunyyds.
+// All newly added implementation code in this fork was generated by OpenAI Codex from prompts and specifications provided by yeyunyyds.
+#include "pch.h"
+#include "bridge_settings.h"
+#include "log/log.h"
+#include "config/config.h"
+
+extern "C" HRESULT WINAPI L4D2BridgePageBlockControl(const l4d2_control::Request*, l4d2_control::Response*);
+namespace l4d2_settings {
+static Controls& controls() { static auto* instance = new Controls(); return *instance; }
+template<typename Getter> static Target target(Getter get) {
+  Target result;
+  result.host = get("client.testX86Server", false) ? Host::X86 : Host::X64;
+  const auto name = get("client.pageBlockRetentionPolicy", std::string("keep"));
+  result.policy = name == "learned-aggressive" ? l4d2_control::Policy::LearnedAggressive
+    : name == "drop" ? l4d2_control::Policy::Drop : l4d2_control::Policy::Keep;
+  for (size_t i = 0; i < result.presenter.size(); ++i) {
+    result.presenter[i] = i == 2 || i >= 7 ? get(kPresenterKeys[i], result.presenter[i])
+      : (get(kPresenterKeys[i], result.presenter[i] != 0) ? 1u : 0u);
+  }
+  return result;
+}
+void initialize() {
+  auto& control = controls();
+  control.read = [](Target& result) -> HRESULT {
+    bridge_util::Config::OptionMap options;
+    const HRESULT hr = bridge_util::Config::readPersistentOptions(options);
+    if (SUCCEEDED(hr)) {
+      result = target([&options](const char* key, auto fallback) { return bridge_util::Config::optionFrom(options, key, fallback); });
+    }
+    return hr;
+  };
+  control.write = [](const Updates& updates) -> HRESULT { return bridge_util::Config::updatePersistentOptions(updates); };
+  control.runtime = [](const l4d2_control::Request& request, l4d2_control::Response& response) {
+    return L4D2BridgePageBlockControl(&request, &response);
+  };
+  control.initialize(target([](const char* key, auto fallback) { return bridge_util::Config::getOption(key, fallback); }));
+}
+void recordHost(Host host) { controls().recordHost(host); }
+}
+extern "C" HRESULT WINAPI L4D2BridgeControl(const l4d2_bridge_control::Request* request, l4d2_bridge_control::Response* response) {
+  try { return l4d2_settings::controls().invoke(request, response); }
+  catch (...) { return E_FAIL; }
+}
