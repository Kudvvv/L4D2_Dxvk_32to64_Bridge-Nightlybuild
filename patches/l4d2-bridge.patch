+// All newly added implementation code in this fork was generated by OpenAI Codex from prompts and specifications provided by yeyunyyds.
+#pragma once
+
+#include <algorithm>
+#include <atomic>
+#include <cstdarg>
+#include <cstdio>
+#include <mutex>
+#include "config/config.h"
+#include "pagefile_shadow.h"
+#include "readback_transport.h"
+#include "util_devicecommand.h"
+
+namespace l4d2_readback {
+struct Context {
+  std::atomic<bool> enabled { false };
+  uint32_t maximum = 20, repeats = 3;
+  Selection selection;
+  std::mutex mutex;
+  HANDLE log = INVALID_HANDLE_VALUE;
+  uint64_t sequence = 0, attempts = 0, recovered = 0, matches = 0, failures = 0, mismatches = 0;
+  Context() {
+    try {
+      enabled = bridge_util::Config::getOption<bool>("client.testReadbackRecovery", false);
+      if (enabled) {
+        maximum = (std::min)(20u, bridge_util::Config::getOption<uint32_t>("client.testReadbackMaxResources", 20));
+        repeats = (std::max)(1u, (std::min)(8u, bridge_util::Config::getOption<uint32_t>("client.testReadbackRepeats", 3)));
+      }
+    } catch (...) { enabled = false; }
+  }
+  ~Context() { if (log != INVALID_HANDLE_VALUE) { CloseHandle(log); } }
+};
+inline Context& context() { static Context instance; return instance; }
+inline bool enabled() { return context().enabled; }
+
+inline void write(const char* format, ...) {
+  auto& c = context();
+  if (c.log == INVALID_HANDLE_VALUE) {
+    wchar_t path[MAX_PATH] {}; HMODULE module = nullptr;
+    if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+        reinterpret_cast<LPCWSTR>(&context), &module) || !GetModuleFileNameW(module, path, MAX_PATH)) { return; }
+    auto slash = std::wcsrchr(path, L'\\');
+    if (!slash) { return; }
+    *(slash + 1) = 0;
+    if (wcscat_s(path, L"l4d2-readback.log") != 0) { return; }
+    c.log = CreateFileW(path, GENERIC_WRITE, FILE_SHARE_READ, nullptr, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (c.log == INVALID_HANDLE_VALUE) { return; }
+  }
+  char line[2048] {}; SYSTEMTIME now {}; GetLocalTime(&now);
+  const int prefix = sprintf_s(line, "%02u:%02u:%02u.%03u pid=%lu ", now.wHour, now.wMinute, now.wSecond,
+    now.wMilliseconds, GetCurrentProcessId());
+  if (prefix < 0) { return; }
+  va_list args; va_start(args, format);
