+// The four size slots reserve room for 4096 textures rather than filling with tiny mips.
+class Selection {
+  std::array<bool, 20> m_selected {};
+  uint32_t m_count = 0;
+public:
+  bool take(uint32_t format, uint32_t width, uint32_t height, uint32_t maximum) {
+    const uint32_t formats[] = { kDxt1, kDxt3, kDxt5, 21, 22 };
+    const uint32_t sizes[] = { 256, 1024, 2048, 4096 };
+    const uint32_t extent = width > height ? width : height;
+    for (size_t f = 0; f < 5; ++f) {
+      for (size_t s = 0; s < 4; ++s) {
+        const size_t slot = f * 4 + s;
+        if (format == formats[f] && extent == sizes[s] && !m_selected[slot] && m_count < maximum) {
+          m_selected[slot] = true; ++m_count; return true;
+        }
+      }
+    }
+    return false;
+  }
+  uint32_t count() const { return m_count; }
+};
+}
