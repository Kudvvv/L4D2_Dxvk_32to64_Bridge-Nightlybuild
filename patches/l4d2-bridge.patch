+inline bool layout(uint32_t width, uint32_t height, uint32_t format, Layout& result) {
+  result = {};
+  if (!isFormat(format) || !width || !height || width > 16384 || height > 16384) { return false; }
+  const uint32_t blockBytes = format == kAti1 ? 8u : 16u;
+  const uint32_t apiPitch = (width + 3u) & ~3u;
+  const uint32_t storagePitch = ((width + 3u) / 4u) * blockBytes;
+  const uint32_t rows = (height + 3u) / 4u;
+  const size_t bytes = static_cast<size_t>(storagePitch) * rows;
+  const size_t apiBytes = static_cast<size_t>(apiPitch) * height;
+  result = { width, height, blockBytes, apiPitch, storagePitch, rows, bytes,
+    bytes > apiBytes ? bytes : apiBytes };
+  return true;
+}
+
+struct Transfer {
+  size_t offset = 0, bytes = 0;
+  uint32_t rowBytes = 0, rows = 0;
+};
+
+inline bool region(const Layout& l, int32_t left, int32_t top, int32_t right, int32_t bottom, Transfer& result) {
+  result = {};
+  if (!l.bytes || left < 0 || top < 0 || right <= left || bottom <= top
+    || static_cast<uint32_t>(right) > l.width || static_cast<uint32_t>(bottom) > l.height) { return false; }
+  // DXVK LockImage's ATI compatibility path uses this byte offset, not block coordinates.
+  const size_t offset = static_cast<size_t>(top) * l.apiPitch + static_cast<uint32_t>(left);
+  const uint32_t rowBytes = ((static_cast<uint32_t>(right - left) + 3u) / 4u) * l.blockBytes;
+  const uint32_t rows = (static_cast<uint32_t>(bottom - top) + 3u) / 4u;
+  const size_t span = static_cast<size_t>(rows - 1u) * l.storagePitch + rowBytes;
+  if (offset > l.bytes || span > l.bytes - offset) { return false; }
+  result = { offset, static_cast<size_t>(rowBytes) * rows, rowBytes, rows };
+  return true;
+}
+
+inline bool copyRows(void* destination, size_t destinationBytes, uint32_t destinationPitch,
+                    const void* source, size_t sourceBytes, uint32_t sourcePitch,
+                    const Transfer& t) {
+  if (!destination || !source || !t.rows || !t.rowBytes
+    || destinationPitch < t.rowBytes || sourcePitch < t.rowBytes) { return false; }
+  const uint64_t destinationSpan = static_cast<uint64_t>(t.rows - 1u) * destinationPitch + t.rowBytes;
+  const uint64_t sourceSpan = static_cast<uint64_t>(t.rows - 1u) * sourcePitch + t.rowBytes;
