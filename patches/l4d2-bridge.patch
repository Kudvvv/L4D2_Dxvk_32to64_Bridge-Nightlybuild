+      | (GetModuleHandleW(L"GameOverlayRenderer64.dll") ? 2u : 0u)
+      | (GetModuleHandleW(L"SteamOverlayVulkanLayer.dll") ? 4u : 0u)
+      | (GetModuleHandleW(L"SteamOverlayVulkanLayer64.dll") ? 8u : 0u)
+      | (GetModuleHandleW(L"steam_api.dll") ? 16u : 0u)
+      | (GetModuleHandleW(L"steam_api64.dll") ? 32u : 0u);
