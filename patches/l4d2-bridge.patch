+    MSG message {};
+    PeekMessageW(&message, nullptr, WM_USER, WM_USER, PM_NOREMOVE);
+    const HINSTANCE instance = GetModuleHandleW(nullptr);
+    WNDCLASSEXW wc {};
+    wc.cbSize = sizeof(wc); wc.lpfnWndProc = windowProc; wc.hInstance = instance;
+    wc.lpszClassName = L"L4D2BridgeOverlayPresenter";
+    const ATOM atom = RegisterClassExW(&wc);
+    if (!atom && GetLastError() != ERROR_CLASS_ALREADY_EXISTS) { SetEvent(m_ready); return; }
+    RECT rect {};
+    GetClientRect(m_parent, &rect);
+    // Suppress synchronous parent notifications while the game awaits CreateDevice.
+    const HWND window = CreateWindowExW(WS_EX_NOPARENTNOTIFY | WS_EX_NOACTIVATE,
+      wc.lpszClassName, L"L4D2 Bridge Presenter", WS_CHILD | WS_VISIBLE | WS_DISABLED,
+      0, 0, rect.right, rect.bottom, m_parent, nullptr, instance, this);
+    m_window.store(window);
+    if (window && m_input) {
+      DWORD parentPid = 0;
+      const DWORD parentThread = GetWindowThreadProcessId(m_parent, &parentPid);
+      ActivateKeyboardLayout(GetKeyboardLayout(parentThread), 0);
+      m_keyboard = SetWindowsHookExW(WH_KEYBOARD_LL, keyHook, instance, 0);
+      if (m_log) { m_log(m_keyboard ? "L4D2_OVERLAY event=keyboard-hook installed=1" : "L4D2_OVERLAY event=keyboard-hook installed=0"); }
+    }
+    if (window) { SetTimer(window, 1, 250, nullptr); }
+    SetEvent(m_ready);
+    if (!window) { return; }
+    while (!m_stop.load() && GetMessageW(&message, nullptr, 0, 0) > 0) {
+      TranslateMessage(&message);
+      DispatchMessageW(&message);
+    }
+    if (m_keyboard) { UnhookWindowsHookEx(m_keyboard); m_keyboard = nullptr; }
+    m_capture.store(false); applyMode();
+    if (IsWindow(window)) { DestroyWindow(window); }
+    m_window.store(nullptr);
+  }
+public:
+  explicit Presenter(bool input = true, UINT hotkey = VK_HOME, bool fallback = false,
+                     std::function<void(const char*)> log = {})
+    : m_input(input), m_fallback(fallback), m_hotkey(hotkey), m_log(std::move(log)) {
+    m_uiMessage = RegisterWindowMessageW(L"UWM_REMIX_UIACTIVE_MSG");
+  }
+  ~Presenter() { stop(); }
+  Presenter(const Presenter&) = delete;
+  Presenter& operator=(const Presenter&) = delete;
+  HWND window(HWND parent) {
+    if (!IsWindow(parent)) { return nullptr; }
+    if (m_parent) { return m_parent == parent ? m_window.load() : nullptr; }
+    m_parent = parent;
+    m_ready = CreateEventW(nullptr, TRUE, FALSE, nullptr);
+    if (!m_ready) { return nullptr; }
+    s_active.store(this);
+    try { m_thread = std::thread([this] { worker(); }); }
+    catch (...) { if (m_log) { m_log("L4D2_OVERLAY event=window-error reason=thread-start-failed"); } return nullptr; }
+    if (WaitForSingleObject(m_ready, 5000) != WAIT_OBJECT_0) { return nullptr; }
+    return m_window.load();
+  }
+  HWND route(HWND original) const {
+    const HWND window = m_window.load();
+    return original && original == m_parent && window ? window : original;
+  }
+  void capture(bool active) {
+    if (m_capture.exchange(active) == active) { return; }
+    PostMessageW(m_window.load(), kMode, 0, 0);
+    if (m_uiMessage) { PostMessageW(m_parent, m_uiMessage, active ? 1 : 0, 0); }
+    if (m_log) { m_log(active ? "L4D2_OVERLAY event=input-capture active=1" : "L4D2_OVERLAY event=input-capture active=0"); }
+  }
+  bool capturing() const { return m_capture.load(); }
+  static unsigned steamModules() {
+    return (GetModuleHandleW(L"SteamOverlayVulkanLayer.dll") ? 1u : 0u)
+      | (GetModuleHandleW(L"SteamOverlayVulkanLayer64.dll") ? 2u : 0u)
+      | (GetModuleHandleW(L"GameOverlayRenderer.dll") ? 4u : 0u)
+      | (GetModuleHandleW(L"GameOverlayRenderer64.dll") ? 8u : 0u);
+  }
+  bool bindReShade(HMODULE module) {
+    if (m_reshade) { return true; }
+    if (!module || module == m_attempted || !m_window.load() || !m_input) { return false; }
+    auto reg = proc<RegisterAddon>(module, "ReShadeRegisterAddon");
+    auto event = proc<RegisterEvent>(module, "ReShadeRegisterEvent");
+    auto unregEvent = proc<RegisterEvent>(module, "ReShadeUnregisterEvent");
+    auto unreg = proc<UnregisterAddon>(module, "ReShadeUnregisterAddon");
+    if (!reg || !event || !unregEvent || !unreg) { return false; }
+    m_attempted = module;
+    if (!reg(GetModuleHandleW(nullptr), kReShadeApi)) {
+      if (m_log) { m_log("L4D2_OVERLAY event=reshade-api registered=0 reason=addon-registration-rejected"); }
+      return false;
+    }
+    HMODULE pinned = nullptr;
+    if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS,
+      reinterpret_cast<LPCWSTR>(module), &pinned)) {
+      unreg(GetModuleHandleW(nullptr)); return false;
+    }
+    m_unregisterEvent = unregEvent; m_unregisterAddon = unreg;
+    m_reshade = module;
+    event(kOpenOverlayEvent, callback());
+    if (m_log) { m_log("L4D2_OVERLAY event=reshade-api registered=1 api=10 overlay_event=86"); }
+    return true;
+  }
+  bool findReShade() {
+    if (m_reshade) { return true; }
+    HANDLE snapshot = CreateToolhelp32Snapshot(TH32CS_SNAPMODULE, GetCurrentProcessId());
+    if (snapshot == INVALID_HANDLE_VALUE) { return false; }
+    MODULEENTRY32W entry {}; entry.dwSize = sizeof(entry);
+    bool result = false;
+    if (Module32FirstW(snapshot, &entry)) {
+      do { if (bindReShade(entry.hModule)) { result = true; break; } } while (Module32NextW(snapshot, &entry));
+    }
+    CloseHandle(snapshot);
+    return result;
+  }
+  void stop() {
+    if (m_reshade) {
+      m_unregisterEvent(kOpenOverlayEvent, callback());
+      m_unregisterAddon(GetModuleHandleW(nullptr));
+      HMODULE module = m_reshade.exchange(nullptr);
+      FreeLibrary(module);
+    }
+    capture(false);
+    m_stop.store(true);
+    if (m_threadId.load()) { PostThreadMessageW(m_threadId.load(), WM_QUIT, 0, 0); }
+    if (m_thread.joinable()) { m_thread.join(); }
+    m_threadId.store(0);
+    if (m_ready) { CloseHandle(m_ready); m_ready = nullptr; }
+    if (s_active.load() == this) { s_active.store(nullptr); }
+  }
+};
+}
diff --git a/bridge/src/server/readback_backend.h b/bridge/src/server/readback_backend.h
new file mode 100644
index 0000000..22832fe
--- /dev/null
+++ b/bridge/src/server/readback_backend.h
@@ -0,0 +1,126 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 yeyunyyds.
+// All newly added implementation code in this fork was generated by OpenAI Codex from prompts and specifications provided by yeyunyyds.
+#pragma once
+
+#include <cstring>
+#include <d3d9.h>
+#include "../util/readback_transport.h"
+
+namespace l4d2_readback {
+class D3D9Backend {
+  IDirect3DSurface9* m_surface;
+public:
+  explicit D3D9Backend(IDirect3DSurface9* surface) : m_surface(surface) {}
+  HRESULT descriptor(D3DSURFACE_DESC& desc) { return m_surface->GetDesc(&desc); }
+  HRESULT lock(D3DLOCKED_RECT& locked) { return m_surface->LockRect(&locked, nullptr, D3DLOCK_READONLY); }
+  HRESULT unlock() { return m_surface->UnlockRect(); }
+  HRESULT synchronize(Response& response) {
+    LARGE_INTEGER begin {}, end {}; QueryPerformanceCounter(&begin);
+    IDirect3DDevice9* device = nullptr;
+    IDirect3DQuery9* query = nullptr;
+    response.stage = Stage::GetDevice;
+    HRESULT hr = m_surface->GetDevice(&device);
+    if (SUCCEEDED(hr)) {
+      response.stage = Stage::QueryCreate;
+      hr = device->CreateQuery(D3DQUERYTYPE_EVENT, &query);
+    }
+    if (SUCCEEDED(hr)) {
+      response.stage = Stage::QueryIssue;
+      hr = query->Issue(D3DISSUE_END);
+    }
+    if (SUCCEEDED(hr)) {
+      response.stage = Stage::QueryWait;
+      response.flushRequested = response.eventWait = 1;
+      const auto deadline = GetTickCount64() + 5000;
+      do {
+        ++response.queryPolls;
+        hr = query->GetData(nullptr, 0, D3DGETDATA_FLUSH);
+        if (hr != S_FALSE) { break; }
+        if (GetTickCount64() >= deadline) { hr = HRESULT_FROM_WIN32(ERROR_TIMEOUT); break; }
+        Sleep(1);
+      } while (true);
+    }
+    if (query) { query->Release(); }
+    if (device) { device->Release(); }
+    QueryPerformanceCounter(&end); response.syncUs = microseconds(begin, end);
+    return hr;
+  }
+};
+
+// No reference pointer or historical upload data can be supplied to this pipeline.
+// Production supplies a D3D9Backend wrapping the current server resource.
+template<typename Backend>
+Response recover(Backend& backend, const Request& request, uint8_t* recovered) {
+  Response response;
+  Layout l;
+  response.stage = Stage::Protocol;
+  if (!requestValid(request, l) || !recovered) { response.hresult = E_INVALIDARG; return response; }
+  D3DSURFACE_DESC desc {};
+  response.stage = Stage::Descriptor;
+  response.hresult = backend.descriptor(desc);
+  if (FAILED(response.hresult)) { return response; }
+  response.width = desc.Width; response.height = desc.Height; response.format = static_cast<uint32_t>(desc.Format);
+  response.mip = request.mip;
+  if (desc.Width != request.width || desc.Height != request.height || static_cast<uint32_t>(desc.Format) != request.format
+    || desc.Usage != 0 || desc.Pool != D3DPOOL_MANAGED || desc.MultiSampleType != D3DMULTISAMPLE_NONE) {
+    response.hresult = D3DERR_INVALIDCALL; return response;
+  }
+  response.rowBytes = l.rowBytes; response.rows = l.rows;
+  response.blockWidth = l.blockWidth; response.blockHeight = l.blockHeight; response.blockBytes = l.blockBytes;
+  if (request.operation == 1) {
+    // Ordered acknowledgement: earlier uploads were consumed; no pixel recovery or GPU wait is needed.
+    response.stage = Stage::Complete; response.hresult = S_OK;
+    return response;
+  }
+  response.hresult = backend.synchronize(response);
+  if (response.hresult != S_OK) {
+    if (SUCCEEDED(response.hresult)) { response.hresult = E_FAIL; }
+    return response;
+  }
+  LARGE_INTEGER begin {}, end {}; QueryPerformanceCounter(&begin);
+  D3DLOCKED_RECT locked {};
+  response.stage = Stage::Lock;
+  response.hresult = backend.lock(locked);
+  if (SUCCEEDED(response.hresult)) {
+    response.backendPitch = locked.Pitch > 0 ? static_cast<uint32_t>(locked.Pitch) : 0;
+    const bool copied = packRows(static_cast<const uint8_t*>(locked.pBits), locked.Pitch, recovered, l);
+    const HRESULT unlockResult = backend.unlock();
+    if (!copied) { response.stage = Stage::Pitch; response.hresult = E_INVALIDARG; }
+    else if (FAILED(unlockResult)) { response.stage = Stage::Unlock; response.hresult = unlockResult; }
+    else { response.stage = Stage::Complete; response.hresult = S_OK; response.bytes = l.bytes; }
+  }
+  QueryPerformanceCounter(&end); response.backendReadUs = microseconds(begin, end);
+  return response;
+}
+
+inline void publish(const Request& request, const Response& response, uint8_t* view, HANDLE done) {
+  (void)request;
+  if (view) { std::memcpy(view, &response, sizeof(response)); }
+  MemoryBarrier();
+  SetEvent(done);
+}
+
+// The shared section only carries this experiment's recovered copy and status.
+template<typename Backend>
+bool runShared(Backend& backend, const Request& request, bool enabled, bool resourceValid) {
+  Layout l;
+  if (!requestValid(request, l)) { return false; }
+  wchar_t eventName[112] {}; swprintf_s(eventName, L"%ls-done", request.name);
+  HANDLE done = OpenEventW(EVENT_MODIFY_STATE, FALSE, eventName);
+  if (!done) { return false; }
+  HANDLE section = OpenFileMappingW(FILE_MAP_WRITE, FALSE, request.name);
+  uint8_t* view = section ? static_cast<uint8_t*>(MapViewOfFile(section, FILE_MAP_WRITE,
+    0, 0, sizeof(Response) + (request.operation ? 0 : request.bytes))) : nullptr;
+  Response response;
+  if (!view) { response.stage = Stage::Mapping; response.hresult = HRESULT_FROM_WIN32(GetLastError()); }
+  else if (!enabled) { response.stage = Stage::Disabled; response.hresult = E_ACCESSDENIED; }
+  else if (!resourceValid) { response.stage = Stage::Resource; response.hresult = D3DERR_INVALIDCALL; }
+  else { response = recover(backend, request, view + sizeof(Response)); }
+  publish(request, response, view, done);
+  if (view) { UnmapViewOfFile(view); }
+  if (section) { CloseHandle(section); }
+  CloseHandle(done);
+  return view != nullptr;
+}
+}
