+#include <atomic>
+#include <cstdarg>
+#include <cstdio>
+#include <cwchar>
+#include <mutex>
+#include <windows.h>
+#include "shadow_lifetime.h"
+
+namespace l4d2_pageblock {
+using l4d2_shadow::Record;
+using l4d2_shadow::Metadata;
+struct Context {
+  std::mutex mutex;
+  l4d2_shadow::Engine engine;
+  HANDLE log = INVALID_HANDLE_VALUE;
+  std::atomic<uint64_t> dropped { 0 }, metadataRecords { 0 };
+  std::atomic<bool> used { false };
+  std::atomic<uint64_t> nextSample { 0 };
+  bool detailed = false;
+};
+inline Context context;
+inline unsigned long long number(uint64_t value) { return static_cast<unsigned long long>(value); }
+
+inline HANDLE openLog() {
+  HMODULE module = nullptr;
+  if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+      GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+      reinterpret_cast<LPCWSTR>(&openLog), &module)) { return INVALID_HANDLE_VALUE; }
+  wchar_t path[MAX_PATH] {};
+  const auto length = GetModuleFileNameW(module, path, MAX_PATH);
+  if (!length || length >= MAX_PATH) { return INVALID_HANDLE_VALUE; }
+  auto* separator = std::wcsrchr(path, L'\\');
+  constexpr wchar_t filename[] = L"l4d2-pageblock.log";
+  if (!separator || static_cast<size_t>(separator - path) + sizeof(filename) / sizeof(wchar_t) >= MAX_PATH) {
+    return INVALID_HANDLE_VALUE;
+  }
+  std::wmemcpy(separator + 1, filename, sizeof(filename) / sizeof(wchar_t));
+  return CreateFileW(path, GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE,
+    nullptr, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+}
+
+// Called with the diagnostic mutex held; no heap formatting or background worker.
+inline void write(const char* format, ...) {
+  if (context.log == INVALID_HANDLE_VALUE) { ++context.dropped; return; }
+  char line[2400] {};
+  SYSTEMTIME time {};
+  GetLocalTime(&time);
+  const int prefix = std::snprintf(line, sizeof(line), "%02u:%02u:%02u.%03u pid=%lu ",
+    time.wHour, time.wMinute, time.wSecond, time.wMilliseconds, GetCurrentProcessId());
+  if (prefix <= 0) { ++context.dropped; return; }
+  va_list args;
+  va_start(args, format);
+  const int length = std::vsnprintf(line + prefix, sizeof(line) - prefix - 2, format, args);
+  va_end(args);
+  if (length < 0 || static_cast<size_t>(prefix + length + 2) >= sizeof(line)) { ++context.dropped; return; }
+  line[prefix + length] = '\n';
+  DWORD written = 0;
+  const auto size = static_cast<DWORD>(prefix + length + 1);
+  if (!WriteFile(context.log, line, size, &written, nullptr) || written != size) { ++context.dropped; }
+}
+
+inline const char* typeName(l4d2_shadow::Type type) {
+  switch (type) {
+  case l4d2_shadow::Type::Texture2DLevel: return "texture2d-level";
+  case l4d2_shadow::Type::CubeFaceLevel: return "cube-face-level";
+  case l4d2_shadow::Type::BackBuffer: return "backbuffer";
+  default: return "surface";
+  }
+}
+
+inline void resource(const Record& r, const char* event) {
+  l4d2_shadow::Totals classification;
+  classification.add(r);
+  write("PB_RESOURCE schema=1 event=%s resource_id=%llu parent_id=%llu resource_type=%s width=%u height=%u "
+    "format=0x%x mip=%u face=%u pool=%u usage=0x%x backing_bytes=%llu creation_tick_ms=%llu backing_tick_ms=%llu "
+    "destruction_tick_ms=%llu lock_count=%llu unlock_count=%llu first_lock_tick_ms=%llu last_lock_tick_ms=%llu "
+    "first_unlock_tick_ms=%llu first_upload_tick_ms=%llu upload_completed=%u relocked_after_first_unlock=%u "
+    "post_upload_locks=%llu post_upload_preserve_locks=%llu readonly_locks=%llu discard_locks=%llu "
+    "nooverwrite_locks=%llu normal_locks=%llu full_locks=%llu partial_locks=%llu active_locks=%u "
+    "second_lock_delay_valid=%u second_lock_delay_ms=%llu first_relock_delay_ms=%llu max_lock_interval_ms=%llu "
+    "average_lock_interval_ms=%.3f class_initial_upload_only=%u class_discard_only=%u class_potential_previous=%u "
+    "class_readonly=%u class_frequent=%u",
+    event, number(r.meta.resourceId), number(r.meta.parentId), typeName(r.meta.type), r.meta.width, r.meta.height,
+    r.meta.format, r.meta.mip, r.meta.face, r.meta.pool, r.meta.usage, number(r.size), number(r.meta.creationTime),
+    number(r.backingTime), number(r.destructionTime), number(r.locks), number(r.unlocks), number(r.firstLock),
+    number(r.lastLock), number(r.firstUnlock), number(r.firstUpload), static_cast<unsigned>(r.hasUpload),
+    static_cast<unsigned>(r.relockedAfterUnlock), number(r.afterUploadLocks), number(r.afterUploadPreserve),
+    number(r.readonlyLocks), number(r.discardLocks), number(r.nooverwriteLocks), number(r.normalLocks),
+    number(r.fullLocks), number(r.partialLocks), r.activeLocks, static_cast<unsigned>(r.secondDelayValid),
+    number(r.secondLockDelay), number(r.firstRelockDelay), number(r.maxLockInterval),
+    r.locks > 1 ? static_cast<double>(r.sumLockInterval) / static_cast<double>(r.locks - 1) : 0.0,
+    static_cast<unsigned>(classification.initialOnly.resources), static_cast<unsigned>(classification.discardOnly.resources),
+    static_cast<unsigned>(classification.potentiallyRequired.resources), static_cast<unsigned>(classification.readonly.resources),
+    static_cast<unsigned>(classification.frequent.resources));
+}
+
+inline void burst(uint64_t now) {
+  const auto& engine = context.engine;
+  const auto end = engine.eventCount;
+  const auto begin = end > engine.events.size() ? end - engine.events.size() : 0;
+  uint64_t eligible = 0;
+  for (auto i = begin; i < end; ++i) {
+    if (now - engine.events[static_cast<size_t>(i % engine.events.size())].time < 1000) { ++eligible; }
+  }
+  const bool truncated = eligible > 64 || (begin && now - engine.events[static_cast<size_t>(begin % engine.events.size())].time < 1000);
+  write("PB_BURST schema=1 tick_ms=%llu new_backing_bytes=%llu new_backing_resources=%llu window_ms=1000 "
+    "burst_id=%llu retained_events=%llu detail_limit=64 details_truncated=%u",
+    number(now), number(engine.windowBytes), number(engine.windowCount), number(engine.burstCount),
+    number(eligible), static_cast<unsigned>(truncated));
+  uint32_t emitted = 0;
+  // Keep the newest events, including the allocation that crossed the threshold.
+  for (auto i = end; i > begin && emitted < 64; ) {
+    const auto& e = engine.events[static_cast<size_t>(--i % engine.events.size())];
+    if (now - e.time >= 1000) { continue; }
+    write("PB_BURST_RESOURCE burst_id=%llu tick_ms=%llu event=%s resource_id=%llu parent_id=%llu "
+      "resource_type=%s width=%u height=%u format=0x%x mip=%u face=%u pool=%u usage=0x%x backing_bytes=%llu lock_flags=0x%x",
+      number(engine.burstCount), number(e.time), e.creation ? "created" : "locked", number(e.meta.resourceId),
+      number(e.meta.parentId), typeName(e.meta.type), e.meta.width, e.meta.height, e.meta.format, e.meta.mip,
+      e.meta.face, e.meta.pool, e.meta.usage, number(e.size), e.flags);
+    ++emitted;
+  }
+}
+
+inline void start(bool detailed) {
+  std::lock_guard<std::mutex> guard(context.mutex);
+  if (context.used.exchange(true)) { return; }
+  context.detailed = detailed;
+  context.log = openLog();
+  write("PB_CONFIG schema=1 enabled=1 detailed=%u simulated_lru=1 frequent_lock_threshold=8 "
+    "large_threshold_bytes=16777216 burst_threshold_bytes=104857600 diagnostic_only=1",
+    static_cast<unsigned>(detailed));
+}
+
+inline void created(Record* r, uint64_t size) {
+  if (!r) { return; }
+  const auto now = GetTickCount64();
+  std::lock_guard<std::mutex> guard(context.mutex);
+  const bool notable = context.engine.create(*r, size, now);
+  if (size >= 16 * l4d2_shadow::kMiB) { resource(*r, "large-created"); }
+  if (notable) { burst(now); }
+}
+
+inline void locked(Record* r, uint32_t flags, bool full) {
+  if (!r) { return; }
+  const auto now = GetTickCount64();
+  std::lock_guard<std::mutex> guard(context.mutex);
+  context.engine.lock(*r, now, flags, full);
+}
+
+inline void unlocked(Record* r, uint32_t flags) {
+  if (!r) { return; }
+  const auto now = GetTickCount64();
+  std::lock_guard<std::mutex> guard(context.mutex);
+  context.engine.unlock(*r, now, flags);
+}
+
+inline void destroyed(Record* r) {
+  if (!r) { return; }
+  const auto now = GetTickCount64();
+  std::lock_guard<std::mutex> guard(context.mutex);
+  if (r->registered) {
+    context.engine.destroy(*r, now);
+    if (context.detailed || r->size >= 16 * l4d2_shadow::kMiB) { resource(*r, "destroyed"); }
+  }
+}
+
+inline void totals(const l4d2_shadow::Totals& t, const char* scope, uint64_t sample) {
+  write("PB_TOTAL schema=1 sample=%llu scope=%s total_resources=%llu total_backing_bytes=%llu "
+    "initial_upload_only_resources=%llu initial_upload_only_bytes=%llu relocked_resources=%llu relocked_bytes=%llu "
+    "relock_discard_only_resources=%llu relock_discard_only_bytes=%llu relock_potential_resources=%llu relock_potential_bytes=%llu "
+    "readonly_resources=%llu readonly_bytes=%llu frequent_resources=%llu frequent_bytes=%llu dynamic_resources=%llu dynamic_bytes=%llu "
+    "incomplete_resources=%llu incomplete_bytes=%llu potential_persistent_bytes=%llu potential_nonpersistent_bytes=%llu "
+    "initial_upload_only_percent=%.2f",
+    number(sample), scope, number(t.all.resources), number(t.all.bytes), number(t.initialOnly.resources),
+    number(t.initialOnly.bytes), number(t.relocked.resources), number(t.relocked.bytes), number(t.discardOnly.resources),
+    number(t.discardOnly.bytes), number(t.potentiallyRequired.resources), number(t.potentiallyRequired.bytes),
+    number(t.readonly.resources), number(t.readonly.bytes), number(t.frequent.resources), number(t.frequent.bytes),
+    number(t.dynamic.resources), number(t.dynamic.bytes), number(t.incomplete.resources), number(t.incomplete.bytes),
+    number(t.persistent.bytes), number(t.nonpersistent.bytes),
+    t.all.bytes ? 100.0 * static_cast<double>(t.initialOnly.bytes) / static_cast<double>(t.all.bytes) : 0.0);
+  const char* buckets[] = { "lt_1s", "1_to_lt_10s", "10_to_60s", "gt_60s" };
+  for (size_t i = 0; i < t.delays.size(); ++i) {
+    write("PB_INTERVAL sample=%llu scope=%s bucket=%s resources=%llu backing_bytes=%llu",
+      number(sample), scope, buckets[i], number(t.delays[i].resources), number(t.delays[i].bytes));
+  }
+}
+
+inline void summary(bool final = false) {
+  if (!context.used.load()) { return; }
+  const auto now = GetTickCount64();
+  auto deadline = context.nextSample.load();
+  if (!final && (now < deadline || !context.nextSample.compare_exchange_strong(deadline, now + 10000))) { return; }
+  // Detach may run under the loader lock; skip instead of waiting on another thread.
+  std::unique_lock<std::mutex> guard(context.mutex, std::try_to_lock);
+  if (!guard.owns_lock()) { return; }
+  auto& engine = context.engine;
+  static uint64_t sample = 0;
+  ++sample;
+  write("PB_SUMMARY schema=1 sample=%llu tick_ms=%llu event=%s total_created_resources=%llu total_created_backing_bytes=%llu "
+    "alive_resources=%llu alive_backing_bytes=%llu peak_alive_backing_bytes=%llu diagnostic_record_bytes=%llu "
+    "diagnostic_fixed_bytes=%llu dropped_diagnostic_events=%llu scope_note=live_is_incomplete diagnostic_only=1",
+    number(sample), number(now), final ? "client-detach" : "sample", number(engine.createdResources),
+    number(engine.createdBytes), number(engine.aliveResources), number(engine.aliveBytes), number(engine.peakAliveBytes),
+    number(context.metadataRecords.load() * sizeof(Record)), number(sizeof(Context)), number(context.dropped.load()));
+  totals(engine.destroyed, "destroyed", sample);
+  totals(engine.live(), "live-incomplete", sample);
+  for (const auto& sim : engine.simulations) {
+    const auto attempts = sim.hits + sim.misses;
+    write("PB_SIM_LRU sample=%llu budget_bytes=%llu hits=%llu misses=%llu hit_bytes=%llu miss_bytes=%llu "
+      "hit_percent=%.2f miss_percent=%.2f cold_misses=%llu old_contents_potential_misses=%llu old_contents_potential_miss_bytes=%llu "
+      "old_contents_unnecessary_misses=%llu old_contents_unnecessary_miss_bytes=%llu cold_miss_bytes=%llu "
+      "post_upload_misses=%llu post_upload_potential_misses=%llu post_upload_potential_miss_bytes=%llu "
+      "post_upload_unnecessary_misses=%llu post_upload_unnecessary_miss_bytes=%llu "
+      "resident_bytes=%llu peak_resident_bytes=%llu simulation_only=1",
+      number(sample), number(sim.budget), number(sim.hits), number(sim.misses), number(sim.hitBytes), number(sim.missBytes),
+      attempts ? 100.0 * static_cast<double>(sim.hits) / static_cast<double>(attempts) : 0.0,
+      attempts ? 100.0 * static_cast<double>(sim.misses) / static_cast<double>(attempts) : 0.0, number(sim.coldMisses),
+      number(sim.preserveMisses), number(sim.preserveMissBytes), number(sim.discardMisses), number(sim.discardMissBytes),
+      number(sim.coldMissBytes), number(sim.postUploadMisses), number(sim.postUploadPreserveMisses),
+      number(sim.postUploadPreserveMissBytes), number(sim.postUploadDiscardMisses), number(sim.postUploadDiscardMissBytes),
+      number(sim.residentBytes), number(sim.peakBytes));
+  }
+  if (final && context.log != INVALID_HANDLE_VALUE) { FlushFileBuffers(context.log); }
+}
+}
