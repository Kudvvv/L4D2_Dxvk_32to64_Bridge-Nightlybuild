+    if (existing != m_strong.end()) { record = existing->second; }
+    else {
+      const auto fallback = m_content.find(content);
+      if (fallback != m_content.end()) { record = m_strong.at(fallback->second); }
+      else { record.firstMiss = timestamp(); }
+    }
+    record.strong = strong; record.content = content;
