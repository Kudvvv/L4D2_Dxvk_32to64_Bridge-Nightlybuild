+inline l4d2_control::Coverage queryCoverage(Context& context) {
+  std::lock_guard<std::recursive_mutex> guard(context.mutex);
+  l4d2_control::Coverage coverage;
+  for (const auto* entry : context.entries) {
+    ++coverage.tracked;
+    auto& group = coverage.categories[static_cast<uint32_t>(entry->category())];
+    ++group.tracked;
+    const auto state = entry->state();
+    group.backingBytes += state.backingBytes; group.mappedBytes += state.mappedBytes;
+    const auto capability = entry->queryCapability();
+    if (capability == Reason::Reclaimable) {
+      ++coverage.capable; ++group.capable;
+      if (entry->querySafety() == Reason::Reclaimable) { ++coverage.safeNow; ++group.safeNow; }
+    } else {
+      ++coverage.nonReclaimable;
+      if (capability == Reason::RecoveryUnavailable) { ++coverage.recoveryUnavailable; }
+      else { ++coverage.unsupportedCapability; }
+    }
+    const auto decision = entry->queryLearnedDecision();
+    if (decision == LearnedDecision::Keep) { ++coverage.learnedKeep; }
+    else if (decision == LearnedDecision::Evictable) { ++coverage.learnedEvictable; }
+    else { ++coverage.learnedUnclassified; }
