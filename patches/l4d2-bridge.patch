+inline bool layout(uint32_t width, uint32_t height, uint32_t format, Layout& result) {
+  result = {};
+  if (!width || !height || width > 16384 || height > 16384) { return false; }
+  const bool compressed = format == kDxt1 || format == kDxt3 || format == kDxt5;
+  if (!compressed && format != 21 && format != 22) { return false; }
+  const uint32_t block = compressed ? 4u : 1u;
+  const uint32_t element = compressed ? (format == kDxt1 ? 8u : 16u) : 4u;
+  const uint64_t rowBytes = static_cast<uint64_t>((width + block - 1) / block) * element;
+  const uint32_t rows = (height + block - 1) / block;
+  const uint64_t bytes = rowBytes * rows;
+  if (bytes > kMaxBytes) { return false; }
+  result = { static_cast<uint32_t>(rowBytes), rows, static_cast<uint32_t>(bytes), block, block, element };
+  return true;
+}
+
+// Residency extends the experiment layout without widening Phase 1 eligibility.
+inline bool residencyLayout(uint32_t width, uint32_t height, uint32_t format, Layout& result) {
+  if (layout(width, height, format, result)) { return true; }
+  if (!width || !height || width > 16384 || height > 16384) { return false; }
+  if (l4d2_ati::isFormat(format)) {
+    l4d2_ati::Layout ati;
+    if (!l4d2_ati::layout(width, height, format, ati) || ati.bytes > kMaxBytes) { return false; }
+    result = { ati.storagePitch, ati.rows, static_cast<uint32_t>(ati.bytes), 4u, 4u, ati.blockBytes };
+    return true;
+  }
+  uint32_t element = 0;
+  switch (format) {
+  case 28: case 50: element = 1; break; // A8, L8
+  case 23: case 24: case 25: case 26: case 51: case 81: case 111: element = 2; break;
+  case 31: case 32: case 33: case 34: case 35: case kQ8W8V8U8: case 112: case 114: element = 4; break;
+  case 36: case 110: case 113: case 115: element = 8; break;
+  case 116: element = 16; break;
+  default: return false;
+  }
+  const uint64_t bytes = static_cast<uint64_t>(width) * height * element;
+  if (bytes > kMaxBytes) { return false; }
+  result = { width * element, height, static_cast<uint32_t>(bytes), 1, 1, element };
+  return true;
+}
+
+// The wire carries meaningful rows; the Client may expose additional API padding.
+inline bool residencyBackingLayout(uint32_t width, uint32_t height, uint32_t format,
+                                   Layout& logical, uint32_t& pitch, uint64_t& bytes) {
+  pitch = 0; bytes = 0;
+  if (!residencyLayout(width, height, format, logical)) { return false; }
+  if (l4d2_ati::isFormat(format)) {
+    l4d2_ati::Layout ati;
+    if (!l4d2_ati::layout(width, height, format, ati)) { return false; }
+    pitch = ati.storagePitch; bytes = ati.backingBytes;
+  } else {
+    pitch = logical.rowBytes < 4u ? 4u : logical.rowBytes;
+    bytes = static_cast<uint64_t>(pitch) * logical.rows;
+  }
+  return bytes <= kMaxBytes;
