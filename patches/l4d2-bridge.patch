+}
+bool historyEnabled() { return s_history; }
+void setSession(const char* session) {
+  if (session && InterlockedCompareExchange(&s_sessionState, 1, 0) == 0) {
+    strncpy_s(s_session, session, _TRUNCATE);
+    InterlockedExchange(&s_sessionState, 2);
+  }
+}
+void setLogFile(HANDLE file) { s_logFile = file; }
+void install() { SetUnhandledExceptionFilter(handleException); }
+bool isExceptionExitCode(DWORD code) {
+  // Status alone identifies a peer's termination, never its original module.
+  return code == kUnhandledExceptionExitCode || code == kPeerExceptionExitCode
+      || code == 0xE06D7363u || (code & 0xF0000000u) == 0xC0000000u;
+}
