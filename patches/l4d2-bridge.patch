+// A section keeps CPU-written bytes while unlocked views leave the x86 VA.
+// The budget applies to mapped views; active locks are always pinned.
+class PagefileShadow {
+  HANDLE m_section = nullptr;
+  uint8_t* m_view = nullptr;
+  size_t m_size = 0;
+  size_t m_viewCost = 0;
+  unsigned m_locks = 0;
+  bool m_listed = false;
+  // NV-DXVK start: Only the explicitly enabled real-miss experiment sets this state.
+  bool m_recoveryMissing = false;
+  // NV-DXVK end
+  PagefileShadow* m_prev = nullptr;
+  PagefileShadow* m_next = nullptr;
+  inline static PagefileShadow* s_head = nullptr;
+  inline static PagefileShadow* s_tail = nullptr;
+  inline static size_t s_mappedBytes = 0;
+  inline static std::atomic<uint64_t> s_peakBackingBytes { 0 };
+  inline static std::mutex s_mutex;
+  std::unique_ptr<l4d2_shadow::Record> m_diagnostics;
+
+  void unlink() {
+    if (!m_listed) { return; }
+    if (m_prev) { m_prev->m_next = m_next; } else { s_head = m_next; }
+    if (m_next) { m_next->m_prev = m_prev; } else { s_tail = m_prev; }
+    m_prev = m_next = nullptr;
+    m_listed = false;
+  }
+
+  void unmap() {
+    unlink();
+    if (m_view && UnmapViewOfFile(m_view)) {
+      s_mappedBytes -= m_viewCost;
+      l4d2_memory::surfaceViewBudgetBytes.fetch_sub(m_viewCost);
+      l4d2_memory::released(m_size, l4d2_memory::Kind::Surface);
+      m_view = nullptr;
+    }
+  }
+
+  static void trim(size_t budget) {
+    while (s_mappedBytes > budget && s_tail) {
+      auto victim = s_tail;
+      victim->unmap();
+      if (victim->m_view) { break; }
+    }
+  }
+
+  static void noteBackingPeak() {
+    const uint64_t bytes = l4d2_memory::surfaceBackingBytes.load();
+    auto peak = s_peakBackingBytes.load();
+    while (bytes > peak && !s_peakBackingBytes.compare_exchange_weak(peak, bytes)) {}
+  }
+
+public:
+  PagefileShadow() = default;
+  PagefileShadow(const PagefileShadow&) = delete;
+  PagefileShadow& operator=(const PagefileShadow&) = delete;
+
+  ~PagefileShadow() {
+    std::lock_guard<std::mutex> guard(s_mutex);
+    unmap();
+    if (m_section) {
+      CloseHandle(m_section);
+      l4d2_memory::surfaceBackingBytes.fetch_sub(m_size);
+      l4d2_memory::surfaceBackingCount.fetch_sub(1);
+    }
+    l4d2_pageblock::destroyed(m_diagnostics.get());
+    if (m_diagnostics) { --l4d2_pageblock::context.metadataRecords; }
+  }
+
+  void configureDiagnostics(const l4d2_shadow::Metadata& meta, bool enabled, bool detailed = false) {
+    if (!enabled || m_diagnostics || m_section) { return; }
+    l4d2_pageblock::start(detailed);
+    m_diagnostics.reset(new (std::nothrow) l4d2_shadow::Record());
+    if (!m_diagnostics) { ++l4d2_pageblock::context.dropped; return; }
+    ++l4d2_pageblock::context.metadataRecords;
+    m_diagnostics->meta = meta;
+  }
+
+  void describeParent(uint64_t parentId, l4d2_shadow::Type type, uint32_t mip, uint32_t face) {
+    if (m_diagnostics && !m_diagnostics->registered) {
+      m_diagnostics->meta.parentId = parentId;
+      m_diagnostics->meta.type = type;
+      m_diagnostics->meta.mip = mip;
+      m_diagnostics->meta.face = face;
+    }
+  }
+
+  void observeLock(uint32_t flags, bool full) { l4d2_pageblock::locked(m_diagnostics.get(), flags, full); }
+  void observeUnlock(uint32_t flags) { l4d2_pageblock::unlocked(m_diagnostics.get(), flags); }
+
+  uint8_t* get() const { return m_view; }
+  static uint64_t peakBackingBytes() { return s_peakBackingBytes.load(); }
+  size_t backingBytes() const {
+    std::lock_guard<std::mutex> guard(s_mutex);
+    return m_section ? m_size : 0;
+  }
+
+  // NV-DXVK start: Ground truth is accessed only after independent recovery completes.
+  HRESULT compareRecovered(const uint8_t* recovered, size_t bytes, l4d2_readback::Comparison& result) const {
+    std::lock_guard<std::mutex> guard(s_mutex);
+    if (!m_section || m_locks || bytes != m_size || !recovered) { return E_INVALIDARG; }
+    const auto* reference = static_cast<const uint8_t*>(MapViewOfFile(m_section, FILE_MAP_READ, 0, 0, m_size));
+    if (!reference) { return HRESULT_FROM_WIN32(GetLastError()); }
+    result = l4d2_readback::compare(reference, recovered, bytes);
+    return UnmapViewOfFile(reference) ? S_OK : HRESULT_FROM_WIN32(GetLastError());
+  }
+
+  bool recoveryMissing() const {
+    std::lock_guard<std::mutex> guard(s_mutex);
+    return m_recoveryMissing && !m_section && !m_view && !m_locks;
+  }
+
+  HRESULT hashBacking(size_t bytes, l4d2_readback::Digest& digest) const {
+    std::lock_guard<std::mutex> guard(s_mutex);
+    if (!m_section || m_locks || bytes != m_size) { return E_INVALIDARG; }
+    const auto* reference = static_cast<const uint8_t*>(MapViewOfFile(m_section, FILE_MAP_READ, 0, 0, m_size));
+    if (!reference) { return HRESULT_FROM_WIN32(GetLastError()); }
+    const HRESULT hr = l4d2_readback::hashBytes(reference, bytes, digest);
+    if (!UnmapViewOfFile(reference)) { return HRESULT_FROM_WIN32(GetLastError()); }
+    return hr;
+  }
+
+  HRESULT evictBacking(size_t bytes) {
+    std::lock_guard<std::mutex> guard(s_mutex);
+    if (!m_section || m_recoveryMissing || m_locks || bytes != m_size) { return E_INVALIDARG; }
+    unmap();
+    if (m_view) { return HRESULT_FROM_WIN32(GetLastError()); }
+    if (!CloseHandle(m_section)) { return HRESULT_FROM_WIN32(GetLastError()); }
+    m_section = nullptr;
+    m_recoveryMissing = true;
+    l4d2_memory::surfaceBackingBytes.fetch_sub(m_size);
+    l4d2_memory::surfaceBackingCount.fetch_sub(1);
+    return S_OK;
+  }
+
+  HRESULT restoreRecovered(const uint8_t* recovered, size_t bytes, const l4d2_readback::Digest& expected,
+      l4d2_readback::Digest& rebuilt) {
+    std::lock_guard<std::mutex> guard(s_mutex);
+    if (!m_recoveryMissing || m_section || m_view || m_locks || bytes != m_size || !recovered) { return E_INVALIDARG; }
+    const auto section = CreateFileMappingW(INVALID_HANDLE_VALUE, nullptr, PAGE_READWRITE,
+      0, static_cast<DWORD>(bytes), nullptr);
+    if (!section) { return HRESULT_FROM_WIN32(GetLastError()); }
+    auto* view = static_cast<uint8_t*>(MapViewOfFile(section, FILE_MAP_ALL_ACCESS, 0, 0, bytes));
+    if (!view) { const auto error = GetLastError(); CloseHandle(section); return HRESULT_FROM_WIN32(error); }
+    std::memcpy(view, recovered, bytes);
+    HRESULT hr = l4d2_readback::hashBytes(view, bytes, rebuilt);
+    if (SUCCEEDED(hr) && rebuilt != expected) { hr = HRESULT_FROM_WIN32(ERROR_CRC); }
+    if (!UnmapViewOfFile(view)) { hr = HRESULT_FROM_WIN32(GetLastError()); }
+    if (FAILED(hr)) { CloseHandle(section); return hr; }
+    m_section = section;
+    m_recoveryMissing = false;
+    l4d2_memory::surfaceBackingBytes.fetch_add(m_size);
+    l4d2_memory::surfaceBackingCount.fetch_add(1);
+    noteBackingPeak();
+    return S_OK;
+  }
+  // NV-DXVK end
+
+  uint8_t* acquire(size_t size, size_t budget, bool replaceMissing = false) {
+    std::lock_guard<std::mutex> guard(s_mutex);
+    const bool overwrite = m_recoveryMissing && replaceMissing;
+    if (!size || (m_recoveryMissing && !overwrite) || (m_section && size != m_size)) { return nullptr; }
+    unlink();
+    if (!m_section) {
+      SYSTEM_INFO system {};
+      GetSystemInfo(&system);
+      const size_t granularity = system.dwAllocationGranularity;
+      // Charge alignment gaps too, otherwise thousands of small mip views
+      // could fragment considerably more VA than their byte sizes suggest.
+      if (size > SIZE_MAX - granularity) { return nullptr; }
+      m_viewCost = ((size + granularity - 1) / granularity) * granularity;
+      m_section = CreateFileMappingW(INVALID_HANDLE_VALUE, nullptr, PAGE_READWRITE,
+        0, static_cast<DWORD>(size), nullptr);
+      if (!m_section) {
+        const auto error = GetLastError();
+        l4d2_memory::sample(true, "section-create-failed", l4d2_memory::Kind::Surface, size, 0, 0, 0, error);
+        return nullptr;
+      }
+      m_size = size;
+      l4d2_memory::surfaceBackingBytes.fetch_add(size);
+      l4d2_memory::surfaceBackingCount.fetch_add(1);
+      noteBackingPeak();
+      if (!overwrite) { l4d2_pageblock::created(m_diagnostics.get(), size); }
+    }
+    if (!m_view) {
+      trim(m_viewCost >= budget ? 0 : budget - m_viewCost);
+      m_view = static_cast<uint8_t*>(MapViewOfFile(m_section, FILE_MAP_ALL_ACCESS, 0, 0, m_size));
+      if (!m_view) {
+        // Fragmentation can prevent a mapping even below the cache budget.
+        trim(0);
+        m_view = static_cast<uint8_t*>(MapViewOfFile(m_section, FILE_MAP_ALL_ACCESS, 0, 0, m_size));
+      }
+      if (!m_view) {
+        const auto error = GetLastError();
+        l4d2_memory::sample(true, "section-map-failed", l4d2_memory::Kind::Surface, size, 0, 0, 0, error);
+        if (overwrite) {
+          CloseHandle(m_section); m_section = nullptr;
+          l4d2_memory::surfaceBackingBytes.fetch_sub(m_size);
+          l4d2_memory::surfaceBackingCount.fetch_sub(1);
+        }
+        return nullptr;
+      }
+      s_mappedBytes += m_viewCost;
+      l4d2_memory::surfaceViewBudgetBytes.fetch_add(m_viewCost);
+      l4d2_memory::bytes[0].fetch_add(m_size);
+      l4d2_memory::objects[0].fetch_add(1);
+    }
+    m_recoveryMissing = false;
+    ++m_locks;
+    return m_view;
+  }
+
+  void release(size_t budget) {
+    std::lock_guard<std::mutex> guard(s_mutex);
+    if (!m_locks || --m_locks) { return; }
+    m_next = s_head;
+    if (s_head) { s_head->m_prev = this; } else { s_tail = this; }
+    s_head = this;
+    m_listed = true;
+    trim(budget);
+  }
+};
