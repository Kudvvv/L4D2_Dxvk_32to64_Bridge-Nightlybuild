+  const int length = _snprintf_s(line, _countof(line), _TRUNCATE,
+    "L4D2_BRIDGE_DIAGNOSTIC timestamp_utc=%04u-%02u-%02uT%02u:%02u:%02u.%03uZ side=%s pid=%lu tid=%lu session=%s %s\n",
+    now.wYear, now.wMonth, now.wDay, now.wHour, now.wMinute, now.wSecond, now.wMilliseconds,
+    side(), GetCurrentProcessId(), GetCurrentThreadId(), sessionName(), message);
+  writeBytes(s_logFile, line, length > 0 ? static_cast<unsigned>(length) : static_cast<unsigned>(strlen(line)));
+  flushOutput(s_logFile);
