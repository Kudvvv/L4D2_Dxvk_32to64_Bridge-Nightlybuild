+      std::snprintf(line, sizeof(line), "L4D2_STEAM_INPUT event=window-hook role=%s hwnd=%p module_path=%s downstream_path=%s",
+        m_role, local, *procedurePath ? procedurePath : "unresolved", *downstreamPath ? downstreamPath : "unresolved");
