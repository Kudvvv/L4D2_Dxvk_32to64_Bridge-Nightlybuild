+  bool relockedAfterUnlock = false, secondDelayValid = false;
+  Record* prev = nullptr;
+  Record* next = nullptr;
+  std::array<SimLink, 4> sim {};
+};
+
+// DISCARD is only classified safe for a known full dynamic DEFAULT 2D base level.
+// Normal full locks, cube surfaces and unrecognized flag combinations stay conservative.
+inline bool oldContentsUnnecessary(const Metadata& meta, uint32_t flags, bool full) {
+  constexpr uint32_t allowed = kDiscard | 0x800u | 0x4000u | 0x8000u;
+  return meta.type == Type::Texture2DLevel && meta.mip == 0 && meta.pool == 0
+    && (meta.usage & kDynamic) && full && (flags & kDiscard) && !(flags & ~allowed);
+}
+
+struct Weighted {
+  uint64_t resources = 0, bytes = 0;
+  void add(uint64_t size) { ++resources; bytes += size; }
+};
+
+struct Totals {
+  Weighted all, initialOnly, relocked, discardOnly, potentiallyRequired, readonly;
+  Weighted frequent, dynamic, incomplete, persistent, nonpersistent;
+  std::array<Weighted, 4> delays {};
+  void add(const Record& r) {
+    all.add(r.size);
+    const bool initial = r.hasUpload && !r.afterUploadLocks && !r.readonlyLocks && !r.activeLocks;
+    const bool discard = r.hasUpload && r.afterUploadLocks && !r.afterUploadPreserve && !r.readonlyLocks && !r.activeLocks;
+    if (initial) { initialOnly.add(r.size); }
+    if (discard) { discardOnly.add(r.size); }
+    if (r.relockedAfterUnlock) {
+      relocked.add(r.size);
+      const auto delay = r.firstRelockDelay;
+      delays[delay < 1000 ? 0 : delay < 10000 ? 1 : delay <= 60000 ? 2 : 3].add(r.size);
+    }
+    if (r.afterUploadPreserve) { potentiallyRequired.add(r.size); }
+    if (r.readonlyLocks) { readonly.add(r.size); }
+    if (r.locks >= 8) { frequent.add(r.size); }
+    if (r.meta.usage & kDynamic) { dynamic.add(r.size); }
+    if (!r.hasUpload || r.activeLocks) { incomplete.add(r.size); }
+    if (initial || discard) { nonpersistent.add(r.size); } else { persistent.add(r.size); }
+  }
+};
+
+struct Simulation {
+  uint64_t budget = 0, residentBytes = 0, peakBytes = 0;
+  uint64_t hits = 0, misses = 0, hitBytes = 0, missBytes = 0;
+  uint64_t coldMisses = 0, preserveMisses = 0, discardMisses = 0;
+  uint64_t coldMissBytes = 0, postUploadMisses = 0, postUploadPreserveMisses = 0, postUploadDiscardMisses = 0;
+  uint64_t postUploadPreserveMissBytes = 0, postUploadDiscardMissBytes = 0;
+  uint64_t preserveMissBytes = 0, discardMissBytes = 0;
+  Record* head = nullptr;
+  Record* tail = nullptr;
+};
+
+struct Event {
+  Metadata meta;
+  uint64_t time = 0, size = 0;
+  uint32_t flags = 0;
+  bool creation = false;
+};
+
+// Storage is fixed; no allocations or resource ownership are introduced by the engine.
+class Engine {
+  struct Millisecond { uint64_t time = 0, bytes = 0, count = 0; };
+  std::array<Millisecond, 1024> m_window {};
+  uint64_t m_lastTime = 0;
+  bool m_burstActive = false;
+
+  void unlinkSim(Record& r, size_t index) {
+    auto& link = r.sim[index];
+    auto& sim = simulations[index];
+    if (!link.listed) { return; }
+    if (link.prev) { link.prev->sim[index].next = link.next; } else { sim.head = link.next; }
+    if (link.next) { link.next->sim[index].prev = link.prev; } else { sim.tail = link.prev; }
+    link.prev = link.next = nullptr;
+    link.listed = false;
+  }
+
+  void trimSim(size_t index) {
+    auto& sim = simulations[index];
+    while (sim.residentBytes > sim.budget && sim.tail) {
+      auto& victim = *sim.tail;
+      unlinkSim(victim, index);
+      victim.sim[index].resident = false;
+      sim.residentBytes -= victim.size;
+    }
+  }
+
+  void recordEvent(const Record& r, uint64_t now, uint32_t flags, bool creation) {
+    events[static_cast<size_t>(eventCount % events.size())] = { r.meta, now, r.size, flags, creation };
+    ++eventCount;
+  }
+
+  void advanceWindow(uint64_t now) {
+    if (now - m_lastTime >= 1000) {
+      m_window = {};
+      windowBytes = windowCount = 0;
+    } else {
+      for (uint64_t t = m_lastTime + 1; t <= now; ++t) {
+        if (t >= 1000) {
+          auto& old = m_window[static_cast<size_t>((t - 1000) % m_window.size())];
+          if (old.time == t - 1000) {
+            windowBytes -= old.bytes;
+            windowCount -= old.count;
+            old = {};
+          }
+        }
+      }
+    }
+    m_lastTime = now;
+    if (windowBytes < 100 * kMiB) { m_burstActive = false; }
+  }
+
+public:
+  Record* head = nullptr;
+  Totals destroyed;
+  uint64_t createdResources = 0, createdBytes = 0, aliveBytes = 0, aliveResources = 0, peakAliveBytes = 0;
+  uint64_t windowBytes = 0, windowCount = 0, eventCount = 0, burstCount = 0;
+  std::array<Event, 256> events {};
+  std::array<Simulation, 4> simulations {};
+
+  Engine() {
+    for (size_t i = 0; i < simulations.size(); ++i) { simulations[i].budget = (256 * kMiB) << i; }
+  }
+
+  bool create(Record& r, uint64_t size, uint64_t now) {
+    if (r.registered) { return false; }
+    r.size = size;
+    r.backingTime = now;
+    r.registered = true;
+    r.next = head;
+    if (head) { head->prev = &r; }
+    head = &r;
