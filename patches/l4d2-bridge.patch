+      "mismatch_bytes=%llu first_mismatch_offset=%lld readback_us=%llu backend_read_us=%llu sync_us=%llu compare_us=%llu "
+      "backend_pitch=%u logical_row_bytes=%u block_rows=%u queue_flush_requested=%u event_query_wait=%u query_polls=%u "
+      "device_idle=%u backend_internal_wait=unobservable source=server-d3d9-readonly original_retained=1 recovered_discarded=1",
+      id, parent, repeat, response.bytes, difference.mismatchBytes ? 0u : 1u,
+      static_cast<unsigned long long>(difference.mismatchBytes), static_cast<long long>(difference.firstOffset),
+      static_cast<unsigned long long>(elapsed), static_cast<unsigned long long>(response.backendReadUs),
+      static_cast<unsigned long long>(response.syncUs), static_cast<unsigned long long>(microseconds(compareBegin, compareEnd)),
+      response.backendPitch, response.rowBytes, response.rows, response.flushRequested, response.eventWait, response.queryPolls, response.deviceIdle);
+    if (difference.mismatchBytes) {
+      write("PB_READBACK_TEST event=mismatch resource_id=%u repeat=%u mismatch_bytes=%llu first_mismatch_offset=%lld expected=0x%02x actual=0x%02x",
+        id, repeat, static_cast<unsigned long long>(difference.mismatchBytes), static_cast<long long>(difference.firstOffset), difference.expected, difference.actual);
+    }
+  }
+  if (c.log != INVALID_HANDLE_VALUE) { FlushFileBuffers(c.log); }
+}
+
+inline void summary() {
+  auto& c = context();
+  std::unique_lock<std::mutex> guard(c.mutex, std::try_to_lock);
+  if (!guard.owns_lock() || (!c.enabled && !c.attempts)) { return; }
+  write("PB_READBACK_TEST event=summary resources=%u attempts=%llu recovered=%llu exact_matches=%llu mismatches=%llu failures=%llu "
+    "phase=retained-reference original_retained=1 real_miss=0",
+    c.selection.count(), static_cast<unsigned long long>(c.attempts), static_cast<unsigned long long>(c.recovered),
+    static_cast<unsigned long long>(c.matches), static_cast<unsigned long long>(c.mismatches), static_cast<unsigned long long>(c.failures));
+  if (c.log != INVALID_HANDLE_VALUE) { FlushFileBuffers(c.log); }
+}
