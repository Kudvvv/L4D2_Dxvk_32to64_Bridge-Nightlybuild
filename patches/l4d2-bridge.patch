+
+// No reference pointer or historical upload data can be supplied to this pipeline.
+// Production supplies a D3D9Backend wrapping the current server resource.
+template<typename Backend>
+Response recover(Backend& backend, const Request& request, uint8_t* recovered) {
+  Response response;
+  Layout l;
+  response.stage = Stage::Protocol;
+  if (!requestValid(request, l) || !recovered) { response.hresult = E_INVALIDARG; return response; }
+  D3DSURFACE_DESC desc {};
+  response.stage = Stage::Descriptor;
+  response.hresult = backend.descriptor(desc);
+  if (FAILED(response.hresult)) { return response; }
+  response.width = desc.Width; response.height = desc.Height; response.format = static_cast<uint32_t>(desc.Format);
+  response.mip = request.mip;
+  if (desc.Width != request.width || desc.Height != request.height || static_cast<uint32_t>(desc.Format) != request.format
+    || desc.Usage != 0 || desc.Pool != D3DPOOL_MANAGED || desc.MultiSampleType != D3DMULTISAMPLE_NONE) {
+    response.hresult = D3DERR_INVALIDCALL; return response;
+  }
+  response.rowBytes = l.rowBytes; response.rows = l.rows;
+  response.blockWidth = l.blockWidth; response.blockHeight = l.blockHeight; response.blockBytes = l.blockBytes;
+  response.hresult = backend.synchronize(response);
+  if (response.hresult != S_OK) {
+    if (SUCCEEDED(response.hresult)) { response.hresult = E_FAIL; }
+    return response;
+  }
+  LARGE_INTEGER begin {}, end {}; QueryPerformanceCounter(&begin);
+  D3DLOCKED_RECT locked {};
+  response.stage = Stage::Lock;
+  response.hresult = backend.lock(locked);
+  if (SUCCEEDED(response.hresult)) {
+    response.backendPitch = locked.Pitch > 0 ? static_cast<uint32_t>(locked.Pitch) : 0;
+    const bool copied = packRows(static_cast<const uint8_t*>(locked.pBits), locked.Pitch, recovered, l);
+    const HRESULT unlockResult = backend.unlock();
+    if (!copied) { response.stage = Stage::Pitch; response.hresult = E_INVALIDARG; }
+    else if (FAILED(unlockResult)) { response.stage = Stage::Unlock; response.hresult = unlockResult; }
+    else { response.stage = Stage::Complete; response.hresult = S_OK; response.bytes = l.bytes; }
+  }
+  QueryPerformanceCounter(&end); response.backendReadUs = microseconds(begin, end);
+  return response;
+}
+
+inline void publish(const Request& request, const Response& response, uint8_t* view, HANDLE done) {
+  (void)request;
+  if (view) { std::memcpy(view, &response, sizeof(response)); }
+  MemoryBarrier();
+  SetEvent(done);
+}
+
+// The shared section only carries this experiment's recovered copy and status.
+template<typename Backend>
+bool runShared(Backend& backend, const Request& request, bool enabled, bool resourceValid) {
+  Layout l;
+  if (!requestValid(request, l)) { return false; }
+  wchar_t eventName[112] {}; swprintf_s(eventName, L"%ls-done", request.name);
+  HANDLE done = OpenEventW(EVENT_MODIFY_STATE, FALSE, eventName);
+  if (!done) { return false; }
+  HANDLE section = OpenFileMappingW(FILE_MAP_WRITE, FALSE, request.name);
+  uint8_t* view = section ? static_cast<uint8_t*>(MapViewOfFile(section, FILE_MAP_WRITE,
+    0, 0, sizeof(Response) + request.bytes)) : nullptr;
+  Response response;
+  if (!view) { response.stage = Stage::Mapping; response.hresult = HRESULT_FROM_WIN32(GetLastError()); }
+  else if (!enabled) { response.stage = Stage::Disabled; response.hresult = E_ACCESSDENIED; }
+  else if (!resourceValid) { response.stage = Stage::Resource; response.hresult = D3DERR_INVALIDCALL; }
+  else { response = recover(backend, request, view + sizeof(Response)); }
+  publish(request, response, view, done);
+  if (view) { UnmapViewOfFile(view); }
+  if (section) { CloseHandle(section); }
+  CloseHandle(done);
+  return view != nullptr;
+}
+}
