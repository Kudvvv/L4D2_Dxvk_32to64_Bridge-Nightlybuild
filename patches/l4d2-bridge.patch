+#include <cstdint>
+#include <cstring>
+
+namespace l4d2_readback {
+constexpr uint32_t kVersion = 1;
+constexpr uint32_t kMaxBytes = 64u * 1024u * 1024u;
+constexpr uint32_t kDxt1 = 0x31545844u, kDxt3 = 0x33545844u, kDxt5 = 0x35545844u;
+
+struct Layout {
+  uint32_t rowBytes = 0, rows = 0, bytes = 0;
+  uint32_t blockWidth = 0, blockHeight = 0, blockBytes = 0;
+};
+
+inline bool layout(uint32_t width, uint32_t height, uint32_t format, Layout& result) {
+  result = {};
+  if (!width || !height || width > 16384 || height > 16384) { return false; }
+  const bool compressed = format == kDxt1 || format == kDxt3 || format == kDxt5;
+  if (!compressed && format != 21 && format != 22) { return false; }
+  const uint32_t block = compressed ? 4u : 1u;
+  const uint32_t element = compressed ? (format == kDxt1 ? 8u : 16u) : 4u;
+  const uint64_t rowBytes = static_cast<uint64_t>((width + block - 1) / block) * element;
+  const uint32_t rows = (height + block - 1) / block;
+  const uint64_t bytes = rowBytes * rows;
+  if (bytes > kMaxBytes) { return false; }
+  result = { static_cast<uint32_t>(rowBytes), rows, static_cast<uint32_t>(bytes), block, block, element };
+  return true;
+}
+
+// Only backend bytes enter this function; a client reference is not an input.
+inline bool packRows(const uint8_t* source, int32_t pitch, uint8_t* recovered, const Layout& l) {
+  if (!source || !recovered || pitch <= 0 || static_cast<uint32_t>(pitch) < l.rowBytes || !l.rows || !l.bytes) { return false; }
+  for (uint32_t row = 0; row < l.rows; ++row) {
+    std::memcpy(recovered + static_cast<size_t>(row) * l.rowBytes,
+      source + static_cast<size_t>(row) * static_cast<uint32_t>(pitch), l.rowBytes);
+  }
+  return true;
+}
+
+struct Comparison {
+  uint64_t mismatchBytes = 0;
+  int64_t firstOffset = -1;
+  uint32_t expected = 0, actual = 0;
+};
+
+inline Comparison compare(const uint8_t* reference, const uint8_t* recovered, size_t bytes) {
+  Comparison result;
+  if (std::memcmp(reference, recovered, bytes) == 0) { return result; }
+  for (size_t i = 0; i < bytes; ++i) {
+    if (reference[i] != recovered[i]) {
+      if (result.firstOffset < 0) {
+        result.firstOffset = static_cast<int64_t>(i);
+        result.expected = reference[i]; result.actual = recovered[i];
+      }
+      ++result.mismatchBytes;
+    }
+  }
+  return result;
+}
+
+// One resource per format/size stratum, in first-completed-upload order.
+// The four size slots reserve room for 4096 textures rather than filling with tiny mips.
+class Selection {
+  std::array<bool, 20> m_selected {};
+  uint32_t m_count = 0;
+public:
+  bool take(uint32_t format, uint32_t width, uint32_t height, uint32_t maximum) {
+    const uint32_t formats[] = { kDxt1, kDxt3, kDxt5, 21, 22 };
+    const uint32_t sizes[] = { 256, 1024, 2048, 4096 };
+    const uint32_t extent = width > height ? width : height;
+    for (size_t f = 0; f < 5; ++f) {
+      for (size_t s = 0; s < 4; ++s) {
+        const size_t slot = f * 4 + s;
+        if (format == formats[f] && extent == sizes[s] && !m_selected[slot] && m_count < maximum) {
+          m_selected[slot] = true; ++m_count; return true;
+        }
+      }
+    }
+    return false;
+  }
+  uint32_t count() const { return m_count; }
+};
+}
