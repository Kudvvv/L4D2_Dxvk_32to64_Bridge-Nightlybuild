+#include "log/log.h"
+#include "util_devicecommand.h"
+
+namespace l4d2_retention {
+inline std::filesystem::path clientDirectory() {
+  wchar_t path[MAX_PATH] {}; HMODULE module = nullptr;
+  if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+    reinterpret_cast<LPCWSTR>(&clientDirectory), &module) || !GetModuleFileNameW(module, path, MAX_PATH)) { return {}; }
+  return std::filesystem::path(path).parent_path();
+}
+
+inline std::string creationSite(void* caller) {
+  HMODULE own = nullptr;
+  GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+    reinterpret_cast<LPCWSTR>(&creationSite), &own);
+  // The direct virtual-method caller remains available when an optimized x86 stack cannot be walked.
+  void* frames[25] {}; frames[0] = caller;
+  const auto count = static_cast<USHORT>(1 + CaptureStackBackTrace(0, 24, frames + 1, nullptr));
+  void* selected[4] {};
+  std::ostringstream site; uint32_t retained = 0;
+  for (USHORT frame = 0; frame < count && retained < 4; ++frame) {
+    if (!frames[frame]) { continue; }
+    bool duplicate = false;
+    for (uint32_t i = 0; i < retained; ++i) { if (selected[i] == frames[frame]) { duplicate = true; } }
+    if (duplicate) { continue; }
+    HMODULE module = nullptr;
+    if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+      reinterpret_cast<LPCWSTR>(frames[frame]), &module) || module == own) { continue; }
+    wchar_t path[MAX_PATH] {};
+    if (!GetModuleFileNameW(module, path, MAX_PATH)) { continue; }
+    auto name = std::filesystem::path(path).filename().u8string();
+    for (auto& c : name) { c = static_cast<char>(std::tolower(static_cast<unsigned char>(c))); }
+    if (name == "kernel32.dll" || name == "kernelbase.dll" || name == "ntdll.dll" || name == "ucrtbase.dll"
+      || name.find("vcruntime") == 0 || name.find("msvcp") == 0 || name.find("msvcr") == 0) { continue; }
+    const auto* base = reinterpret_cast<const uint8_t*>(module);
+    const auto* dos = reinterpret_cast<const IMAGE_DOS_HEADER*>(base);
+    if (dos->e_magic != IMAGE_DOS_SIGNATURE || dos->e_lfanew <= 0) { continue; }
+    const auto* nt = reinterpret_cast<const IMAGE_NT_HEADERS*>(base + dos->e_lfanew);
+    if (nt->Signature != IMAGE_NT_SIGNATURE) { continue; }
+    site << name << ':' << std::hex << nt->FileHeader.TimeDateStamp << ':' << nt->OptionalHeader.SizeOfImage
+      << ':' << nt->OptionalHeader.CheckSum << ':' << (reinterpret_cast<uintptr_t>(frames[frame]) - reinterpret_cast<uintptr_t>(module)) << ';';
+    selected[retained++] = frames[frame];
+  }
+  return site.str();
+}
+
+struct Runtime {
+  Context context;
+  HANDLE file = INVALID_HANDLE_VALUE;
+  Runtime() {
+    try {
+      context.enabled = bridge_util::Config::getOption<std::string>("client.pageBlockRetentionPolicy", "keep") == "learned-aggressive";
+      if (!context.enabled) { return; }
+      const auto directory = clientDirectory();
+      if (!directory.empty()) {
+        file = CreateFileW((directory / L"l4d2-retention.log").c_str(), GENERIC_WRITE, FILE_SHARE_READ,
+          nullptr, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+      }
+      context.log = [this](const char* message) {
+        if (file == INVALID_HANDLE_VALUE) { return; }
+        char line[2200] {}; SYSTEMTIME now {}; GetLocalTime(&now);
+        const int count = sprintf_s(line, "%02u:%02u:%02u.%03u pid=%lu %s\n", now.wHour, now.wMinute,
+          now.wSecond, now.wMilliseconds, GetCurrentProcessId(), message);
+        if (count > 0) { DWORD written = 0; WriteFile(file, line, static_cast<DWORD>(count), &written, nullptr); }
+      };
+      context.exchange = [](const Request& r, Temporary& temporary, Response& response, uint64_t& elapsed) -> HRESULT {
+        HRESULT hr = temporary.create(r);
+        if (FAILED(hr)) { return hr; }
+        LARGE_INTEGER begin {}, end {}; QueryPerformanceCounter(&begin);
+        { ClientMessage command(Commands::Bridge_TestReadbackRecovery, r.resourceId); command.send_data(static_cast<uint32_t>(sizeof(r)), &r); }
+        const auto wait = temporary.wait(20000); QueryPerformanceCounter(&end); elapsed = microseconds(begin, end);
+        if (wait != WAIT_OBJECT_0) { return HRESULT_FROM_WIN32(wait == WAIT_TIMEOUT ? ERROR_TIMEOUT : GetLastError()); }
+        response = temporary.response();
+        return response.hresult;
+      };
+      const auto configured = bridge_util::Config::getOption<std::string>("client.pageBlockRetentionDb", ".l4d2bridge/resource-retention.db");
+      auto path = std::filesystem::u8path(configured);
+      if (path.is_relative()) { path = directory / path; }
+      if (directory.empty() || configured.empty()) { context.disable("database-path-unavailable"); }
+      else {
+        std::error_code error; std::filesystem::create_directories(path.parent_path(), error);
+        if (error || !context.db.open(path.wstring())) { context.disable("persistent-db-open-or-validation-failed"); }
+      }
+      if (file == INVALID_HANDLE_VALUE) { context.disable("policy-log-unavailable"); }
+      if (bridge_util::Config::getOption<bool>("client.testReadbackRecovery", false)) { context.disable("retained-reference-test-active"); }
+      if (bridge_util::Config::getOption<bool>("useSharedHeap", false)
+        || !bridge_util::Config::getOption<bool>("server.useVanillaDxvk", true)) { context.disable("unsupported-shared-heap-or-backend"); }
+      context.write("PB_POLICY event=config policy=learned-aggressive persistent_db=%s unknown_policy=%s real_eviction=%u recovery=server-d3d9-readonly device_idle=0 hash=sha256 db_records=%llu",
+        context.db.valid() ? "enabled" : "unavailable", context.fallback ? "KEEP" : "DROP", context.fallback ? 0u : 1u,
+        static_cast<unsigned long long>(context.db.records()));
+      bridge_util::Logger::info(context.fallback ? "PB_POLICY policy=learned-aggressive session_fallback=1 unknown_policy=KEEP"
+        : "PB_POLICY policy=learned-aggressive persistent_db=enabled unknown_policy=DROP real_eviction=1 recovery=server-d3d9-readonly");
+    } catch (...) { context.disable("policy-initialization-failed"); }
+  }
+};
+inline Runtime& runtime() { static auto* instance = new Runtime(); return *instance; }
+inline bool enabled() { return runtime().context.enabled; }
+inline std::shared_ptr<Parent> create(uint32_t id, uint32_t width, uint32_t height, uint32_t levels,
+    uint32_t format, uint32_t usage, uint32_t pool, std::string site) {
+  auto& c = runtime().context;
+  if (!c.enabled) { return {}; }
+  try { return std::make_shared<Parent>(c, id, width, height, levels, format, usage, pool, std::move(site)); }
+  catch (...) { std::lock_guard<std::recursive_mutex> guard(c.mutex); c.disable("policy-metadata-allocation-failed"); return {}; }
+}
+inline void summary() {
+  auto& r = runtime();
+  if (!r.context.enabled) { return; }
+  summary(r.context);
+  if (r.file != INVALID_HANDLE_VALUE) { FlushFileBuffers(r.file); }
+}
+}
