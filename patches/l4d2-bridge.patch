+  }
+  ~Parent() { std::lock_guard<std::recursive_mutex> guard(m_context.mutex); m_context.parents.erase(this); }
+  void attach(uint32_t mip, uint32_t id, PagefileShadow& backing, std::function<void()> reclaimWhenIdle = {}) {
+    std::lock_guard<std::recursive_mutex> guard(m_context.mutex);
+    if (mip < m_mips.size()) { m_mips[mip].id = id; m_mips[mip].backing = &backing; m_mips[mip].reclaimWhenIdle = std::move(reclaimWhenIdle); }
+  }
+  void detach(uint32_t mip) {
+    std::lock_guard<std::recursive_mutex> guard(m_context.mutex);
+    if (mip < m_mips.size()) { m_mips[mip].backing = nullptr; m_mips[mip].reclaimWhenIdle = {}; }
+  }
+  bool hashUpload(uint32_t mip, bool full) {
+    std::lock_guard<std::recursive_mutex> guard(m_context.mutex);
+    return m_context.enabled && m_eligible && !m_keep && !m_context.fallback && mip < m_mips.size() && full;
+  }
+  void uploaded(uint32_t mip, bool full, const Digest& digest, HRESULT hashResult) {
+    std::lock_guard<std::recursive_mutex> guard(m_context.mutex);
+    if (mip >= m_mips.size()) { return; }
